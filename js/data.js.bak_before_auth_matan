window.MANARA_DATA = {"app":"manara","version":18,"tracks":[{"slug":"ajroumiya","name":"متن الآجرومية","description":"متن الآجرومية نظما بشرح الشيخ محمد محمود الشنقيطي: قراءة المتن كاملا ثم شرحه في 13 مجلسا، من الكلام إلى المخفوضات.","icon":"pen","order":1,"courses":[{"id":"cmu9qsbte00c3kace9sueyq7o","title":"متن الآجرومية (نحو)","author":"النظم: محمد بن اْب التواتي (عبيد ربه) · الشرح: الشيخ محمد محمود الشنقيطي","level":"BEGINNER","description":"متن الآجرومية نظما بشرح الشيخ محمد محمود الشنقيطي: قراءة المتن كاملا ثم شرحه في 13 مجلسا، من الكلام إلى المخفوضات.","about":"نظم المقدمة الآجرومية للإمام محمد بن اْب التواتي المعروف بعبيد ربه، بشرح الشيخ محمد محمود الشنقيطي في 13 مجلسا مرئيا. يبدأ المقرر بقراءة المتن كاملا، ثم يشرح أبوابه: الكلام والإعراب وعلامات الرفع والنصب والخفض والجزم، والأفعال والنواصب والجوازم، والمرفوعات والتوابع والمنصوبات والمخفوضات. كل درس فيه: أبيات الباب، وشرح موجز ومفصل، وفوائد ومصطلحات وخريطة ذهنية، واختبار تفاعلي.","coverColor":"#5a6b3a","order":1,"lockLessons":false,"lockUntilPrev":false,"lessons":[{"id":"ajr-00","order":1,"title":"قراءة المتن: نظم الآجرومية كاملاً (قراءة وكتابة)","chapter":"المدخل","summary":"المتن كاملاً في درس واحد: قراءة مرتلة للنظم من المقدمة إلى الخاتمة، مكتوباً كتابة تامة للنسخ والحفظ والمراجعة، مع فهرس يدل كل باب على درسه.","content":{"objectives":["قراءة النظم كاملاً قراءة صحيحة مرتلة من المقدمة إلى خاتمة الناظم.","كتابة المتن كتابة تامة بخط اليد للترسيخ وتصحيح الإملاء.","حفظ الأبيات حفظاً متقناً باباً باباً على ترتيب الدروس.","معرفة موضع كل باب من المنظومة والدرس الذي يشرحه من 01 إلى 13.","مراجعة المتن كاملاً قبل الاختبارات وبعد إتمام كل درس."],"matn":"[متن نظم الآجرومية كاملاً — قراءة وحفظاً وكتابة]\n\n[المقدمة وباب الكلام]\nقَالَ عُبَيْدُ رَبِّهِ مُحَمَّدُ ۞ اللهَ فِي كُلِّ الأُمُورِ أَحْمَدُ\nمُصَلِّيًا عَلَى الرَّسُولِ الْمُصْطَفَى ۞ وَآلِهِ وَصَحْبِهِ وَمَنْ تَلَا\nوَبَعْدُ فَالْقَصْدُ بَذَا النَّظْمِ بَدَا ۞ تَسْهِيلُ مَا اصْطَلَحَ مِنْهُ جُلَّ الرُّومِي\nلِمَنْ أَرَادَ حِفْظَهُ وَعَسُرَا ۞ عَلَيْهِ أَنْ يَحْفَظَ مَا قَدْ نُثِرَا\nوَاللهَ أَسْتَعِينُ فِي كُلِّ عَمَلْ ۞ عَلَيْهِ مَعْتَمَدِي وَإِلَيْهِ الْمُبْتَهَلْ\nإِنَّ الْكَلاَمَ عِنْدَنَا مُرَكَّبُ ۞ مُفِيدٌ قَدْ وَضَعَ لِلإِفَادَةِ\nأَقْسَامُهُ الَّتِي عَلَيْهَا يُبْنَى ۞ اِسْمٌ وَفِعْلٌ ثُمَّ حَرْفُ مَعْنَى\nفَالاسْمُ بِالْخَفْضِ وَالتَّنْوِينِ وَدُخُولِ أَلْ ۞ يُعْرَفُ وَبِحُرُوفِ الْجَرِّ كَمَا جَلَا\nوَهِيَ مِنْ إِلَى وَعَنْ وَفِي وَرُبَّ وَعَلَى ۞ وَالْكَافُ وَاللاَّمُ وَالْوَاوُ وَالتَّاءُ وَمُذْ وَمُنْذُ وَحَتَّى\nوَالْفِعْلُ بِالسِّينِ وَسَوْفَ وَبِقَدْ ۞ وَبِتَاءِ تَأْنِيثٍ مَيَّزَهُ صَدَدْ\nوَالْحَرْفُ يَعْرِفُ بِأَنْ لاَ يَقْبَلَا ۞ لِلاسْمِ وَلاَ لِلْفِعْلِ سَبِيلًا وَدَلِيلَا\n\n[باب الإعراب وعلامات الرفع]\nاَلإِعْرَابُ تَغْيِيرُ أَوَاخِرِ الْكَلِمْ ۞ تَقْدِيرًا أوْ لَفْظًا فَذَا الحَدَّ ذَكَرُ\nوَذَلِكَ التَّغْيِيرُ لِاضْطِرَابِ ۞ عَوَامِلٍ تَدْخُلُ لِلإِعْرَابِ\nأَقْسَامُهُ أَرْبَعَةٌ فَلْتُعْتَبَرْ ۞ رَفْعٌ وَنَصْبٌ ثُمَّ خَفْضٌ وَجَزَمْ\nفَالْأَوَّلَانِ دُونَ رَيْبٍ وَقَعَا ۞ فِي الِاسْمِ وَالْفِعْلِ الْمُضَارِعِ مَعَا\nوَالِاسْمُ قَدْ خُصِّصَ بِالْجَرِّ كَمَا ۞ قَدْ خُصِّصَ الْفِعْلُ بِجَزْمٍ فَاعْلَمَا\nضَمٌّ وَوَاوٌ أَلِفٌ وَالنُّونُ ۞ عَلَامَةُ الرَّفْعِ بِهَا تَكُونُ\nفَارْفَعْ بِضَمٍّ مُفْرَدَ الأَسْمَاءِ ۞ كَجَاءَ زَيْدٌ صَاحِبُ الْعَلَاءِ\nوَارْفَعْ بِهِ الْجَمْعَ الْمُكَسَّرَ وَمَا ۞ جُمِعَ مِنْ تَأْنِيثٍ سَلِمَا\nكَالمُضَارِعِ الَّذِي لَمْ يَتَّصِلْ ۞ شَيْءٌ بِهِ كَيَهْتَدِي وَكَيَصِلْ\nوَارْفَعْ بِوَاوٍ خَمْسَةً أَخُوكَا ۞ أَبُوكَ ذُو مَالٍ حَمُوكَ فُوكَا\nوَهَكَذَا الْجَمْعُ الصَّحِيحُ فَاعْرِفِ ۞ وَرَفْعُ مَا ثَنَّيْتَهُ بِالأَلِفِ\nوَارْفَعْ بِنُونٍ يَفْعَلَانِ يَفْعَلُونْ ۞ وَتَفْعَلَانِ تَفْعَلِينَ تَفْعَلُونْ\n\n[علامات النصب والخفض والجزم]\nعَلَامَةُ النَّصْبِ لَهَا كُنْ مُحْصِيَا ۞ الْفَتْحَ وَالْكَسْرَ وَاحْذِفْ نُونِيَا\nفَالَّذِي الْفَتْحُ بِهِ عَلَامَةْ ۞ يَا ذَا النُّهَى نَصْبًا بكسرِ الْجُمُوعْ\nثُمَّ الْمُفْرَدُ وَمِنْ مُضَارِعٍ الَّذِي تَسَعَّدْ ۞ بِالأَلِفِ الْخَمْسَةَ نَصْبَهَا الْتَزِمْ\nوَانْصِبْ بِكَسْرٍ جَمْعَ تَأْنِيثٍ سَلِمْ ۞ وَاعْلَمْ بِأَنَّ الْجَمْعَ وَالْمُثَنَّى\nنَصْبُهُمَا بِالْيَاءِ حَيْثُ عَنَّا ۞ وَخَمْسَةُ الأَفْعَالِ نَصْبُهَا حَذَفْ\nنُونَهُمَا إِذَا مَا نَصَبْتَ ۞ عَلَامَةُ الْخَفْضِ الَّتِي بِهَا فُيِا\nكَسْرٌ وَيَاءٌ ثُمَّ فَتْحٌ فَاقْتُفِي ۞ فَاخْفِضْ بِكَسْرٍ مُفْرَدًا وَمَا انْصَرَفْ\nوَجَمْعَ تَكْسِيرٍ إِذَا مَا انْصَرَفْ ۞ وَجَمْعَ تَأْنِيثٍ سَلِمْ\nوَبِالْيَا اخْفِضِ الْجَمْعَ وَالْخَمْسَةَ تَعْرِفْ ۞ وَاخْفِضْ بِفَتْحٍ كُلَّ مَا لَا يَنْصَرِفْ\nوَلِلَّذِي جُزِمَ السُّكُونُ وَالْحَذْفُ ۞ عَلَامَتَانِ\nفَفِي تَسْكِينِ الْمُضَارِعِ نَأْتِي صَحِيحَ الآخِرِ ۞ كَمَا لَمْ يَكُنْ فِي الذَّاكِرِينَ\nوَاجْزِمْ بِحَذْفِ مَا اخْتَلَفْ ۞ وَالْخَمْسَةَ الأَفْعَالِ\n\n[باب الأفعال وأحكام المضارع والنواصب]\nوَهِيَ ثَلَاثَةٌ مَضَى وَفِعْلٌ مُضَارِعٌ ۞ وَأَمْرٌ كَتَلَا\nفَالْمَاضِي مَفْتُوحُ الأَخِيرِ أَبَدًا ۞ وَالأَمْرُ بِالْجَزْمِ لَدَى بَعْضٍ ارْتَدَى\nثُمَّ الْمُضَارِعُ الَّذِي فِي صَدْرِهِ ۞ إِحْدَى زَوَائِدِ أَنَيْتُ فَادْرِهِ\nحُكْمُهُ الرَّفْعُ إِذَا يُجَرَّدُ ۞ مِنْ نَاصِبٍ وَجَازِمٍ كَتَسْعَدُ\nوَنَصْبُهُ بِأَنْ وَلَنْ إِذَنْ وَكَيْ ۞ وَلاَمِ كَيْ لاَمِ جَحْدٍ يَا أُخَيّ\nكَذَاكَ حَتَّى وَالْجَوَابُ بِالْفَاءِ ۞ وَالْوَاوِ ثُمَّ أَوْ وَقَفِّ الأَثَرَا\n\n[الجوازم والفاعل ونائبه]\nوَجَزْمُهُ إِذَا أَرَدْتَ الْجَزْمَا ۞ بِلَمْ وَلَمَّا وَأَلَمْ أَلَمَّا\nوَلاَمِ الأَمْرِ وَالدُّعَاءِ فَاكْتَفِ ۞ ثُمَّ لاَ فِي النَّهْيِ وَالدُّعَاءِ فَاقْتُفِي\nوَإِنْ وَمَا وَمَنْ وَأَنَّى مَهْمَا ۞ مَتَى أَيَّانَ أَيْنَ إِذْمَا\nوَحَيْثُمَا كَيْفَمَا ثُمَّ إِذَا ۞ فِي الشِّعْرِ لاَ فِي النَّثْرِ كَيْ لاَ تَنَفَذَا\nفَاعِلٌ ارْفَعْهُ وَهُوَ مَا قَدْ أُسْنِدَا ۞ إِلَيْهِ فِعْلٌ قَبْلَهُ قَدْ وُجِدَا\nوَظَاهِرًا يَأْتِي وَيَأْتِي مُضْمَرَا ۞ كَصَادَ زَيْدٌ وَاشْتَرَيْتُ أَعْفُرَا\nإِذَا حَذَفْتَ فِي الْكَلاَمِ فَاعِلاَ ۞ مُخْتَصِرًا أَوْ مُبْهِمًا أَوْ جَاهِلاَ\nفَأَوْجِبِ التَّأْخِيرَ لِلْمَفْعُولِ بِهِ ۞ وَالرَّفْعَ حَيْثُ نَابَ عَنْهُ وَانْتَبِهْ\nفَأَوَّلَ الْفِعْلِ اضْمُمَنْ وَاكْسِرْ فِيهِ ۞ مَا قَبْلَ الآخِرِ المَضِيِّ حَتْمَا\nوَمَا قُبَيْلَ آخِرِ الْمُضَارِعِ ۞ يُفْتَحُ كَيُكْرَمُ ذُو المَطَامِعِ\nوَظَاهِرًا وَمُضْمَرًا أَيْضًا ثَبَتْ ۞ كَأُكْرِمَتْ هِنْدٌ وَهِنْدٌ ضُرِبَتْ\n\n[المبتدأ والخبر وكان وأخواتها]\nالمبتدأُ اسمٌ من عواملَ سَلِمْ ۞ لفظيةٍ وهو برفعٍ قد وُسِمْ\nوالخبرُ الاسمُ الذي قد أُسْنِدا ۞ إليهِ وارتفاعَهُ الزم أَبَدَا\nوَرَفْعُكَ الاسْمَ وَنَصْبُكَ الخَبَرْ ۞ بِهَذِهِ الأَفْعَالِ حُكْمٌ مُعْتَبَرْ\nكَانَ وَأَمْسَى ظَلَّ بَاتَ أَصْبَحَا ۞ أَضْحَى وَصَارَ لَيْسَ مَعْ مَا بَرِحَا\nمَا زَالَ مَنْفَكَّ وَمَا فَتِئَ مَا ۞ دَامَ وَمَا مِنْهَا تَصَرَّفَ احْكُمَا\nلَهُ بِمَا لَهَا كَكَانَ قَائِمَا ۞ زَيْدٌ وَكُنْ بَرًّا وَأَصْبِحْ صَائِمَا\n\n[إن وأخواتها وأفعال القلوب والنعت]\nعَمَلَ كَانَ عُكِسَتْ لِإِنَّ ۞ لكِنَّ لَيْتَ ولَعَلَّ وكأنَّ\nتَقُولُ إنَّ مَالِكاً لَعَالِمُ ۞ وَمِثْلُهُ لَيْتَ الحَبِيبَ قَادِمُ\nأَكِّدْ بِإِنَّ أَنَّ شَبِّهْ بِكَأَنْ ۞ لكِنَّ يَا صَاحِ لِلاسْتِدْرَاكِ عَنْ\nوَلِلتَّمَنِّي لَيْتَ عِنْدَهُمْ حَصَلْ ۞ وَلِلتَّرَجِّي وَالتَّوَقُّعِ لَعَلْ\nانْصِبْ بِأَفْعَالِ القُلُوبِ مُبْتَدَا ۞ وَخَبَرًا وَهْيَ ظَنَنْتُ وَجَدَا\nرَأَى حَسِبْتُ وَجَعَلْتُ زَعَمَا ۞ كَذَاكَ خِلْتُ وَاتَّخَذْتُ عَلِمَا\nتَقُولُ قَدْ ظَنَنْتُ زَيْدًا صَادِقَا ۞ فِي قَوْلِهِ وَخِلْتُ عَمْرًا حَاذِقَا\nالنَّعْتُ قَدْ قَالَ ذَوُو الأَلْبَابِ ۞ يَتْبَعُ لِلْمَنْعُوتِ فِي الإِعْرَابِ\nكَذَاكَ فِي التَّعْرِيفِ وَالتَّنْكِيرِ ۞ كَجَاءَ زَيْدٌ صَاحِبُ الأَمِيرِ\n\n[المعرفة والنكرة والعطف]\nوَاعْلَمْ هُدِيتَ الرُّشْدَ أَنَّ المَعْرِفَهْ ۞ خَمْسَةُ أَشْيَاءَ عِنْدَ أَهْلِ المَعْرِفَهْ\nوَهْيَ الضَّمِيرُ ثُمَّ الِاسْمُ العَلَمُ ۞ وَذُو الأَدَاةِ ثُمَّ الِاسْمُ المُبْهَمُ\nوَمَا إِلَى أَحَدِ هَذِهِ الأَرْبَعَهْ ۞ أُضِيفَ فَافْهَمِ المِثَالَ وَاتَّبِعَهْ\nنَحْوُ أَنَا وَهِنْدُ وَالغُلَامُ ۞ وَذَاكَ وَابْنُ عَمِّنَا\nوَإِنْ تَرَ اسْماً شَائِعاً فِي جِنْسِهِ ۞ لَمْ يُعَيِّنْ وَاحِداً فِي نَفْسِهِ\nفَهُوَ المُنَكَّرُ وَمَهْمَا تُرِدِ ۞ تَقْرِيبَ حَدِّهِ لِفَهْمِ المُبْتَدِي\nفَكُلُّ مَا لِلْأَلِفِ وَاللَّامِ يَصْلُحْ ۞ كَالْفَرَسِ وَالْغُلَامِ\nهَذَا وَإِنَّ العَطْفَ أَيْضاً تَابِعُ ۞ حُرُوفُهُ عَشَرَةٌ يَا سَامِعُ\nالوَاوُ وَالفَاءُ وَثُمَّ أَوْ وَأَمْ ۞ إِمَّا وَبَلْ لا وَلَكِنْ حَتَّى\nفَاجْهَدْ تُصِبْ جَاءَ زَيْدٌ وَمُحَمَّدُ ۞ وَقَدْ سَقَيْتُ عَمْراً وَسَعِيداً مِنْ ثَمَدْ\nوَقَوْلُ خَالِدٍ وَعَامِرٍ سَدَدْ ۞ وَمَنْ يَتُبْ وَيَسْتَقِمْ يَرْقَ الرَّشَدْ\n\n[التوكيد والبدل والمفعول به]\nوَيَتْبَعُ المَؤُكَّدَ التَّوْكِيدُ فِي ۞ رَفْعٍ وَنَصْبٍ ثُمَّ خَفْضٍ فَاعْرِفِ\nكَذَاكَ فِي التَّعْرِيفِ فَاقْفُ الأَثَرَا ۞ وَهَذِهِ أَلْفَاظُهُ كَمَا تَرَى\nالنَّفْسُ وَالعَيْنُ وَكُلٌّ أَجْمَعُ ۞ وَمَا لِأَجْمَعَ لَدَيْهِمْ يَتْبَعُ\nكَمَا جَاءَ زَيْدٌ نَفْسُهُ يَصِلُ ۞ وَإِنَّ قَوْمِي كُلَّهُمْ عُدُولُ\nوَمَرَّ بِالقَوْمِ أَجْمَعِينَا ۞ مِثَالاً حَسَناً مُبِينَا\nإِذَا اسْمٌ ابْدِلَ مِنْ اسْمٍ يَنْحَلِ ۞ إِعْرَابَهُ وَالفِعْلُ أَيْضاً يُبْدَلُ\nأَقْسَامُهُ أَرْبَعَةٌ فَإِنْ تُرِدْ ۞ إِحْصَاءَهَا فَاسْمَعْ لِقَوْلِي تَسْتَفِدْ\nبَدَلُ الشَّيْءِ مِنَ الشَّيْءِ كَذَا ۞ سُرُورِي بِهِ جَاءَ وَبَدَلُ البَعْضِ بَدَا\nمِنَ الكُلِّ كَمَنْ يَأْكُلْ رَغِيفاً نِصْفَهُ ۞ يُعْطِ الثُّمُنَ\nبَدَلُ الاشْتِمَالِ نَحْوُ رَاقَنِي ۞ مُحَمَّدٌ جَمَالُهُ\nوَبَدَلُ الغَلَطِ نَحْوُ قَدْ رَكِبْ ۞ حِمَاراً فَرَسَا\nمَهْمَا تَرَ اسْماً وَاقِعاً الفِعْلُ بِهِ ۞ فَذَاكَ مَفْعُولٌ فَنَصْبَهُ انْسُبِ\nكَمِثْلِ زُرْتُ العَالِمَ الأَدِيبَا ۞ وَقَدْ رَكِبْتُ الفَرَسَ النَّجِيبَا\nظَاهِراً يَأْتِي وَيَأْتِي مُضْمَرَا ۞ فَالأَوَّلُ المِثَالُ مَا ذُكِرَا\nوَالثَّانِي قُلْ مُتَّصِلٌ وَمُنْفَصِلْ ۞ كَزَارَنِي أَخِي وَإِيَّاهُ أُصِلْ\n\n[المفعول المطلق والظرف والحال]\nالمَصْدَرُ اسْمٌ جَاءَ ثَالِثاً لَدَى ۞ تَصْرِيفِ فِعْلٍ وَانْتِصَابُهُ بَدَا\nوَهُوَ لَدَى كُلِّ فَتًى حَوَى الجَلَا ۞ مَا بَيْنَ لَفْظِيٍّ وَمَعْنَوِيٍّ جَلَا\nفَذَاكَ مَا وَافَقَ لَفْظَ فِعْلِهِ ۞ زِيَارَةً لِفَضْلِهِ إذْ وَافَقَا\nوالمَعْنَوِي المُوافِقُ المَعْنَى بِلا ۞ وَفَاقِ لَفْظٍ هَكَذَا قَدْ نُقِلَا\nوَالظَّرْفُ مَنْصُوبٌ عَلَى إِضْمَارِ فِي ۞ وَهْوَ زَمَانِيٌّ وَمَكَانِيٌّ يَفِي\nأَمَّا الزَّمَانِيُّ فَنَحْوُ مَا تَرَى ۞ اليَوْمَ وَاللَّيْلَةَ ثُمَّ سَحَرَا\nوَغُدْوَةً وَبُكْرَةً غَداً حِينَا ۞ وَوَقْتاً أَبَداً وَأَمَداً حِينَا\nمَسَاءً وَصَبَاحاً اسْتَعْمِلِ ۞ بَغْيَةَ أَنْ تَنَالَ خَيْرَ أَمَلِ\nثُمَّ المَكَانِيُّ مِثَالُهُ الجَلِي ۞ أَمَامَ قُدَّامَ وَخَلْفَ يَلِي\nوَرَاءَ فَوْقَ تَحْتَ عِنْدَ مَعْ إِزَاءَا ۞ تِلْقَاءَ ثَمَّ وَهُنَا حِذَاءَا\nالحَالُ لِلْهَيْئَاتِ مِمَّا انْبَهَمَا ۞ مُفَسِّرٌ وَنَصْبُهُ حَتْماً نَمَا\nكَـ جَاءَ زَيْدٌ ضَاحِكاً مُبْتَهِجَا ۞ وَبَاعَ بَكْرٌ الحِصَانَ مُسْرَجَا\nوَإِنَّنِي لَقِيتُ عَمْراً رَائِداً ۞ فَاعْلَمْ مِثَالاً وَافْهَمِ المَقَاصِدَا\n\n[التمييز والاستثناء]\nاسْمٌ مُفَسِّرٌ لِمَا قَدِ انْبَهَمْ ۞ مِنَ الذَّوَاتِ بِاسْمِ تَمْيِيزٍ وَسِمْ\nوَنَصْبُهُ اشْتَهَرْ طَابَ زَيْدٌ نَفْساً ۞ وَلِي عَلَيْهِ أَرْبَعُونَ فَلْساً\nوَخَالِدٌ أَكْرَمُ مِنْ عَمْرٍو أَبَا ۞ وَكَوْنُهُ نَكِرَةً قَدْ وَجَبَا\nإِلاَّ وَغَيْرُ وَسِوَى سُوَىً سَوَا ۞ خَلاَ عَدَا وَحَاشَا الاِسْتِثْنَا حَوَى\nإِذَا الكَلاَمُ تَمَّ وَهْوَ مُوجَبُ ۞ فَمَا أَتَى مِنْ بَعْدِ إِلاَّ يُنْصَبُ\nتَقُولُ قَامَ القَوْمُ إِلاَّ عَمْرَا ۞ وَقَدْ أَتَانِي النَّاسُ إِلاَّ بَكْرَا\nوَإِنْ بِنَفْيٍ وَتَمَامٍ حُلِّيَا ۞ فَأَبْدِلَ اوْ بِالنَّصْبِ جِيءْ مُسْتَثْنِيَا\nكَلَمْ يَقُمْ أَحَدٌ الاَّ صَالِحُ ۞ أَوْ صَالِحًا فَهْوَ لِذَيْنِ صَالِحُ\nأَوْ كَانَ نَاقِصًا فَأَعْرِبْهُ عَلَى ۞ حَسَبِ مَا يَجِيءُ فِيهِ العَمَلاَ\nكَمَا هَدَى إِلاَّ مُحَمَّدٌ وَمَا ۞ عَبَدتُّ إِلاَّ اللهَ فَاطِرَ السَّمَا\nوَهَلْ يَلُوذُ العَبْدُ يَوْمَ الحَشْرِ ۞ إِلاَّ بِأَحْمَدَ شَفِيْعِ البَشَرِ\nوَحُكْمُ مَا اسْتَثْنَتْهُ غَيرُ وَسِوَى ۞ سُوَى سَوَاءٌ أَنْ يُجَرَّ لاَ سِوَى\nوَانْصِبْ أَوِ اجْرُرْ مَا بِحَاشَا وَعَدَا ۞ خَلاَ قَدِ اسْتَثْنَيْتَهُ مُعْتَقِدَا\nفِي حَالَةِ النَّصْبِ بِهَا الفِعْلِيَّهْ ۞ وَحَالَةِ الجَرِّ بِهَا الحَرْفِيَّهْ\nتَقُولُ قَامَ القَوْمُ حَاشَا جَعْفَرَا ۞ أَوْ جَعْفَرٍ فَقِسْ لِكَيْمَا تَظْفَرَا\n\n[لا النافية للجنس والمنادى والمفعول له]\nانْصِبْ بِـ لاَ مُنَكَّراً مُتَّصِلاَ ۞ مِنْ غَيْرِ تَنْوِينٍ إِذَا أَفْرَدْتَ لاَ\nتَقُولُ لاَ إِيمَانَ لِلْمُرْتَابِ ۞ وَمِثْلُهُ لاَ رَيْبَ فِي الكِتَابِ\nوَيَجِبُ التَّكْرَارُ وَالإِهْمَالُ ۞ لَهَا إِذَا مَا وَقَعَ الانْفِصَالُ\nتَقُولُ فِي المِثَالِ لاَ فِي بَكْرِ ۞ شُحٌّ وَلاَ بُخْلٌ إِذَا مَا اسْتَقْرَى\nوَجَازَ إِنْ تَكَرَّرَتْ مُتَّصِلَهْ ۞ إِعْمَالُهَا وَأَنْ تَكُونَ مُهْمَلَهْ\nتَقُولُ لاَ ضِدَّ لِرَبِّنَا وَلاَ نِدَّ ۞ وَمَنْ يَأْتِ بِرَفْعٍ فَقَبِلْهْ\nإِنَّ المُنَادَى فِي الكَلاَمِ ياتِي ۞ خَمْسَةَ أَنْوَاعٍ لَدَى النُّحَاةِ\nالمُفْرَدُ العَلَمُ ثُمَّ النَّكِرَهْ ۞ أَعْنِي بِهَا المَقْصُودَةَ المُشْتَهِرَهْ\nثُمَّ الَّتِي لَمْ تُقْصَدَنْ فَالْمُضَافُ ۞ وَالمُشَبَّهُ بِهِ فِيهِ إِجْحَافُ\nفَالأَوَّلاَنِ ابْنِهِمَا بِالضَّمِّ ۞ أَوْ مَا يَنُوبُ عَنْهُ هَذَا الفَهْمِ\nتَقُولُ يَا شَيْخُ وَيَا زُهَيْرُ ۞ وَالبَاقِي انْصِبَنَّهُ لاَ غَيْرُ\nوَهْوَ الَّذِي جَاءَ بَيَاناً لِسَبَبْ ۞ كَيْنُونَةِ العَامِلِ فِيهِ وَانْتَصَبْ\nقُمْتُ إِجْلاَلاً لِهَذَا الحَبْرِ ۞ وَزُرْتُ أَحْمَدَ ابْتِغَاءَ البِرِّ\n\n[المفعول معه والمخفوضات والخاتمة]\nوَهْوَ اسْمٌ انْتَصَبَ بَعْدَ وَاوِ مَعْ ۞ فِي قَوْلِ كُلِّ رَاوِي نَحْوُ أَتَى\nالأَمِيرُ وَالجَيْشَ قُبَالَى ۞ سَارَ زَيْدٌ وَالطَّرِيقَ هَارِبَا\nالخَفْضُ بِالحَرْفِ وَبِالإِضَافَةِ ۞ كَـ مِثْلِ أَكْرِمْ بِأَبِي قُحَافَةِ\nوَبِالتَّبَعِيَّةِ الَّتِي خَلَتْ ۞ وَقُرِّرَتْ أَبْوَابُهَا وَفُصِّلَتْ\nوَمَا يَلِي المُضَافَ بِاللاَّمِ فِي ۞ تَقْدِيرِهِ أَوْ مِنْ وَقِيلَ أَوْ فِي\nكَـ اسْتَفَادَ خَاتَمَيْنِ نَضَارِ ۞ وَنَحْوِ مَكْرِ اللَّيْلِ وَالنَّهَارِ\nقَدْ تَمَّ فِي عَامِ عِشْرِينَ وَأَلْفِ ۞ وَمِائَةٍ بِحَمْدِ رَبِّنَا وَصَرْفِ\nوَحُسْنِ عَوْنِهِ وَرِفْقِهِ وَمَنِّهِ ۞ وَصَوْنِهِ مَنْظُومَةً رَائِقَةً\nجَعَلَهَا اللَّهُ لِكُلِّ مُبْتَدِي ۞ دَائِمَةَ النَّفْعِ بِجَاهِ أَحْمَدِي\nصَلَّى عَلَيْهِ رَبُّنَا وَسَلَّمَا ۞ وَآلِهِ وَصَحْبِهِ وَكَرَّمَا\n\n[تم المتن كاملاً — راجعه درساً درساً في الدروس 01 إلى 13]","briefExplanation":"هذا درس المتن الجامع: فيه نظم عبيد ربه (محمد بن اْب التواتي) كاملاً مكتوباً — من حمد الله والصلاة على رسوله إلى خاتمة الناظم بتاريخ الفراغ سنة 1120هـ — مرتباً على أبوابه الثلاثة عشر كما تُشرح في الدروس، لتقرأه وتكتبه وتحفظه، ثم ترجع لكل باب في درسه.","detailedExplanation":"هذا الدرس هو ديوان المقرر: المتن كاملاً للقراءة والكتابة والحفظ.\n\n[أولاً: كيف تستعمل هذا الدرس]\n١- اقرأ المتن كاملاً قراءة مرتلة متأنية مع الفيديو المرفق، باباً باباً.\n٢- اكتب كل باب بخط يدك بعد قراءته — الكتابة نصف الحفظ كما يقول المشايخ.\n٣- احفظ من كل باب أبيات الضوابط (الأبيات الجامعة للأحكام) قبل الانتقال لدرسه.\n٤- راجع المتن كاملاً بعد إتمام الدروس 01-13 وقبل اختبار كل درس.\n\n[ثانياً: فهرس الأبواب على الدروس]\n- المقدمة وباب الكلام: الدرس 01 (من قال عبيد ربه إلى سبيلا ودليلا).\n- باب الإعراب وعلامات الرفع: الدرس 02 (من الإعراب تغيير أواخر الكلم إلى تفعلين تفعلون).\n- علامات النصب والخفض والجزم: الدرس 03 (من علامة النصب لها كن محصيا إلى والخمسة الأفعال).\n- الأفعال والنواصب: الدرس 04 (من وهي ثلاثة مضى وفعل مضارع إلى وقف الأثرا).\n- الجوازم والفاعل ونائبه: الدرس 05 (من وجزمه إذا أردت الجزما إلى وهند ضربت).\n- المبتدأ والخبر وكان: الدرس 06 (من المبتدأ اسم من عوامل سلم إلى وأصبح صائما).\n- إن وأخواتها وأفعال القلوب والنعت: الدرس 07 (من عمل كان عكست لإن إلى صاحب الأمير).\n- المعرفة والنكرة والعطف: الدرس 08 (من واعلم هديت الرشد إلى يرق الرشد).\n- التوكيد والبدل والمفعول به: الدرس 09 (من ويتبع المؤكد التوكيد إلى وإياه أصل).\n- المفعول المطلق والظرف والحال: الدرس 10 (من المصدر اسم جاء ثالثا إلى وافهم المقاصدا).\n- التمييز والاستثناء: الدرس 11 (من اسم مفسر لما قد انبهم إلى لكيما تظفرا).\n- لا النافية والمنادى والمفعول له: الدرس 12 (من انصب بلا منكرا متصلا إلى ابتغاء البر).\n- المفعول معه والمخفوضات والخاتمة: الدرس 13 (من وهو اسم انتصب بعد واو مع إلى وصحبه وكرما).\n\n[ثالثاً: عن الناظم]\nالناظم هو محمد بن اْب التواتي الشنقيطي، يكني نفسه تواضعاً (عبيد ربه)، نظم مقدمة ابن آجروم نثراً تسهيلاً لحفظها، وفرغ منه سنة عشرين وألف ومائة للهجرة كما نص في الخاتمة، وختم بالدعاء أن يجعلها الله دائمة النفع لكل مبتدئ بجاه أحمد صلى الله عليه وسلم.","evidences":[],"scholars":[],"benefits":["حفظ المتن يجمع أبواب النحو في الصدر.","النظم تسهيل لمنثور ابن آجروم.","الحفظ اليومي القليل مع المراجعة أنفع من الكثير المتقطع.","خريطة النظم هي ترتيب دروس المقرر."],"terms":[{"term":"المتن","definition":"النص العلمي المختصر المعد للحفظ."},{"term":"النظم","definition":"صياغة المتن شعرا لتسهيل حفظه."},{"term":"عبيد ربه","definition":"صفة تواضع بها الناظم محمد بن التواتي لله، وليست اسما له."}],"mindMap":{"title":"مدخل نظم الآجرومية","branches":[{"title":"المؤلف","items":["محمد بن اْب الشنقيطي","تسهيل منثور ابن آجروم"]},{"title":"المنهج","items":["سماع المتن","حفظ تدريجي","فهم ثم تطبيق"]},{"title":"الخريطة","items":["الكلام والإعراب","العلامات والأفعال","المرفوعات والمنصوبات والمخفوضات"]}]},"summaryTable":{"headers":["المرحلة","العمل","الثمرة"],"rows":[["السماع","الاستماع لقراءة المتن","ضبط اللفظ"],["الحفظ","خمسة أبيات يوميا مع مراجعة","استحضار القواعد"],["الدرس","شرح كل باب في درسه","الفهم والتطبيق"]]},"video":{"url":"https://www.youtube.com/watch?v=Nu5zn61fA_Y","title":"نظم الآجرومية | قراءة صوتية كاملة"}},"questions":[{"q":"من ناظم هذه المنظومة؟","options":["ابن مالك","ابن هشام","الزمخشري","محمد بن اْب الشنقيطي"],"answer":3},{"q":"ما غاية النظم كما ذكر الناظم؟","options":["تسهيل منثور ابن آجروم","شرح ألفية ابن مالك","جمع الشواهد الشعرية","نظم قواعد الصرف"],"answer":0},{"q":"ما المنهج المقترح للحفظ؟","options":["حفظ المتن كله دفعة واحدة","قليل يومي مع مراجعة","الحفظ دون فهم","ترك المراجعة"],"answer":1},{"q":"بماذا يبدأ النظم بعد المقدمة؟","options":["بباب الفاعل","بباب الاستثناء","بباب الكلام","بالخاتمة"],"answer":2},{"q":"لماذا يحفظ طالب النحو متنا؟","options":["ليستحضر القواعد عند الحاجة","ليستغني عن الفهم","ليتفاخر بالحفظ","ليترك الشرح"],"answer":0},{"q":"كيف تستعمل دروس هذا المقرر؟","options":["اختبار قبل الشرح","سماع ثم شرح ثم اختبار مع حفظ","حفظ دون شرح","شرح دون مراجعة"],"answer":1}]},{"id":"ajr-01","order":2,"title":"الدرس 01: المقدمة وباب الكلام","chapter":"المقدمة والكلام","summary":"التعريف بالناظم ومنظومته، وشرح أبيات المقدمة، وحد الكلام وشروطه وأقسامه وعلامات كل قسم مع الشواهد.","content":{"objectives":["أن يذكر الطالب اسم الناظم ومعنى عبيد ربه والغرض من النظم.","أن يشرح أبيات المقدمة الخمسة.","أن يعدد شروط الكلام الأربعة عند النحاة.","أن يبين أقسام الكلام وترتيبها وعلامات كل قسم مع الشواهد."],"matn":"قَالَ عُبَيْدُ رَبِّهِ مُحَمَّدُ ۞ اللهَ فِي كُلِّ الأُمُورِ أَحْمَدُ\nمُصَلِّيًا عَلَى الرَّسُولِ الْمُصْطَفَى ۞ وَآلِهِ وَصَحْبِهِ وَمَنْ تَلَا\nوَبَعْدُ فَالْقَصْدُ بَذَا النَّظْمِ بَدَا ۞ تَسْهِيلُ مَا اصْطَلَحَ مِنْهُ جُلَّ الرُّومِي\nلِمَنْ أَرَادَ حِفْظَهُ وَعَسُرَا ۞ عَلَيْهِ أَنْ يَحْفَظَ مَا قَدْ نُثِرَا\nوَاللهَ أَسْتَعِينُ فِي كُلِّ عَمَلْ ۞ عَلَيْهِ مَعْتَمَدِي وَإِلَيْهِ الْمُبْتَهَلْ\nإِنَّ الْكَلاَمَ عِنْدَنَا مُرَكَّبُ ۞ مُفِيدٌ قَدْ وَضَعَ لِلإِفَادَةِ\nأَقْسَامُهُ الَّتِي عَلَيْهَا يُبْنَى ۞ اِسْمٌ وَفِعْلٌ ثُمَّ حَرْفُ مَعْنَى\nفَالاسْمُ بِالْخَفْضِ وَالتَّنْوِينِ وَدُخُولِ أَلْ ۞ يُعْرَفُ وَبِحُرُوفِ الْجَرِّ كَمَا جَلَا\nوَهِيَ مِنْ إِلَى وَعَنْ وَفِي وَرُبَّ وَعَلَى ۞ وَالْكَافُ وَاللاَّمُ وَالْوَاوُ وَالتَّاءُ وَمُذْ وَمُنْذُ وَحَتَّى\nوَالْفِعْلُ بِالسِّينِ وَسَوْفَ وَبِقَدْ ۞ وَبِتَاءِ تَأْنِيثٍ مَيَّزَهُ صَدَدْ\nوَالْحَرْفُ يَعْرِفُ بِأَنْ لاَ يَقْبَلَا ۞ لِلاسْمِ وَلاَ لِلْفِعْلِ سَبِيلًا وَدَلِيلَا","briefExplanation":"تعرف هذه المنظومة عند أهل شنقيط باسم عبيد ربه، وهو صفة تواضع للناظم محمد بن التواتي. وغرضها تسهيل مقدمة الآجرومية لحفظها. ثم يشرح باب الكلام: حده وشروطه الأربعة، وأقسامه الثلاثة مرتبة، وعلامات كل قسم مع الشواهد القرآنية.","detailedExplanation":"## 1. التعريف بالناظم والمنظومة\n\nتشتهر هذه المنظومة عند أهل شنقيط باسم عبيد ربه، وعبيد ربه ليس اسما للناظم بل صفة تواضع بها لله، واسمه محمد بن التواتي. والراجح بالبحث أنه من مدينة جزائرية وليس شنقيطيا.\n\nوالغرض من النظم تسهيل مقدمة الآجرومية للإمام أبي عبد الله محمد بن عبد الله بن آجروم المتوفى سنة 733هـ على الطلاب لحفظها، لأنها نثرت فعسر حفظ منثورها على بعضهم.\n\n## 2. شرح أبيات المقدمة بيتاً بيتاً\n\n- **البيت:** قَالَ عُبَيْدُ رَبِّهِ مُحَمَّدُ / اللهَ فِي كُلِّ الأُمُورِ أَحْمَدُ\n\n  - **تفكيك العبارات:** عبيد ربه: صفة تواضع لا اسم علم؛ أحمد: أثني وأشكر؛ في كل الأمور: في جميع الشؤون.\n\n  - **معنى البيت:** افتتح الناظم باسم نفسه متواضعاً لله، ثم حمد الله في كل الأمور مقدِّماً لفظ الجلالة منصوباً على التعظيم لإفادة الاختصاص — فالحمد كله لله وحده.\n\n- **البيت:** مُصَلِّيًا عَلَى الرَّسُولِ الْمُصْطَفَى / وَآلِهِ وَصَحْبِهِ وَمَنْ تَلَا\n\n  - **تفكيك العبارات:** المصطفى: المختار صلى الله عليه وسلم؛ الآل: أقاربه المؤمنون؛ الصحب: أصحابه المتقون؛ ومن تلا: ومن تبعهم بإحسان.\n\n  - **معنى البيت:** ثنّى بالصلاة على النبي صلى الله عليه وسلم وآله وصحبه وتابعيهم، جرياً على عادة المصنفين في الافتتاح.\n\n- **البيت:** وَبَعْدُ فَالْقَصْدُ بَذَا النَّظْمِ بَدَا / تَسْهِيلُ مَا اصْطَلَحَ مِنْهُ ...\n\n  - **تفكيك العبارات:** وبعد: أي وبعد الحمدلة والصلاة؛ القصد: الغرض؛ بذا النظم: بهذا المنظوم؛ بدا: ظهر؛ تسهيل ما اصطلح: تيسير مصطلح هذا الفن.\n\n  - **معنى البيت:** صرّح بغرضه: تيسير مصطلح الآجرومية نظماً ليسهل حفظه على الطلاب.\n\n- **البيت:** لِمَنْ أَرَادَ حِفْظَهُ وَعَسُرَا / عَلَيْهِ أَنْ يَحْفَظَ مَا قَدْ نُثِرَا\n\n  - **تفكيك العبارات:** وعسرا: وصعُب عليه؛ ما قد نثرا: المنثور من المتن.\n\n  - **معنى البيت:** هذا النظم لمن أراد حفظ الآجرومية فعسر عليه حفظ نثرها — فالنظم مطية الحفظ.\n\n- **البيت:** وَاللهَ أَسْتَعِينُ فِي كُلِّ عَمَلْ / عَلَيْهِ مُعْتَمَدِي وَإِلَيْهِ الْمُبْتَهَلْ\n\n  - **تفكيك العبارات:** أستعين: أطلب العون؛ معتمدي: موضع اعتمادي؛ المبتهل: المتضرَّع إليه.\n\n  - **معنى البيت:** ختم المقدمة بالاستعانة بالله والاعتماد عليه والتضرع إليه في كل عمل — أدب طالب العلم قبل الشروع.\n\n\n> منهج هذا الدرس: نبدأ بألفاظ الأبيات بيتاً بيتاً، ثم نبسط معناها العام وقواعدها.\n\n## 3. ألفاظ أبيات باب الكلام بيتاً بيتاً\n\nفي هذا القسم نفكك كلمات كل بيت وعباراته أولا، ثم نذكر معناه إجمالا.\n\n- **البيت:** إِنَّ الْكَلاَمَ عِنْدَنَا مُرَكَّبُ / مُفِيدٌ قَدْ وَضَعَ لِلإِفَادَةِ\n\n  - **تفكيك العبارات:** عندنا: عند النحاة؛ مركب: من كلمتين فأكثر؛ مفيد: فائدة يحسن السكوت عليها؛ وضع: قصد؛ للإفادة: لأجل الإفادة.\n\n  - **معنى البيت:** حد الكلام وشروطه الأربعة.\n\n- **البيت:** أَقْسَامُهُ الَّتِي عَلَيْهَا يُبْنَى / اِسْمٌ وَفِعْلٌ ثُمَّ حَرْفُ مَعْنَى\n\n  - **تفكيك العبارات:** التي عليها يبنى: التي يتأسس عليها؛ ثم: للتراخي في الرتبة؛ حرف معنى: الحرف الدال على معنى في غيره.\n\n  - **معنى البيت:** أقسام الكلام ثلاثة مرتبة.\n\n- **البيت:** فَالاسْمُ بِالْخَفْضِ وَالتَّنْوِينِ وَدُخُولِ أَلْ / يُعْرَفُ وَبِحُرُوفِ الْجَرِّ كَمَا جَلَا\n\n  - **تفكيك العبارات:** بالخفض: بالكسرة التي يحدثها العامل؛ التنوين: نون ساكنة لفظا لا خطا؛ دخول أل: أداة التعريف؛ كما جلا: كما اتضح.\n\n  - **معنى البيت:** علامات الاسم الأربع.\n\n- **البيت:** وَهِيَ مِنْ إِلَى وَعَنْ وَفِي وَرُبَّ وَعَلَى / وَالْكَافُ وَاللاَّمُ وَالْوَاوُ وَالتَّاءُ وَمُذْ وَمُنْذُ وَحَتَّى\n\n  - **تفكيك العبارات:** سرد حروف الجر الأربعة عشر.\n\n  - **معنى البيت:** حصر حروف الجر.\n\n- **البيت:** وَالْفِعْلُ بِالسِّينِ وَسَوْفَ وَبِقَدْ / وَبِتَاءِ تَأْنِيثٍ مَيَّزَهُ صَدَدْ\n\n  - **تفكيك العبارات:** بالسين وسوف: للمضارع؛ بقد: مشتركة؛ بتاء تأنيث: الساكنة للماضي؛ ميزه: ميز الفعل؛ صدد: قصدا وحقا.\n\n  - **معنى البيت:** علامات الفعل.\n\n- **البيت:** وَالْحَرْفُ يَعْرِفُ بِأَنْ لاَ يَقْبَلَا / لِلاسْمِ وَلاَ لِلْفِعْلِ سَبِيلًا وَدَلِيلَا\n\n  - **تفكيك العبارات:** لا يقبلا: لا يقبل؛ سبيلا: طريقا إليها؛ ودليلا: دليلا بها.\n\n  - **معنى البيت:** علامة الحرف عدمية.\n\n\n\n## 4. المعنى العام (1): حد الكلام وشروطه\n\nالكلام عند أهل النحو لا بد فيه من أربعة شروط: اللفظ وهو الصوت الخارج من الفم المشتمل على بعض الحروف الهجائية، فلا يسمى الخط ولا الإشارة كلاما في الاصطلاح. والتركيب فلا يكون كلمة مفردة. والإفادة فائدة يحسن السكوت عليها. والوضع بأن يكون مقصودا بالعربية، بخلاف كلام النائم والمجنون.\n\n\n- **مثال المركب:** ما تركب من كلمتين فأكثر وأفاد — إسنادي (العلمُ نورٌ)، إضافي (كتابُ زيدٍ)، مزجي (بعلبكُّ)، عددي (أحدَ عشرَ)؛ والمفرد وحده كـ (زيدٌ) ليس كلاماً.\n\n## 5. المعنى العام (2): أقسام الكلام\n\nينقسم الكلام إجماعا إلى ثلاثة: اسم قدم لشرفه ولأنه تتألف منه الجملة بنفسه، وفعل تلاه في الرتبة وتتألف الجملة من اسم وفعل، وحرف معنى عطف بثم المفيدة للتراخي لدلالة انحطاط رتبته عنهما.\n\n## 6. المعنى العام (3): علامات الاسم\n\nيعرف الاسم بالخفض وهو الكسرة التي يحدثها العامل، وبالتنوين وهو نون ساكنة تلحق آخر الاسم لفظا لا خطا، وبدخول أل، وبدخول حروف الجر.\n\nوحروف الجر ومعانيها: من لابتداء الغاية، وإلى لانتهائها، وعن للمجاوزة، وفي للظرفية، ورب للتقليل أو التكثير، وعلى للاستعلاء، والكاف للتشبيه، واللام للملك، وحروف القسم الواو والتاء، ومذ ومنذ لابتداء الزمان، وحتى لانتهاء الغاية.\n\n\n- **مثال التنوين:** تمكين في المعرب المنصرف (رجلٌ)، تنكير في المبني (صهٍ بمعنى اسكتْ)، مقابلة لنون جمع المذكر (مسلماتٍ)، عوض عن حرف (جوارٍ) أو عن جملة (يومئذٍ).\n- **مثال الخفض:** (مررتُ بزيدٍ) — الكسرة أثر عامل الجر.\n- **مثال دخول أل:** (الرجلُ قائمٌ) للعهد أو الجنس.\n- **مثال كل حرف جر:** من (خرجتُ من البيتِ)، إلى (سافرتُ إلى مكةَ)، عن (ابتعدْ عن الشرِّ)، على (الكتابُ على المكتبِ)، في (الماءُ في الكوبِ)، رب (ربَّ رجلٍ كريمٍ لقيتُ)، الباء (كتبتُ بالقلمِ)، الكاف (زيدٌ كالأسدِ)، اللام (المالُ لزيدٍ)، الواو (واللهِ)، التاء (تاللهِ)، مذ ومنذ (ما رأيتُه مذ يومينِ)، حتى (أكلتُ السمكةَ حتى رأسِها).\n\n## 7. المعنى العام (4): علامات الفعل والحرف\n\nالسين وسوف تختصان بالفعل المضارع، وقد مشتركة بين الماضي والمضارع، وتاء التأنيث الساكنة تختص بالفعل الماضي. ولم يذكر علامة فعل الأمر لأن المصنف آثر مذهب الكوفيين الذين يرون الأمر جزءا اقتطع من المضارع.\n\nوعلامة الحرف عدمية: ألا يقبل علامات الاسم ولا علامات الفعل. وكما قال الحريري: والحرف ما ليست له علامه ... فقس على قولي تكن علامه.\n\n\n\n- **مثال السين وسوف:** (سيكتبُ) للقريب و(سوف يكتبُ) للبعيد.\n- **مثال قد:** مع الماضي للتحقيق (قد أفلحَ المؤمنون)، ومع المضارع للتقليل (قد ينجحُ الكسولُ).\n- **مثال تاء التأنيث:** (كتبتْ هندٌ الدرسَ).\n","evidences":[{"type":"quran","text":"﴿مِنَ الْمَسْجِدِ الْحَرَامِ إِلَى الْمَسْجِدِ الْأَقْصَى﴾","reference":"سورة الإسراء: 1 (من للابتداء وإلى للانتهاء)"},{"type":"quran","text":"﴿إِذْ هُمَا فِي الْغَارِ﴾","reference":"سورة التوبة: 40 (في للظرفية)"},{"type":"quran","text":"﴿وَعَلَيْهَا وَعَلَى الْفُلْكِ تُحْمَلُونَ﴾","reference":"سورة المؤمنون: 22 (على للاستعلاء)"},{"type":"quran","text":"﴿لِلَّهِ مَا فِي السَّمَاوَاتِ﴾","reference":"سورة البقرة: 284 (اللام للملك)"},{"type":"quran","text":"﴿وَالْعَصْرِ﴾","reference":"سورة العصر: 1 (الواو للقسم)"},{"type":"quran","text":"﴿حَتَّىٰ مَطْلَعِ الْفَجْرِ﴾","reference":"سورة القدر: 5 (حتى لانتهاء الغاية)"},{"type":"quran","text":"﴿قَدْ أَفْلَحَ مَنْ زَكَّاهَا﴾","reference":"سورة الشمس: 9 (قد مع الماضي)"},{"type":"quran","text":"﴿قَدْ يَعْلَمُ مَا أَنْتُمْ عَلَيْهِ﴾","reference":"سورة النور: 63 (قد مع المضارع)"},{"type":"quran","text":"﴿إِذَا الشَّمْسُ كُوِّرَتْ﴾","reference":"سورة التكوير: 1 (تاء التأنيث)"}],"scholars":[],"benefits":["عبيد ربه صفة تواضع لا اسم للناظم.","الغرض تسهيل الآجرومية للحفظ.","شروط الكلام أربعة لا تتم بدونه.","الاسم مقدم لشرفه والحرف مؤخر لانحطاط رتبته.","لكل حرف جر معنى يحفظ بشاهده.","علامة الحرف عدمية.","أدب الافتتاح: الحمدلة ثم الصلاة ثم بيان القصد ثم الاستعانة — منهج المصنفين.","تقديم المفعول (اللهَ أحمدُ) يفيد الاختصاص: فالحمد كله لله."],"terms":[{"term":"اللفظ","definition":"الصوت الخارج من الفم المشتمل على بعض الحروف."},{"term":"الوضع","definition":"كون الكلام مقصودا بالعربية."},{"term":"الخفض","definition":"الكسرة التي يحدثها العامل في آخر الاسم."},{"term":"التنوين","definition":"نون ساكنة تلحق آخر الاسم لفظا لا خطا."},{"term":"العلامة العدمية","definition":"عدم قبول الشيء علامات غيره، كالحرف."},{"term":"الحمدلة","definition":"الثناء على الله بأوصاف الكمال، وهي مفتتح المصنفات."},{"term":"الاستعانة","definition":"طلب العون من الله والاعتماد عليه في كل عمل."}],"mindMap":{"title":"المقدمة وباب الكلام","branches":[{"title":"الناظم","items":["محمد بن التواتي","عبيد ربه صفة تواضع","تسهيل الآجرومية"]},{"title":"الكلام","items":["اللفظ","المركب","المفيد","الوضع"]},{"title":"الأقسام","items":["اسم","فعل","حرف معنى"]},{"title":"العلامات","items":["الاسم بالخفض والتنوين وأل والجر","الفعل بالسين وسوف وقد والتاء","الحرف بعدم القبول"]}]},"summaryTable":{"headers":["القسم","علاماته","شاهده"],"rows":[["الاسم","الخفض والتنوين وأل والجر","بسم الله"],["الفعل","السين وسوف وقد وتاء التأنيث","سيعلمون وقد أفلح"],["الحرف","عدم قبول العلامتين","بيت الحريري"]]},"video":{"url":"https://www.youtube.com/watch?v=RDBLeL5gkJs","title":"شرح نظم الآجرومية // 01 // الشيخ محمد محمود الشنقيطي"}},"questions":[{"q":"ما معنى عبيد ربه في عنوان المنظومة؟","options":["صفة تواضع للناظم","اسم بلد","عنوان باب","اسم الناظم"],"answer":3},{"q":"ما الغرض من نظم الآجرومية؟","options":["تسهيل مقدمة الآجرومية للحفظ","شرح ألفية ابن مالك","جمع الشواهد","نظم الصرف"],"answer":0},{"q":"كم شروط الكلام عند النحاة؟","options":["أربعة","ثلاثة","خمسة","ستة"],"answer":1},{"q":"أي مما يأتي ليس شرطا في الكلام؟","options":["التركيب","الإفادة","اللفظ","الكتابة"],"answer":2},{"q":"لم عطف حرف المعنى بثم؟","options":["لانحطاط رتبته","لشرفه","للتسوية","لا معنى لها"],"answer":0},{"q":"ما علامة الحرف؟","options":["علامة عدمية","علامة وجودية","التنوين","السين"],"answer":1}]},{"id":"ajr-02","order":3,"title":"الدرس 02: باب الإعراب وعلامات الرفع","chapter":"الإعراب والرفع","summary":"تعريف الإعراب وأقسامه وأنواع التغير، ثم علامات الرفع الأربع بالتفصيل والشواهد القرآنية.","content":{"objectives":["أن يعرف الطالب الإعراب لغة واصطلاحا.","أن يميز التغير اللفظي والتقديري والمحلي.","أن يبين اختصاص كل قسم من أقسام الإعراب.","أن يفصل علامات الرفع الأربع بشواهدها."],"matn":"اَلإِعْرَابُ تَغْيِيرُ أَوَاخِرِ الْكَلِمْ ۞ تَقْدِيرًا أوْ لَفْظًا فَذَا الحَدَّ ذَكَرُ\nوَذَلِكَ التَّغْيِيرُ لِاضْطِرَابِ ۞ عَوَامِلٍ تَدْخُلُ لِلإِعْرَابِ\nأَقْسَامُهُ أَرْبَعَةٌ فَلْتُعْتَبَرْ ۞ رَفْعٌ وَنَصْبٌ ثُمَّ خَفْضٌ وَجَزَمْ\nفَالْأَوَّلَانِ دُونَ رَيْبٍ وَقَعَا ۞ فِي الِاسْمِ وَالْفِعْلِ الْمُضَارِعِ مَعَا\nوَالِاسْمُ قَدْ خُصِّصَ بِالْجَرِّ كَمَا ۞ قَدْ خُصِّصَ الْفِعْلُ بِجَزْمٍ فَاعْلَمَا\nضَمٌّ وَوَاوٌ أَلِفٌ وَالنُّونُ ۞ عَلَامَةُ الرَّفْعِ بِهَا تَكُونُ\nفَارْفَعْ بِضَمٍّ مُفْرَدَ الأَسْمَاءِ ۞ كَجَاءَ زَيْدٌ صَاحِبُ الْعَلَاءِ\nوَارْفَعْ بِهِ الْجَمْعَ الْمُكَسَّرَ وَمَا ۞ جُمِعَ مِنْ تَأْنِيثٍ سَلِمَا\nكَالمُضَارِعِ الَّذِي لَمْ يَتَّصِلْ ۞ شَيْءٌ بِهِ كَيَهْتَدِي وَكَيَصِلْ\nوَارْفَعْ بِوَاوٍ خَمْسَةً أَخُوكَا ۞ أَبُوكَ ذُو مَالٍ حَمُوكَ فُوكَا\nوَهَكَذَا الْجَمْعُ الصَّحِيحُ فَاعْرِفِ ۞ وَرَفْعُ مَا ثَنَّيْتَهُ بِالأَلِفِ\nوَارْفَعْ بِنُونٍ يَفْعَلَانِ يَفْعَلُونْ ۞ وَتَفْعَلَانِ تَفْعَلِينَ تَفْعَلُونْ","briefExplanation":"الإعراب لغة التحسين والتبيين، واصطلاحا تغير أواخر الكلم لفظا أو تقديرا بسبب العوامل. والتغير ثلاثة أنواع: لفظي وتقديري ومحلي. وأقسامه رفع ونصب يشترك فيهما الاسم والفعل، وخفض يختص بالاسم، وجزم يختص بالفعل. وعلامات الرفع أربع: الضمة أصل والواو والألف والنون نواب.","detailedExplanation":"## 1. تعريف الإعراب\n\nالإعراب لغة التحسين والتبيين، واصطلاحا تغيير أواخر الكلم تقديرا أو لفظا بسبب اختلاف العوامل الداخلة عليها.\n\n## 2. ألفاظ أبيات الدرس بيتاً بيتاً\n> منهج هذا الدرس: نبدأ بألفاظ الأبيات بيتاً بيتاً، ثم نبسط معناها العام وقواعدها.\n\n\nفي هذا القسم نفكك كلمات كل بيت وعباراته أولا، ثم نذكر معناه إجمالا.\n\n- **البيت:** اَلإِعْرَابُ تَغْيِيرُ أَوَاخِرِ الْكَلِمْ / تَقْدِيرًا أوْ لَفْظًا فَذَا الحَدَّ ذَكَرُ\n\n  - **تفكيك العبارات:** تغيير أواخر الكلم: تغير آخر الكلمة؛ تقديرا أو لفظا: إما مقدرا أو ظاهرا؛ فذا الحد ذكر: فهذا الحد ذكره العلماء.\n\n  - **معنى البيت:** تعريف الإعراب.\n\n- **البيت:** وَذَلِكَ التَّغْيِيرُ لِاضْطِرَابِ / عَوَامِلٍ تَدْخُلُ لِلإِعْرَابِ\n\n  - **تفكيك العبارات:** لاضطراب: لاختلاف؛ عوامل: ما يحدث الإعراب؛ تدخل للإعراب: تدخل لأجل الإعراب.\n\n  - **معنى البيت:** سبب التغير اختلاف العوامل.\n\n- **البيت:** أَقْسَامُهُ أَرْبَعَةٌ فَلْتُعْتَبَرْ / رَفْعٌ وَنَصْبٌ ثُمَّ خَفْضٌ وَجَزَمْ\n\n  - **تفكيك العبارات:** فلتعتبر: فلتعتد ولتحفظ.\n\n  - **معنى البيت:** حصر الأقسام.\n\n- **البيت:** فَالْأَوَّلَانِ دُونَ رَيْبٍ وَقَعَا / فِي الِاسْمِ وَالْفِعْلِ الْمُضَارِعِ مَعَا\n\n  - **تفكيك العبارات:** الأولان: الرفع والنصب؛ دون ريب: دون شك؛ معا: معا فيهما.\n\n  - **معنى البيت:** اشتراك الرفع والنصب.\n\n- **البيت:** وَالِاسْمُ قَدْ خُصِّصَ بِالْجَرِّ كَمَا / قَدْ خُصِّصَ الْفِعْلُ بِجَزْمٍ فَاعْلَمَا\n\n  - **تفكيك العبارات:** خصص بالجر: اختص به؛ فاعلما: فاعلم ذلك.\n\n  - **معنى البيت:** اختصاص الجر بالاسم والجزم بالفعل.\n\n- **البيت:** ضَمٌّ وَوَاوٌ أَلِفٌ وَالنُّونُ / عَلَامَةُ الرَّفْعِ بِهَا تَكُونُ\n\n  - **تفكيك العبارات:** حصر علامات الرفع في أربع.\n\n  - **معنى البيت:** جمع علامات الرفع.\n\n- **البيت:** فَارْفَعْ بِضَمٍّ مُفْرَدَ الأَسْمَاءِ / كَجَاءَ زَيْدٌ صَاحِبُ الْعَلَاءِ\n\n  - **تفكيك العبارات:** مفرد الأسماء: الاسم المفرد؛ صاحب العلاء: صاحب الرفعة.\n\n  - **معنى البيت:** الضمة للمفرد.\n\n- **البيت:** وَارْفَعْ بِهِ الْجَمْعَ الْمُكَسَّرَ وَمَا / جُمِعَ مِنْ تَأْنِيثٍ سَلِمَا\n\n  - **تفكيك العبارات:** ما جمع من تأنيث سلما: جمع المؤنث السالم.\n\n  - **معنى البيت:** الضمة للجمعين.\n\n- **البيت:** كَالمُضَارِعِ الَّذِي لَمْ يَتَّصِلْ / شَيْءٌ بِهِ كَيَهْتَدِي وَكَيَصِلْ\n\n  - **تفكيك العبارات:** لم يتصل شيء به: المجرد؛ يهتدي ويصل: مثالان.\n\n  - **معنى البيت:** الضمة للمضارع المجرد.\n\n- **البيت:** وَارْفَعْ بِوَاوٍ خَمْسَةً أَخُوكَا / أَبُوكَ ذُو مَالٍ حَمُوكَ فُوكَا\n\n  - **تفكيك العبارات:** خمسة: الأسماء الخمسة بأمثلتها.\n\n  - **معنى البيت:** الواو للخمسة.\n\n- **البيت:** وَهَكَذَا الْجَمْعُ الصَّحِيحُ فَاعْرِفِ / وَرَفْعُ مَا ثَنَّيْتَهُ بِالأَلِفِ\n\n  - **تفكيك العبارات:** الجمع الصحيح: السالم؛ ما ثنيته: المثنى؛ فاعرف: فاعرف ذلك.\n\n  - **معنى البيت:** الواو للجمع السالم والألف للمثنى.\n\n- **البيت:** وَارْفَعْ بِنُونٍ يَفْعَلَانِ يَفْعَلُونْ / وَتَفْعَلَانِ تَفْعَلِينَ تَفْعَلُونْ\n\n  - **تفكيك العبارات:** الأفعال الخمسة بأمثلتها.\n\n  - **معنى البيت:** النون للأفعال الخمسة.\n\n## 3. أنواع التغير\n\nالتغير اللفظي كرفع الحج ونصبه وجره بالحركات الظاهرة. والتقديري يكون في المقصور والمنقوص والمضاف إلى ياء المتكلم وفي الأفعال المعتلة. والمحلي يكون في المبنيات كالأسماء الموصولة وأسماء الاستفهام.\n\n\n- **مثال التغير اللفظي:** (زيدٌ/زيداً/زيدٍ) — حركة ظاهرة.\n- **مثال التغير التقديري:** (جاء الفتى) — ضمة مقدرة للتعذر.\n- **مثال التغير المحلي:** (جاء هؤلاءِ) — مبني في محل رفع.\n\n## 4. اختصاص الأقسام\n\nالرفع والنصب يشترك فيهما الاسم والفعل المضارع، والخفض يختص بالأسماء، والجزم يختص بالأفعال المضارعة.\n\n## 5. علامات الرفع إجمالا\n\nللمرفوع أربع علامات: واحدة أصلية وهي الضمة، وثلاث نائبة وهي الواو والألف والنون.\n\n## 6. مواضع الضمة\n\nتكون الضمة علامة للرفع في أربعة مواضع: الاسم المفرد، وجمع التكسير، وجمع المؤنث السالم، والفعل المضارع الذي لم يتصل بآخره شيء، ظاهرا في الصحيح ومقدرا في المعتل.\n\n\n- **مثال الرفع بالضمة:** المفرد (جاء زيدٌ)، جمع التكسير (حضر الرجالُ)، جمع المؤنث السالم (فازت المسلماتُ)، المضارع الصحيح (يكتبُ الطالبُ).\n\n## 7. مواضع الواو والألف والنون\n\nتكون الواو علامة للرفع في موضعين: الأسماء الخمسة بشرط إضافتها لغير ياء المتكلم، وجمع المذكر السالم. وتكون الألف علامة في موضع واحد وهو المثنى. وتكون النون علامة في الأفعال الخمسة، وهي كل مضارع اتصلت به ألف الاثنين أو واو الجماعة أو ياء المخاطبة.\n\n- **مثال الرفع بالواو:** الأسماء الستة (حضر أبوكَ)، جمع المذكر السالم (فاز المسلمونَ).\n- **مثال الرفع بالألف:** المثنى (حضر الزيدانِ).\n- **مثال الرفع بالنون:** الأفعال الخمسة (الطالبان يكتبانِ، أنتِ تكتبينَ).\n","evidences":[{"type":"quran","text":"﴿الْحَجُّ أَشْهُرٌ مَّعْلُومَاتٌ﴾","reference":"سورة البقرة: 197 (الرفع الظاهر)"},{"type":"quran","text":"﴿فَمَن فَرَضَ فِيهِنَّ الْحَجَّ﴾","reference":"سورة البقرة: 197 (النصب الظاهر)"},{"type":"quran","text":"﴿فَلَا رَفَثَ وَلَا فُسُوقَ وَلَا جِدَالَ فِي الْحَجِّ﴾","reference":"سورة البقرة: 197 (الجر الظاهر)"},{"type":"quran","text":"﴿وَتَخْشَى النَّاسَ وَاللَّهُ أَحَقُّ أَن تَخْشَاهُ﴾","reference":"سورة الأحزاب: 37 (الرفع والنصب المقدر)"},{"type":"quran","text":"﴿قُلْ إِنَّ هُدَى اللَّهِ هُوَ الْهُدَى﴾","reference":"سورة البقرة: 120 (التقدير)"},{"type":"quran","text":"﴿لَن يَنَالَ اللَّهَ لُحُومُهَا وَلَا دِمَاؤُهَا﴾","reference":"سورة الحج: 37 (اشتراك الرفع والنصب)"},{"type":"quran","text":"﴿بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ﴾","reference":"سورة الفاتحة: 1 (اختصاص الجر بالاسم)"},{"type":"quran","text":"﴿لَمْ يَلِدْ وَلَمْ يُولَدْ﴾","reference":"سورة الإخلاص: 3 (اختصاص الجزم بالفعل)"},{"type":"quran","text":"﴿اللَّهُ نُورُ السَّمَاوَاتِ﴾","reference":"سورة النور: 35 (الرفع بالضمة)"},{"type":"quran","text":"﴿الرِّجَالُ قَوَّامُونَ عَلَى النِّسَاءِ﴾","reference":"سورة النساء: 34 (جمع التكسير)"},{"type":"quran","text":"﴿فَالصَّالِحَاتُ قَانِتَاتٌ﴾","reference":"سورة النساء: 34 (جمع المؤنث السالم)"},{"type":"quran","text":"﴿وَاللَّهُ يَدْعُو إِلَىٰ دَارِ السَّلَامِ﴾","reference":"سورة يونس: 25 (الضمة المقدرة)"},{"type":"quran","text":"﴿إِنِّي أَنَا أَخُوكَ﴾","reference":"سورة يوسف: 69 (الأسماء الخمسة)"},{"type":"quran","text":"﴿وَكَانَ أَبُوهُمَا صَالِحًا﴾","reference":"سورة الكهف: 82 (الأسماء الخمسة)"},{"type":"quran","text":"﴿بَلْ يَدَاهُ مَبْسُوطَتَانِ﴾","reference":"سورة المائدة: 64 (المثنى)"},{"type":"quran","text":"﴿الَّذِينَ يُؤْمِنُونَ بِالْغَيْبِ﴾","reference":"سورة البقرة: 3 (ثبوت النون)"}],"scholars":[],"benefits":["الإعراب تغيير سببه العوامل.","التغير ثلاثة: لفظي وتقديري ومحلي.","الرفع والنصب مشتركان والخفض والجزم مختصان.","الضمة أصل الرفع في أربعة مواضع.","الواو في موضعين بشرط الإضافة.","النون علامة الأفعال الخمسة."],"terms":[{"term":"التحسين والتبيين","definition":"معنى الإعراب في اللغة."},{"term":"التقديري","definition":"إعراب منع من ظهوره مانع كالتعذر والثقل."},{"term":"المحلي","definition":"إعراب المبنيات في محل."},{"term":"العلامة الأصلية","definition":"الضمة في الرفع."},{"term":"الأسماء الخمسة","definition":"أبوك وأخوك وحموك وفوك وذو."}],"mindMap":{"title":"الإعراب والرفع","branches":[{"title":"الإعراب","items":["التعريف","لفظي وتقديري ومحلي","الاختصاص"]},{"title":"الضمة","items":["المفرد","جمع التكسير","جمع المؤنث","المضارع المجرد"]},{"title":"النواب","items":["الواو في موضعين","الألف للمثنى","النون للخمسة"]}]},"summaryTable":{"headers":["العلامة","مواضعها","شاهدها"],"rows":[["الضمة","أربعة مواضع","الله نور السماوات"],["الواو","الخمسة والجمع الصحيح","إني أنا أخوك"],["الألف","المثنى","بل يداه مبسوطتان"],["النون","الأفعال الخمسة","الذين يؤمنون بالغيب"]]},"video":{"url":"https://www.youtube.com/watch?v=Th2QJvWF5Cw","title":"شرح نظم الآجرومية // 02 // الشيخ محمد محمود الشنقيطي"}},"questions":[{"q":"ما معنى الإعراب لغة؟","options":["البناء واللزوم","الحفظ والتكرار","الجر والخفض","التحسين والتبيين"],"answer":3},{"q":"كم أنواع التغير في الإعراب؟","options":["اثنان","ثلاثة","أربعة","خمسة"],"answer":0},{"q":"أين يكون التغير المحلي؟","options":["في المعربات","في المبنيات","في الحروف","في الأفعال فقط"],"answer":1},{"q":"ما الذي يختص به الاسم؟","options":["الجزم","النصب وحده","الجر","الرفع وحده"],"answer":2},{"q":"كم مواضع الرفع بالضمة؟","options":["ثلاثة","أربعة","خمسة","ستة"],"answer":0},{"q":"بشرط ماذا ترفع الأسماء الخمسة بالواو؟","options":["إفرادها","إضافتها لغير ياء المتكلم","تنوينها","تعريفها بأل"],"answer":1}]},{"id":"ajr-03","order":4,"title":"الدرس 03: علامات النصب والخفض والجزم","chapter":"النصب والخفض والجزم","summary":"علامات النصب الخمس بشواهدها، وعلامات الخفض الثلاث بشواهدها، وعلامتا الجزم مع حذف حرف العلة بأنواعه وحذف النون.","content":{"objectives":["أن يعدد الطالب علامات النصب الخمس ومواضع كل علامة.","أن يعدد علامات الخفض الثلاث ومواضع كل علامة.","أن يبين علامتي الجزم ومواضعهما.","أن يستشهد لكل علامة بشاهد قرآني."],"matn":"عَلَامَةُ النَّصْبِ لَهَا كُنْ مُحْصِيَا ۞ الْفَتْحَ وَالْكَسْرَ وَاحْذِفْ نُونِيَا\nفَالَّذِي الْفَتْحُ بِهِ عَلَامَةْ ۞ يَا ذَا النُّهَى نَصْبًا بكسرِ الْجُمُوعْ\nثُمَّ الْمُفْرَدُ وَمِنْ مُضَارِعٍ الَّذِي تَسَعَّدْ ۞ بِالأَلِفِ الْخَمْسَةَ نَصْبَهَا الْتَزِمْ\nوَانْصِبْ بِكَسْرٍ جَمْعَ تَأْنِيثٍ سَلِمْ ۞ وَاعْلَمْ بِأَنَّ الْجَمْعَ وَالْمُثَنَّى\nنَصْبُهُمَا بِالْيَاءِ حَيْثُ عَنَّا ۞ وَخَمْسَةُ الأَفْعَالِ نَصْبُهَا حَذَفْ\nنُونَهُمَا إِذَا مَا نَصَبْتَ ۞ عَلَامَةُ الْخَفْضِ الَّتِي بِهَا فُيِا\nكَسْرٌ وَيَاءٌ ثُمَّ فَتْحٌ فَاقْتُفِي ۞ فَاخْفِضْ بِكَسْرٍ مُفْرَدًا وَمَا انْصَرَفْ\nوَجَمْعَ تَكْسِيرٍ إِذَا مَا انْصَرَفْ ۞ وَجَمْعَ تَأْنِيثٍ سَلِمْ\nوَبِالْيَا اخْفِضِ الْجَمْعَ وَالْخَمْسَةَ تَعْرِفْ ۞ وَاخْفِضْ بِفَتْحٍ كُلَّ مَا لَا يَنْصَرِفْ\nوَلِلَّذِي جُزِمَ السُّكُونُ وَالْحَذْفُ ۞ عَلَامَتَانِ\nفَفِي تَسْكِينِ الْمُضَارِعِ نَأْتِي صَحِيحَ الآخِرِ ۞ كَمَا لَمْ يَكُنْ فِي الذَّاكِرِينَ\nوَاجْزِمْ بِحَذْفِ مَا اخْتَلَفْ ۞ وَالْخَمْسَةَ الأَفْعَالِ","briefExplanation":"علامات النصب خمس: الفتحة والألف والكسرة والياء وحذف النون. وعلامات الخفض ثلاث: الكسرة والياء والفتحة. وعلامتا الجزم: السكون للحروف الصحيحة والحذف للمعتلة والخمسة. ويعرض الدرس كل علامة بشواهدها القرآنية كما وردت في الشرح.","detailedExplanation":"## 1. علامات النصب\n\nعلامات النصب خمس: الفتحة والألف والكسرة والياء وحذف النون.\n\n## 2. ألفاظ أبيات الدرس بيتاً بيتاً\n> منهج هذا الدرس: نبدأ بألفاظ الأبيات بيتاً بيتاً، ثم نبسط معناها العام وقواعدها.\n\n\nفي هذا القسم نفكك كلمات كل بيت وعباراته أولا، ثم نذكر معناه إجمالا، على لفظ الشرح.\n\n- **البيت:** عَلَامَةُ النَّصْبِ لَهَا كُنْ مُحْصِيَا / الْفَتْحَ وَالْكَسْرَ وَاحْذِفْ نُونِيَا\n\n  - **تفكيك العبارات:** كن محصيا: كن حاصرا عادا.\n\n  - **معنى البيت:** حصر علامات النصب.\n\n- **البيت:** فَالَّذِي الْفَتْحُ بِهِ عَلَامَةْ / يَا ذَا النُّهَى نَصْبًا\n\n  - **تفكيك العبارات:** يا ذا النهى: يا صاحب العقل.\n\n  - **معنى البيت:** الفتح علامة النصب.\n\n- **البيت:** ثُمَّ الْمُفْرَدُ وَمِنْ مُضَارِعٍ الَّذِي تَسَعَّدْ\n\n  - **تفكيك العبارات:** المفرد: الاسم المفرد؛ الذي تسعد: المضارع مثالا.\n\n  - **معنى البيت:** من مواضع الفتحة.\n\n- **البيت:** بِالأَلِفِ الْخَمْسَةَ نَصْبَهَا الْتَزِمْ / وَانْصِبْ بِكَسْرٍ جَمْعَ تَأْنِيثٍ سَلِمْ\n\n  - **تفكيك العبارات:** التزم: الزم؛ سلم: السالم.\n\n  - **معنى البيت:** الألف للخمسة والكسرة لجمع المؤنث.\n\n- **البيت:** وَاعْلَمْ بِأَنَّ الْجَمْعَ وَالْمُثَنَّى / نَصْبُهُمَا بِالْيَاءِ حَيْثُ عَنَّا\n\n  - **تفكيك العبارات:** حيث عنا: حيث عرضا ووجدا.\n\n  - **معنى البيت:** الياء للمثنى والجمع.\n\n- **البيت:** وَخَمْسَةُ الأَفْعَالِ نَصْبُهَا حَذَفْ / نُونَهُمَا إِذَا مَا نَصَبْتَ\n\n  - **تفكيك العبارات:** حذف: بحذف النون؛ إذا ما نصبت: إذا نصبتها بناصب.\n\n  - **معنى البيت:** حذف النون للخمسة.\n\n- **البيت:** عَلَامَةُ الْخَفْضِ الَّتِي بِهَا فُيِا / كَسْرٌ وَيَاءٌ ثُمَّ فَتْحٌ فَاقْتُفِي\n\n  - **تفكيك العبارات:** بها الوفاء والكفاية؛ فاقتفي: فاتبعها.\n\n  - **معنى البيت:** حصر علامات الخفض.\n\n- **البيت:** فَاخْفِضْ بِكَسْرٍ مُفْرَدًا وَمَا انْصَرَفْ / وَجَمْعَ تَكْسِيرٍ إِذَا مَا انْصَرَفْ\n\n  - **تفكيك العبارات:** ما انصرف: المنصرف أي المنون.\n\n  - **معنى البيت:** الكسرة للمفرد والجمع المنصرفين.\n\n- **البيت:** وَجَمْعَ تَأْنِيثٍ سَلِمْ\n\n  - **تفكيك العبارات:** تتمة لما قبلها.\n\n  - **معنى البيت:** الكسرة لجمع المؤنث السالم.\n\n- **البيت:** وَبِالْيَا اخْفِضِ الْجَمْعَ وَالْخَمْسَةَ تَعْرِفْ\n\n  - **تفكيك العبارات:** تعرف: تعرف ذلك.\n\n  - **معنى البيت:** الياء للجمع والخمسة.\n\n- **البيت:** وَاخْفِضْ بِفَتْحٍ كُلَّ مَا لَا يَنْصَرِفْ\n\n  - **تفكيك العبارات:** ما لا ينصرف: الممنوع من الصرف.\n\n  - **معنى البيت:** الفتحة للممنوع من الصرف.\n\n- **البيت:** وَلِلَّذِي جُزِمَ السُّكُونُ وَالْحَذْفُ / عَلَامَتَانِ\n\n  - **تفكيك العبارات:** للذي جزم: للفعل المجزوم.\n\n  - **معنى البيت:** حصر علامتي الجزم.\n\n- **البيت:** فَفِي تَسْكِينِ الْمُضَارِعِ نَأْتِي صَحِيحَ الآخِرِ\n\n  - **تفكيك العبارات:** تسكين المضارع: جزمه بالسكون؛ صحيح الآخر: السالم آخره.\n\n  - **معنى البيت:** السكون للصحيح.\n\n- **البيت:** وَاجْزِمْ بِحَذْفِ مَا اخْتَلَفْ / وَالْخَمْسَةَ الأَفْعَالِ\n\n  - **تفكيك العبارات:** ما اختلف: ما تغير عن أصله وهو حرف العلة.\n\n  - **معنى البيت:** الحذف للمعتل والخمسة.\n\n## 3. مواضع الفتحة\n\nينصب بالفتحة: جمع التكسير ويشمل اسم الجمع كقوم ورهط واسم الجنس الجمعي كشجر وثمر، والاسم المفرد، والفعل المضارع الذي لم يتصل بآخره شيء أي الذي ليس من الأفعال الخمسة.\n\n\n- **مثال النصب بالفتحة:** المفرد (رأيتُ زيداً)، جمع التكسير (أكرمتُ الرجالَ)، المضارع (لن يكتبَ).\n\n## 4. الألف والكسرة والياء والحذف\n\nينصب بالألف الأسماء الخمسة فقط. وتنصب بالكسرة جمع المؤنث السالم وحده. وتنصب بالياء المثنى وجمع المذكر السالم. وتنصب الأفعال الخمسة بحذف النون، وهي كل مضارع اتصلت به واو الجماعة أو ألف الاثنين أو ياء المخاطبة.\n\n\n- **مثال النصب بالألف:** الأسماء الستة (رأيتُ أباكَ).\n- **مثال النصب بالكسرة:** جمع المؤنث السالم (رأيتُ المسلماتِ).\n- **مثال النصب بالياء:** المثنى (رأيتُ الزيدينِ) والجمع (رأيتُ المسلمينَ).\n- **مثال النصب بحذف النون:** (لن يكتبوا الدرسَ).\n\n## 5. شواهد اجتماع الإعراب\n\nيجتمع الرفع والنصب والجر في المثنى وجمع المذكر السالم والأفعال الخمسة، فيحسن بالطالب تتبع الكلمة الواحدة في أحوالها الثلاثة.\n\n## 6. علامات الخفض\n\nللخفض ثلاث علامات: الكسرة والياء والفتحة. فالكسرة للاسم المفرد المنصرف وجمع التكسير المنصرف وجمع المؤنث السالم. والياء للمثنى وجمع المذكر السالم والأسماء الخمسة. والفتحة للممنوع من الصرف مفردا كان أو جمعا كصيغة منتهى الجموع.\n\n\n- **مثال الخفض بالكسرة:** المفرد المنصرف (مررتُ بزيدٍ) وجمع التكسير المنصرف (بمساجدٍ... بل بمساجدَ ممنوع) — (مررتُ برجالٍ كرامٍ).\n- **مثال الخفض بالياء:** (مررتُ بأبيكَ وبالمسلمينَ).\n- **مثال الخفض بالفتحة:** الممنوع من الصرف (صليتُ في مساجدَ كثيرةٍ).\n\n## 7. علامتا الجزم\n\nللجزم علامتان: السكون وهي الأصل في الفعل المضارع صحيح الآخر، والحذف وينوب عنها. والحذف نوعان: حذف حرف العلة في المعتل الآخر بأنواعه الثلاثة، وحذف النون في الأفعال الخمسة.\n\n- **مثال الجزم بالسكون:** (لم يكتبْ زيدٌ).\n- **مثال الجزم بالحذف:** حرف العلة (لم يرمِ)، والنون (لم يكتبوا).\n","evidences":[{"type":"quran","text":"﴿وَلَا تُؤْتُوا السُّفَهَاءَ أَمْوَالَكُمُ﴾","reference":"سورة النساء: 5 (الفتحة لجمع التكسير)"},{"type":"quran","text":"﴿ذَٰلِكَ بِأَنَّ اللَّهَ هُوَ الْحَقُّ﴾","reference":"سورة الحج: 6 (الفتحة للمفرد)"},{"type":"quran","text":"﴿لَن نُّؤْمِنَ لَكَ حَتَّىٰ تَفْجُرَ لَنَا مِنَ الْأَرْضِ يَنبُوعًا﴾","reference":"سورة الإسراء: 90 (الفتحة للمضارع)"},{"type":"quran","text":"﴿قَالُوا يَا أَبَانَا اسْتَغْفِرْ لَنَا﴾","reference":"سورة يوسف: 97 (الألف للخمسة)"},{"type":"quran","text":"﴿لِيَبْلُغَ فَاهُ﴾","reference":"سورة الرعد: 14 (الألف للخمسة)"},{"type":"quran","text":"﴿مُسْلِمَاتٍ مُؤْمِنَاتٍ قَانِتَاتٍ﴾","reference":"سورة التحريم: 5 (الكسرة لجمع المؤنث)"},{"type":"quran","text":"﴿لَا تَتَّخِذُوا إِلَٰهَيْنِ اثْنَيْنِ﴾","reference":"سورة النحل: 51 (الياء للمثنى)"},{"type":"quran","text":"﴿إِنَّ الْمُسْلِمِينَ وَالْمُسْلِمَاتِ﴾","reference":"سورة الأحزاب: 35 (الياء للجمع)"},{"type":"quran","text":"﴿لَّا يَتَّخِذِ الْمُؤْمِنُونَ الْكَافِرِينَ أَوْلِيَاءَ﴾","reference":"سورة آل عمران: 28 (اجتماع الرفع والنصب والجر)"},{"type":"quran","text":"﴿وَلَن تَسْتَطِيعُوا أَن تَعْدِلُوا﴾","reference":"سورة النساء: 129 (حذف النون)"},{"type":"quran","text":"﴿وَيُحِبُّونَ أَن يُحْمَدُوا بِمَا لَمْ يَفْعَلُوا﴾","reference":"سورة آل عمران: 188 (اجتماع أحوال الخمسة)"},{"type":"quran","text":"﴿بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ﴾","reference":"سورة الفاتحة: 1 (الكسرة للمفرد)"},{"type":"quran","text":"﴿وَقُل لِّلْمُؤْمِنَاتِ يَغْضُضْنَ مِنْ أَبْصَارِهِنَّ﴾","reference":"سورة النور: 31 (الكسرة لجمع المؤنث)"},{"type":"quran","text":"﴿فَبَدَأَ بِأَوْعِيَتِهِمْ قَبْلَ وِعَاءِ أَخِيهِ﴾","reference":"سورة يوسف: 76 (الياء للخمسة)"},{"type":"quran","text":"﴿هَلْ فِي ذَٰلِكَ قَسَمٌ لِّذِي حِجْرٍ﴾","reference":"سورة الفجر: 5 (الياء للخمسة)"},{"type":"quran","text":"﴿وَأَوْحَيْنَا إِلَىٰ إِبْرَاهِيمَ وَإِسْمَاعِيلَ﴾","reference":"سورة النساء: 163 (الفتحة للممنوع)"},{"type":"quran","text":"﴿مِن مَّحَارِيبَ وَتَمَاثِيلَ﴾","reference":"سورة سبأ: 13 (الفتحة لمنتهى الجموع)"},{"type":"quran","text":"﴿لَمْ يَلِدْ وَلَمْ يُولَدْ﴾","reference":"سورة الإخلاص: 3 (السكون)"},{"type":"quran","text":"﴿سَنَدْعُ الزَّبَانِيَةَ﴾","reference":"سورة العلق: 18 (حذف الواو)"},{"type":"quran","text":"﴿وَإِن تَشْكُرُوا يَرْضَهُ لَكُمْ﴾","reference":"سورة الزمر: 7 (حذف الألف)"},{"type":"quran","text":"﴿وَلَا تُصَلِّ عَلَىٰ أَحَدٍ مِّنْهُم﴾","reference":"سورة التوبة: 84 (حذف الياء)"},{"type":"quran","text":"﴿فَإِن لَّمْ تَفْعَلُوا﴾","reference":"سورة البقرة: 24 (حذف النون)"},{"type":"quran","text":"﴿وَلَا تَخَافِي وَلَا تَحْزَنِي﴾","reference":"سورة القصص: 7 (حذف النون)"},{"type":"quran","text":"﴿إِن يُرِدْنِ الرَّحْمَٰنُ بِضُرٍّ لَّا تُغْنِ عَنِّي شَفَاعَتُهُمْ شَيْئًا وَلَا يُنقِذُونِ﴾","reference":"سورة يس: 23 (اجتماع السكون والحذف)"}],"scholars":[],"benefits":["الفتحة تشمل جمع التكسير واسم الجمع واسم الجنس.","الألف خاصة بالأسماء الخمسة.","الكسرة خاصة بجمع المؤنث السالم.","تتبع الكلمة في أحوالها يثبت العلامات.","الخفض بالفتحة للممنوع من الصرف.","الحذف نوعان: حرف العلة والنون."],"terms":[{"term":"اسم الجمع","definition":"ما دل على جماعة وليس له مفرد من لفظه كقوم ورهط."},{"term":"اسم الجنس الجمعي","definition":"ما دل على الجنس ويفرق بينه وبين واحده بالتاء كشجر وشجرة."},{"term":"الممنوع من الصرف","definition":"اسم يجر بالفتحة نيابة عن الكسرة."},{"term":"حذف حرف العلة","definition":"علامة جزم المعتل الآخر."}],"mindMap":{"title":"النصب والخفض والجزم","branches":[{"title":"النصب","items":["الفتحة","الألف","الكسرة","الياء","حذف النون"]},{"title":"الخفض","items":["الكسرة","الياء","الفتحة"]},{"title":"الجزم","items":["السكون","حذف العلة","حذف النون"]}]},"summaryTable":{"headers":["الباب","العلامات","مثال"],"rows":[["النصب","خمس علامات","لن نؤمن لك"],["الخفض","ثلاث علامات","بسم الله"],["الجزم","السكون والحذف","لم يلد"]]},"video":{"url":"https://www.youtube.com/watch?v=uKZuUnbFT0A","title":"شرح نظم الآجرومية // 03 // الشيخ محمد محمود الشنقيطي"}},"questions":[{"q":"كم علامات النصب؟","options":["خمس","ست","ثلاث","أربع"],"answer":3},{"q":"ما الذي يشمله النصب بالفتحة مع جمع التكسير؟","options":["اسم الجمع واسم الجنس الجمعي","المثنى","جمع المؤنث","الأفعال الخمسة"],"answer":0},{"q":"بم ينصب جمع المؤنث السالم؟","options":["بالفتحة","بالكسرة","بالألف","بالياء"],"answer":1},{"q":"بم يخفض الممنوع من الصرف؟","options":["بالكسرة","بالياء","بالفتحة","بالسكون"],"answer":2},{"q":"ما نوعا الحذف في الجزم؟","options":["حرف العلة والنون","الحرف الأول والأخير","الحركة والسكون","الألف واللام"],"answer":0},{"q":"أي شاهد يجمع السكون وحذف العلة وحذف النون؟","options":["آية الكرسي","آية يس 23","سورة الإخلاص","سورة الفاتحة"],"answer":1}]},{"id":"ajr-04","order":5,"title":"الدرس 04: الأفعال والنواصب","chapter":"الأفعال والنواصب","summary":"أقسام الأفعال وأحكامها بالتفصيل، ثم نواصب المضارع بقسميها مع الشواهد.","content":{"objectives":["أن يبين الطالب زمن كل فعل وحكمه البنائي.","أن يشرح حالات الفتح المقدر في الماضي.","أن يميز مذهبي الكوفيين والبصريين في الأمر.","أن يعدد النواصب بقسميها مع الشواهد."],"matn":"وَهِيَ ثَلَاثَةٌ مَضَى وَفِعْلٌ مُضَارِعٌ ۞ وَأَمْرٌ كَتَلَا\nفَالْمَاضِي مَفْتُوحُ الأَخِيرِ أَبَدًا ۞ وَالأَمْرُ بِالْجَزْمِ لَدَى بَعْضٍ ارْتَدَى\nثُمَّ الْمُضَارِعُ الَّذِي فِي صَدْرِهِ ۞ إِحْدَى زَوَائِدِ أَنَيْتُ فَادْرِهِ\nحُكْمُهُ الرَّفْعُ إِذَا يُجَرَّدُ ۞ مِنْ نَاصِبٍ وَجَازِمٍ كَتَسْعَدُ\nوَنَصْبُهُ بِأَنْ وَلَنْ إِذَنْ وَكَيْ ۞ وَلاَمِ كَيْ لاَمِ جَحْدٍ يَا أُخَيّ\nكَذَاكَ حَتَّى وَالْجَوَابُ بِالْفَاءِ ۞ وَالْوَاوِ ثُمَّ أَوْ وَقَفِّ الأَثَرَا","briefExplanation":"الأفعال ثلاثة: ماض مفتوح الآخر أبدا ظاهرا أو مقدرا، وأمر على ما يجزم به مضارعه عند البصريين، ومضارع مرفوع إذا تجرد. والنواصب قسمان: ما ينصب بنفسه باتفاق، وما ينصب بأن مضمرة بعده عند البصريين.","detailedExplanation":"## 1. أقسام الأفعال\n\nقسم الناظم الأفعال إلى الماضي والأمر والمضارع. فالماضي يدل على الزمن الماضي غالبا، والأمر لا يكون إلا للمستقبل لأنه طلب، والطلب حصول ما لم يحصل.\n\n## 2. ألفاظ أبيات الدرس بيتاً بيتاً\n> منهج هذا الدرس: نبدأ بألفاظ الأبيات بيتاً بيتاً، ثم نبسط معناها العام وقواعدها.\n\n\nفي هذا القسم نفكك كلمات كل بيت وعباراته أولا، ثم نذكر معناه إجمالا.\n\n- **البيت:** وَهِيَ ثَلَاثَةٌ مَضَى وَفِعْلٌ مُضَارِعٌ / وَأَمْرٌ كَتَلَا\n\n  - **تفكيك العبارات:** هي: الأفعال؛ مضى: الماضي؛ كتلا: ومثال الأمر اتل.\n\n  - **معنى البيت:** حصر الأفعال في ثلاثة.\n\n- **البيت:** فَالْمَاضِي مَفْتُوحُ الأَخِيرِ أَبَدًا\n\n  - **تفكيك العبارات:** مفتوح الأخير: آخره مفتوح؛ أبدا: دائما ظاهرا أو مقدرا.\n\n  - **معنى البيت:** حكم الماضي.\n\n- **البيت:** وَالأَمْرُ بِالْجَزْمِ لَدَى بَعْضٍ ارْتَدَى\n\n  - **تفكيك العبارات:** بالجزم: مبني على ما يجزم به مضارعه؛ لدى بعض: عند بعض النحاة وهم الكوفيون؛ ارتدى: رجع وذهب.\n\n  - **معنى البيت:** مذهب الكوفيين في الأمر.\n\n- **البيت:** ثُمَّ الْمُضَارِعُ الَّذِي فِي صَدْرِهِ / إِحْدَى زَوَائِدِ أَنَيْتُ فَادْرِهِ\n\n  - **تفكيك العبارات:** في صدره: في أوله؛ أنيت: أحرف المضارعة؛ فادره: فاعرفه.\n\n  - **معنى البيت:** علامة المضارع.\n\n- **البيت:** حُكْمُهُ الرَّفْعُ إِذَا يُجَرَّدُ / مِنْ نَاصِبٍ وَجَازِمٍ كَتَسْعَدُ\n\n  - **تفكيك العبارات:** يجرد: يخلّى؛ تسعد: مثال للمرفوع.\n\n  - **معنى البيت:** حكم المضارع عند التجرد.\n\n- **البيت:** وَنَصْبُهُ بِأَنْ وَلَنْ إِذَنْ وَكَيْ / وَلاَمِ كَيْ لاَمِ جَحْدٍ يَا أُخَيّ\n\n  - **تفكيك العبارات:** يا أخي: بتصغير التحبب؛ لام الجحد: لام الجحود.\n\n  - **معنى البيت:** النواصب بالأصالة.\n\n- **البيت:** كَذَاكَ حَتَّى وَالْجَوَابُ بِالْفَاءِ / وَالْوَاوِ ثُمَّ أَوْ وَقَفِّ الأَثَرَا\n\n  - **تفكيك العبارات:** الجواب بالفاء: فاء الجواب؛ وقف الأثر: اتبع أثر العلماء.\n\n  - **معنى البيت:** بقية النواصب.\n\n## 3. الفعل الماضي\n\nالماضي مفتوح الآخر أبدا سواء كان الفتح ظاهرا أو مقدرا. ويقدر الفتح إذا اتصلت به واو الجماعة لاشتغال المحل بحركة المناسبة، ويسكن آخره مع ضمائر الرفع المتحركة كراهة توالي أربعة متحركات فيما هو كالكلمة الواحدة.\n\n\n- **مثال الماضي:** (كتبَ زيدٌ الدرسَ) — مفتوح الآخر أبداً.\n\n## 4. فعل الأمر\n\nالأمر طلب ما لم يحصل أو طلب دوام ما حصل أو طلب زيادته. ومذهب الكوفيين أنه مجزوم مقتطع من المضارع، ومذهب البصريين وهو الراجح أنه مبني على ما يجزم به مضارعه: على السكون للصحيح، وعلى حذف حرف العلة للمعتل، وعلى حذف النون للخمسة.\n\n\n- **مثال الأمر:** (اكتبْ درسَكَ) — مبني على الجزم عند البصريين.\n\n## 5. الفعل المضارع\n\nعلامته افتتاحه بأحد أحرف المضارعة الأربعة المجموعة في أنيت أو نأتي. وحكمه الرفع إذا تجرد من الناصب والجازم ولم تتصل به نون التوكيد ولا نون النسوة.\n\n\n- **مثال المضارع:** (يكتبُ، تكتبُ، أكتبُ، نكتبُ) — الزوائد (أنيت).\n\n## 6. النواصب بالأصالة\n\nما ينصب بنفسه باتفاق: أن المصدرية ولن وإذن بشرط تصدر الجواب والاستقبال وعدم الفصل إلا بالقسم وكي المصدرية.\n\n\n- **مثال أن:** (أريدُ أن أتعلمَ النحوَ).\n- **مثال لن:** (لن أهملَ دروسي).\n- **مثال إذن:** (إذن تنجحَ) جواباً لمن قال: سأجتهد.\n- **مثال كي:** (جئتُ كي أتعلمَ).\n\n## 7. النواصب بأن مضمرة\n\nعند البصريين تنصب هذه الأدوات بأن مضمرة بعدها، وعند الكوفيين تنصب بنفسها: لام كي ولام الجحود الواقعة بعد كون منفي، وحتى للاستقبال، وفاء السببية في جواب النفي والطلب، وواو المعية في جوابهما، وأو بمعنى إلى أو إلا.\n\n---\n\n[مطابقة الأبيات للشرح من المجلس المرئي]\n١- أبيات أقسام الفعل (وهي ثلاثة مضى وفعل مضارع وأمر كتلا): الفعل ثلاثة لا رابع لها؛ الماضي مفتوح الآخر أبداً (كتبَ)، والأمر مبني على الجزم عند البصريين (اكتبْ)، والمضارع مبدوء بإحدى زوائد (أنيت): الهمزة والنون والياء والتاء (أكتبُ، نكتبُ، يكتبُ، تكتبُ).\n٢- بيت حكم الرفع (حكمه الرفع إذا يجرد من ناصب وجازم كتسعد): يرفع المضارع بالتجرد، وهو عامل معنوي — فقولك (تسعدُ) مرفوع لتجرده.\n٣- بيت النواصب (ونصبه بأن ولن إذن وكي ولام كي لام جحد يا أخي): النواصب عشرة جمعها البيت: أن ولن وإذن وكي ولام التعليل (لام كي) ولام الجحود المسبوقة بكون منفي، (كذاك حتى والجواب بالفاء والواو ثم أو): حتى الغائية، وفاء السببية وواو المعية المسبوقتين بنفي أو طلب، وأو بمعنى إلى أن.\n٤- علامات النصب من الشرح: الفتحة الظاهرة ﴿لَن تَنَالُوا﴾ بحذف النون في الخمسة، وتقدر على الألف للتعذر (لن يرضى).\n٥- أخطاء شائعة: نصب المضارع بلا ناصب، والخلط بين لام التعليل ولام الجحود، وإهمال شرط النفي أو الطلب قبل الفاء والواو.\n\n- **مثال لام التعليل:** (جئتُ لأتعلمَ).\n- **مثال لام الجحود:** (ما كان اللهُ ليظلمَ أحداً).\n- **مثال حتى:** (انتظرتُ حتى يحضرَ الإمامُ).\n- **مثال فاء السببية:** (اجتهدْ فتنجحَ).\n- **مثال واو المعية:** (لا تنهَ عن خلقٍ وتفعلَ مثلَه).\n- **مثال أو:** (لأصبرنَّ أو أنالَ مرادي).\n","evidences":[{"type":"quran","text":"﴿مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ﴾","reference":"سورة الضحى: 3 (الفتح الظاهر والمقدر)"},{"type":"quran","text":"﴿إِن كُنتُ قُلْتُهُ فَقَدْ عَلِمْتَهُ﴾","reference":"سورة المائدة: 116 (تاء الفاعل)"},{"type":"quran","text":"﴿فَلَمَّا رَأَيْنَهُ أَكْبَرْنَهُ وَقَطَّعْنَ أَيْدِيَهُنَّ﴾","reference":"سورة يوسف: 31 (نون النسوة)"},{"type":"quran","text":"﴿يَا أَيُّهَا الْمُدَّثِّرُ قُمْ فَأَنذِرْ﴾","reference":"سورة المدثر: 1-2 (طلب ما لم يحصل)"},{"type":"quran","text":"﴿يَا أَيُّهَا النَّبِيُّ اتَّقِ اللَّهَ﴾","reference":"سورة الأحزاب: 1 (طلب الدوام)"},{"type":"quran","text":"﴿لَا تَقُمْ فِيهِ أَبَدًا﴾","reference":"سورة التوبة: 108 (الأمر من الصحيح)"},{"type":"quran","text":"﴿وَافْعَلُوا الْخَيْرَ﴾","reference":"سورة الحج: 77 (الأمر من الخمسة)"},{"type":"quran","text":"﴿نَحْنُ نَقُصُّ عَلَيْكَ﴾","reference":"سورة يوسف: 3 (نون المضارعة)"},{"type":"quran","text":"﴿وَأَن تَصُومُوا خَيْرٌ لَّكُمْ﴾","reference":"سورة البقرة: 184 (أن المصدرية)"},{"type":"quran","text":"﴿لَن نَّبْرَحَ عَلَيْهِ عَاكِفِينَ﴾","reference":"سورة طه: 91 (لن)"},{"type":"quran","text":"﴿لِّكَيْلَا تَأْسَوْا عَلَىٰ مَا فَاتَكُمْ﴾","reference":"سورة الحديد: 23 (كي)"},{"type":"quran","text":"﴿لَّمْ يَكُنِ اللَّهُ لِيَغْفِرَ لَهُمْ﴾","reference":"سورة النساء: 137 (لام الجحود)"},{"type":"quran","text":"﴿حَتَّىٰ يَرْجِعَ إِلَيْنَا مُوسَىٰ﴾","reference":"سورة طه: 91 (حتى)"},{"type":"quran","text":"﴿لَا يُقْضَىٰ عَلَيْهِمْ فَيَمُوتُوا﴾","reference":"سورة فاطر: 36 (فاء الجواب)"},{"type":"quran","text":"﴿وَلَا تَرْكَنُوا إِلَى الَّذِينَ ظَلَمُوا فَتَمَسَّكُمُ النَّارُ﴾","reference":"سورة هود: 113 (فاء الجواب)"},{"type":"quran","text":"﴿يَا لَيْتَنِي كُنتُ مَعَهُمْ فَأَفُوزَ فَوْزًا عَظِيمًا﴾","reference":"سورة النساء: 73 (فاء التمني)"},{"type":"quran","text":"﴿وَلَمَّا يَعْلَمِ اللَّهُ الَّذِينَ جَاهَدُوا مِنكُمْ وَيَعْلَمَ الصَّابِرِينَ﴾","reference":"سورة آل عمران: 142 (واو المعية)"}],"scholars":[],"benefits":["الماضي مفتوح أبدا ظاهرا أو مقدرا.","الأمر عند البصريين على ما يجزم به مضارعه.","زوائد المضارعة مجموعة في أنيت.","إذن تنصب بثلاثة شروط.","لام الجحود بعد كون منفي.","الفاء والواو في جواب النفي والطلب."],"terms":[{"term":"كراهة التوالي","definition":"علة تسكين آخر الماضي مع ضمائر الرفع."},{"term":"حركة المناسبة","definition":"الضمة التي تمنع ظهور الفتحة مع واو الجماعة."},{"term":"لام الجحود","definition":"لام تأتي بعد كون منفي لنصب المضارع."},{"term":"فاء السببية","definition":"فاء تنصب المضارع في جواب النفي أو الطلب."}],"mindMap":{"title":"الأفعال والنواصب","branches":[{"title":"الأفعال","items":["الماضي","الأمر","المضارع"]},{"title":"النواصب بالأصالة","items":["أن","لن","إذن","كي"]},{"title":"النواصب بغيرها","items":["لام كي","لام الجحود","حتى","الفاء والواو وأو"]}]},"summaryTable":{"headers":["الفعل","حكمه","شاهده"],"rows":[["الماضي","الفتح ظاهرا أو مقدرا","ما ودعك ربك وما قلى"],["الأمر","على ما يجزم به مضارعه","قم وصل وافعلوا"],["المضارع","الرفع عند التجرد","نحن نقص عليك"]]},"video":{"url":"https://www.youtube.com/watch?v=E4RImgZCvrk","title":"شرح نظم الآجرومية // 04 // الشيخ محمد محمود الشنقيطي"}},"questions":[{"q":"ما حكم الماضي؟","options":["مرفوع دائما","مجزوم دائما","منصوب دائما","مفتوح الآخر أبدا"],"answer":3},{"q":"لم يسكن آخر الماضي مع تاء الفاعل؟","options":["كراهة توالي أربعة متحركات","لعدم وجود فاعل","لأنه أمر","لأنه مضارع"],"answer":0},{"q":"ما الراجح في بناء الأمر؟","options":["على الفتح دائما","على ما يجزم به مضارعه","على الكسر دائما","معرب مرفوع"],"answer":1},{"q":"ما أحرف المضارعة؟","options":["سوف","قد","أنيت","هل"],"answer":2},{"q":"ما شروط عمل إذن؟","options":["التصدر والاستقبال وعدم الفصل","التصدر فقط","الاستقبال فقط","لا شروط لها"],"answer":0},{"q":"أين تقع لام الجحود؟","options":["بعد الإثبات","بعد كون منفي","في أول الكلام","بعد حرف الجر"],"answer":1}]},{"id":"ajr-05","order":6,"title":"الدرس 05: الجوازم والفاعل ونائبه","chapter":"الجوازم والفاعل","summary":"جوازم المضارع بقسميها، وتعريف الفاعل وأنواعه، وأسباب حذف الفاعل وأحكام نائبه.","content":{"objectives":["أن يفرق الطالب بين لم ولما.","أن يعدد أدوات الشرط ومعانيها.","أن يعرف الفاعل وأنواعه.","أن يبين أسباب الحذف وأحكام النائب."],"matn":"وَجَزْمُهُ إِذَا أَرَدْتَ الْجَزْمَا ۞ بِلَمْ وَلَمَّا وَأَلَمْ أَلَمَّا\nوَلاَمِ الأَمْرِ وَالدُّعَاءِ فَاكْتَفِ ۞ ثُمَّ لاَ فِي النَّهْيِ وَالدُّعَاءِ فَاقْتُفِي\nوَإِنْ وَمَا وَمَنْ وَأَنَّى مَهْمَا ۞ مَتَى أَيَّانَ أَيْنَ إِذْمَا\nوَحَيْثُمَا كَيْفَمَا ثُمَّ إِذَا ۞ فِي الشِّعْرِ لاَ فِي النَّثْرِ كَيْ لاَ تَنَفَذَا\nفَاعِلٌ ارْفَعْهُ وَهُوَ مَا قَدْ أُسْنِدَا ۞ إِلَيْهِ فِعْلٌ قَبْلَهُ قَدْ وُجِدَا\nوَظَاهِرًا يَأْتِي وَيَأْتِي مُضْمَرَا ۞ كَصَادَ زَيْدٌ وَاشْتَرَيْتُ أَعْفُرَا\nإِذَا حَذَفْتَ فِي الْكَلاَمِ فَاعِلاَ ۞ مُخْتَصِرًا أَوْ مُبْهِمًا أَوْ جَاهِلاَ\nفَأَوْجِبِ التَّأْخِيرَ لِلْمَفْعُولِ بِهِ ۞ وَالرَّفْعَ حَيْثُ نَابَ عَنْهُ وَانْتَبِهْ\nفَأَوَّلَ الْفِعْلِ اضْمُمَنْ وَاكْسِرْ فِيهِ ۞ مَا قَبْلَ الآخِرِ المَضِيِّ حَتْمَا\nوَمَا قُبَيْلَ آخِرِ الْمُضَارِعِ ۞ يُفْتَحُ كَيُكْرَمُ ذُو المَطَامِعِ\nوَظَاهِرًا وَمُضْمَرًا أَيْضًا ثَبَتْ ۞ كَأُكْرِمَتْ هِنْدٌ وَهِنْدٌ ضُرِبَتْ","briefExplanation":"الجوازم قسمان: ما يجزم فعلا واحدا وهي لم ولما وألم وألما ولام الأمر ولا الطلبية، وما يجزم فعلين وهي أدوات الشرط. والفاعل اسم مرفوع أسند إليه فعل قبله ظاهرا أو مضمرا. فإذا حذف الفاعل ناب عنه المفعول به مع تغيير صورة الفعل.","detailedExplanation":"## 1. ما يجزم فعلا واحدا\n\nلم ولما حرفا نفي وجزم وقلب، والفرق أن نفي لما متصل بالحاضر ولا يكون إلا لما يتوقع وقوعه، ونفي لم عام. وألم وألما هما لم ولما دخلت عليهما همزة التقرير فلا تختلفان عملا. ولام الأمر من الأعلى للأسفل ولام الدعاء من الأدنى للأعلى، ولا الطلبية للنهي والدعاء.\n\n\n- **مثال لم:** (لم يحضرْ زيدٌ) — نفي وقلب للماضي.\n- **مثال لما:** (لما يحضرْ زيدٌ) — نفي مستمر إلى الحال.\n- **مثال لام الأمر:** (لينفقْ ذو سعةٍ).\n- **مثال لا الناهية:** (لا تهملْ درسَكَ).\n\n## 2. ألفاظ أبيات الدرس بيتاً بيتاً\n> منهج هذا الدرس: نبدأ بألفاظ الأبيات بيتاً بيتاً، ثم نبسط معناها العام وقواعدها.\n\n\nفي هذا القسم نفكك كلمات كل بيت وعباراته أولا، ثم نذكر معناه إجمالا.\n\n- **البيت:** وَجَزْمُهُ إِذَا أَرَدْتَ الْجَزْمَا / بِلَمْ وَلَمَّا وَأَلَمْ أَلَمَّا\n\n  - **تفكيك العبارات:** جزمه: جزم المضارع؛ إذا أردت الجزما: إذا قصدته.\n\n  - **معنى البيت:** جوازم الفعل الواحد الأولى.\n\n- **البيت:** وَلاَمِ الأَمْرِ وَالدُّعَاءِ فَاكْتَفِ / ثُمَّ لاَ فِي النَّهْيِ وَالدُّعَاءِ فَاقْتُفِي\n\n  - **تفكيك العبارات:** فاكتف: اكتف بهذا؛ فاقتفي: اتبع.\n\n  - **معنى البيت:** تتمة جوازم الفعل الواحد.\n\n- **البيت:** وَإِنْ وَمَا وَمَنْ وَأَنَّى مَهْمَا / مَتَى أَيَّانَ أَيْنَ إِذْمَا\n\n  - **تفكيك العبارات:** سرد أدوات الشرط الأولى.\n\n  - **معنى البيت:** أدوات الشرط الجازمة لفعلين.\n\n- **البيت:** وَحَيْثُمَا كَيْفَمَا ثُمَّ إِذَا / فِي الشِّعْرِ لاَ فِي النَّثْرِ كَيْ لاَ تَنَفَذَا\n\n  - **تفكيك العبارات:** في الشعر لا في النثر: اختصاص إذا بالشعر.\n\n  - **معنى البيت:** تتمة الأدوات وشرط إذا.\n\n- **البيت:** فَاعِلٌ ارْفَعْهُ وَهُوَ مَا قَدْ أُسْنِدَا / إِلَيْهِ فِعْلٌ قَبْلَهُ قَدْ وُجِدَا\n\n  - **تفكيك العبارات:** ارفعه: حكمه الرفع؛ ما أسند إليه فعل قبله: تعريفه.\n\n  - **معنى البيت:** تعريف الفاعل وحكمه.\n\n- **البيت:** وَظَاهِرًا يَأْتِي وَيَأْتِي مُضْمَرَا / كَصَادَ زَيْدٌ وَاشْتَرَيْتُ أَعْفُرَا\n\n  - **تفكيك العبارات:** ظاهرا ومضمرا: نوعاه؛ صاد زيد: مثال الظاهر؛ اشتريت: مثال المضمر؛ أعفرا: الظبي الذي يعلو بياضه حمرة.\n\n  - **معنى البيت:** نوعا الفاعل.\n\n- **البيت:** إِذَا حَذَفْتَ فِي الْكَلاَمِ فَاعِلاَ / مُخْتَصِرًا أَوْ مُبْهِمًا أَوْ جَاهِلاَ\n\n  - **تفكيك العبارات:** مختصرا: للاختصار؛ أو مبهما: للإبهام؛ أو جاهلا: للجهل به.\n\n  - **معنى البيت:** أسباب حذف الفاعل.\n\n- **البيت:** فَأَوْجِبِ التَّأْخِيرَ لِلْمَفْعُولِ بِهِ / وَالرَّفْعَ حَيْثُ نَابَ عَنْهُ وَانْتَبِهْ\n\n  - **تفكيك العبارات:** أوجب التأخير: أخره وجوبا؛ حيث ناب عنه: حيث قام مقامه؛ وانتبه: تنبه لهذا الحكم.\n\n  - **معنى البيت:** حكم النائب عن الفاعل.\n\n- **البيت:** فَأَوَّلَ الْفِعْلِ اضْمُمَنْ وَاكْسِرْ فِيهِ / مَا قَبْلَ الآخِرِ المَضِيِّ حَتْمَا\n\n  - **تفكيك العبارات:** اضممن: ضم؛ واكسر فيه: واكسر؛ حتما: وجوبا.\n\n  - **معنى البيت:** بناء الماضي للمجهول.\n\n- **البيت:** وَمَا قُبَيْلَ آخِرِ الْمُضَارِعِ / يُفْتَحُ كَيُكْرَمُ ذُو المَطَامِعِ\n\n  - **تفكيك العبارات:** قبيل آخره: ما قبل آخره؛ ذو المطامع: صاحب المطالب العالية مثالا.\n\n  - **معنى البيت:** بناء المضارع للمجهول.\n\n- **البيت:** وَظَاهِرًا وَمُضْمَرًا أَيْضًا ثَبَتْ / كَأُكْرِمَتْ هِنْدٌ وَهِنْدٌ ضُرِبَتْ\n\n  - **تفكيك العبارات:** ثبت: ثبت ذلك؛ أكرمت هند: مثال الظاهر؛ هند ضربت: مثال المضمر.\n\n  - **معنى البيت:** نوعا النائب عن الفاعل.\n\n## 3. أدوات الشرط\n\nما يجزم فعلين يجزم الأول على أنه فعل الشرط والثاني على أنه الجواب. وهي إن لربط الجواب بالشرط، وما لغير العاقل، ومن للعاقل، وأنى للزمان والمكان، ومهما لغير العاقل، وأي بحسب ما تضاف إليه، ومتى وأيان للزمان، وأين وحيثما للمكان، وإذما حرف عند سيبويه، وكيفما بشرط اتحاد الفعلين، وإذا في الشعر خاصة.\n\n\n- **مثال أدوات الشرط:** (إن تذاكرْ تنجحْ)، (من يجتهدْ يفزْ)، (متى تسافرْ أصحبْكَ).\n\n## 4. تعريف الفاعل\n\nالفاعل هو الاسم أو المصدر المؤول المرفوع المذكور قبله فعله التام المسند إليه. وقدم الناظم حكمه على تعريفه لتجنب إدخال الحكم في الحد. وأنواعه ظاهر ومضمر.\n\n\n- **مثال الفاعل الظاهر:** (حضر زيدٌ).\n- **مثال الفاعل المضمر:** (حضرتُ، حضرنا).\n\n## 5. النائب عن الفاعل\n\nيحذف الفاعل لأغراض بلاغية منها الإيجاز والإبهام والجهل والخوف. فإذا حذف أقيم المفعول به مقامه فوجب رفعه وتأخيره وتأنيث الفعل لتأنيثه. ويضم أول الفعل ويكسر ما قبل آخر الماضي ويفتح ما قبل آخر المضارع. والنائب ظاهر ومضمر.\n\n- **مثال نائب الفاعل:** (كُتب الدرسُ)، (يُحترمُ المعلمُ)، (فُتحتِ المدرسةُ).\n","evidences":[{"type":"quran","text":"﴿لَمْ يَلِدْ وَلَمْ يُولَدْ﴾","reference":"سورة الإخلاص: 3 (لم)"},{"type":"quran","text":"﴿بَل لَّمَّا يَذُوقُوا عَذَابِ﴾","reference":"سورة ص: 8 (لما)"},{"type":"quran","text":"﴿أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ﴾","reference":"سورة الشرح: 1 (ألم)"},{"type":"quran","text":"﴿لِيُنفِقْ ذُو سَعَةٍ مِّن سَعَتِهِ﴾","reference":"سورة الطلاق: 7 (لام الأمر)"},{"type":"quran","text":"﴿وَنَادَوْا يَا مَالِكُ لِيَقْضِ عَلَيْنَا رَبُّكَ﴾","reference":"سورة الزخرف: 77 (لام الدعاء)"},{"type":"quran","text":"﴿رَبَّنَا لَا تُؤَاخِذْنَا إِن نَّسِينَا أَوْ أَخْطَأْنَا﴾","reference":"سورة البقرة: 286 (لا الدعائية)"},{"type":"quran","text":"﴿مَا نَنسَخْ مِنْ آيَةٍ أَوْ نُنسِهَا نَأْتِ بِخَيْرٍ مِّنْهَا﴾","reference":"سورة البقرة: 106 (ما الشرطية)"},{"type":"quran","text":"﴿مَن يَعْمَلْ سُوءًا يُجْزَ بِهِ﴾","reference":"سورة النساء: 123 (من الشرطية)"},{"type":"quran","text":"﴿أَيًّا مَّا تَدْعُوا فَلَهُ الْأَسْمَاءُ الْحُسْنَىٰ﴾","reference":"سورة الإسراء: 110 (أي الشرطية)"},{"type":"quran","text":"﴿أَيْنَمَا يُوَجِّههُّ لَا يَأْتِ بِخَيْرٍ﴾","reference":"سورة النحل: 76 (أين)"},{"type":"quran","text":"﴿فَتُقُبِّلَ مِنْ أَحَدِهِمَا وَلَمْ يُتَقَبَّلْ مِنَ الْآخَرِ﴾","reference":"سورة المائدة: 27 (اجتماع البناءين)"}],"scholars":[],"benefits":["نفي لما متصل بالحاضر المنتظر.","ألم وألما لا تختلفان عملا.","لام الأمر للأعلى ولام الدعاء للأدنى.","كل أداة شرط لها معنى.","الفاعل ظاهر ومضمر.","النائب يأخذ أحكام الفاعل."],"terms":[{"term":"القلب","definition":"قلب زمن المضارع إلى الماضي مع لم ولما."},{"term":"فعل الشرط","definition":"الفعل الأول المجزوم بأداة الشرط."},{"term":"جواب الشرط","definition":"الفعل الثاني المترتب على الشرط."},{"term":"البناء للمجهول","definition":"تغيير صورة الفعل مع حذف الفاعل."}],"mindMap":{"title":"الجوازم والفاعل","branches":[{"title":"فعل واحد","items":["لم ولما","لام الأمر","لا الطلبية"]},{"title":"فعلان","items":["إن وما ومن","متى وأين وحيثما","بقية الأدوات"]},{"title":"الفاعل ونائبه","items":["التعريف والأنواع","أسباب الحذف","أحكام النائب"]}]},"summaryTable":{"headers":["الباب","الحكم","مثال"],"rows":[["لم","نفي وجزم وقلب","لم يلد"],["أدوات الشرط","جزم فعلين","من يعمل سوءا يجز به"],["الفاعل","الرفع","صاد زيد"],["النائب","الرفع مع تغيير الفعل","هند ضربت"]]},"video":{"url":"https://www.youtube.com/watch?v=OV09RUNwboM","title":"شرح نظم الآجرومية // 05 // الشيخ محمد محمود الشنقيطي"}},"questions":[{"q":"ما الفرق بين لم ولما؟","options":["لا فرق بينهما","لم للنفي ولما للإثبات","لما حرف جر","نفي لما متصل بالحاضر المنتظر"],"answer":3},{"q":"لمن تكون لام الدعاء؟","options":["من الأدنى للأعلى","من الأعلى للأدنى","بين المتساويين","لا تستعمل"],"answer":0},{"q":"كم فعلا تجزم أدوات الشرط؟","options":["فعلين","فعلا واحدا","ثلاثة","أربعة"],"answer":1},{"q":"ما أنواع الفاعل؟","options":["مفرد وجمع","مذكر ومؤنث","ظاهر ومضمر","عاقل وغير عاقل"],"answer":2},{"q":"لم يحذف الفاعل؟","options":["للإيجاز أو الإبهام أو الجهل أو الخوف","دائما دون سبب","لأنه حرف","لأنه منصوب"],"answer":0},{"q":"كيف يبنى المضارع للمجهول؟","options":["بفتح أوله","بضم أوله وفتح ما قبل آخره","بسكون آخره","بحذف أوله"],"answer":1}]},{"id":"ajr-06","order":7,"title":"الدرس 06: المبتدأ والخبر وكان وأخواتها","chapter":"المبتدأ وكان","summary":"تعريف المبتدأ وعامله وأقسامه، والخبر وعامله وأنواعه، ثم مدخل النواسخ وعمل كان وحصر أفعالها وشروطها وتصرفها.","content":{"objectives":["أن يعرف الطالب المبتدأ وعامله وأقسامه.","أن يعرف الخبر وعامله وأنواعه.","أن يعدد أقسام النواسخ الثلاثة.","أن يشرح عمل كان وشروطها وتصرف أفعالها."],"matn":"المبتدأُ اسمٌ من عواملَ سَلِمْ ۞ لفظيةٍ وهو برفعٍ قد وُسِمْ\nوالخبرُ الاسمُ الذي قد أُسْنِدا ۞ إليهِ وارتفاعَهُ الزم أَبَدَا\nوَرَفْعُكَ الاسْمَ وَنَصْبُكَ الخَبَرْ ۞ بِهَذِهِ الأَفْعَالِ حُكْمٌ مُعْتَبَرْ\nكَانَ وَأَمْسَى ظَلَّ بَاتَ أَصْبَحَا ۞ أَضْحَى وَصَارَ لَيْسَ مَعْ مَا بَرِحَا\nمَا زَالَ مَنْفَكَّ وَمَا فَتِئَ مَا ۞ دَامَ وَمَا مِنْهَا تَصَرَّفَ احْكُمَا\nلَهُ بِمَا لَهَا كَكَانَ قَائِمَا ۞ زَيْدٌ وَكُنْ بَرًّا وَأَصْبِحْ صَائِمَا","briefExplanation":"المبتدأ اسم متجرد من العوامل اللفظية مرفوع بالابتداء، ويأتي ظاهرا ومضمرا ومؤولا. والخبر مسند إليه مرفوع، وعامله المبتدأ، ويأتي مفردا وغير مفرد بأنواعه الأربعة. والنواسخ ثلاثة أقسام، وكان وأخواتها ترفع الاسم وتنصب الخبر بثلاثة عشر فعلا لها شروط وتصرف.","detailedExplanation":"## 1. تعريف المبتدأ وعامله\n\nالمبتدأ هو الاسم المتجرد العاري من العوامل اللفظية. وعامل الرفع فيه معنوي وهو الابتداء أي التجرد من العوامل اللفظية.\n\nوعدل الناظم عن عبارة ابن آجروم لئلا يدخل الحكم وهو الرفع داخل الحد والتعريف، وهو عيب عند أهل المنطق والنحو، فجعل التعريف أولا ثم أتبعه بالحكم.\n\n## 2. ألفاظ أبيات الدرس بيتاً بيتاً\n> منهج هذا الدرس: نبدأ بألفاظ الأبيات بيتاً بيتاً، ثم نبسط معناها العام وقواعدها.\n\n\nفي هذا القسم نفكك كلمات كل بيت وعباراته أولا، ثم نذكر معناه إجمالا.\n\n- **البيت:** المبتدأُ اسمٌ من عواملَ سَلِمْ / لفظيةٍ وهو برفعٍ قد وُسِمْ\n\n  - **تفكيك العبارات:** من عوامل سلم: خلا منها؛ لفظية: المنطوقة؛ برفع قد وسم: وسم أي علم وألزم بالرفع.\n\n  - **معنى البيت:** تعريف المبتدأ وحكمه.\n\n- **البيت:** والخبرُ الاسمُ الذي قد أُسْنِدا / إليهِ وارتفاعَهُ الزم أَبَدَا\n\n  - **تفكيك العبارات:** الذي أسند إليه: الذي أسند إلى المبتدأ؛ الزم ارتفاعه أبدا: الزم رفعه دائما.\n\n  - **معنى البيت:** تعريف الخبر وحكمه.\n\n- **البيت:** وَرَفْعُكَ الاسْمَ وَنَصْبُكَ الخَبَرْ / بِهَذِهِ الأَفْعَالِ حُكْمٌ مُعْتَبَرْ\n\n  - **تفكيك العبارات:** حكم معتبر: حكم راجح صحيح عند الجمهور.\n\n  - **معنى البيت:** عمل كان وأخواتها.\n\n- **البيت:** كَانَ وَأَمْسَى ظَلَّ بَاتَ أَصْبَحَا / أَضْحَى وَصَارَ لَيْسَ مَعْ مَا بَرِحَا\n\n  - **تفكيك العبارات:** سرد الأفعال الثمانية الأولى.\n\n  - **معنى البيت:** تعداد كان وأخواتها.\n\n- **البيت:** مَا زَالَ مَنْفَكَّ وَمَا فَتِئَ مَا / دَامَ وَمَا مِنْهَا تَصَرَّفَ احْكُمَا\n\n  - **تفكيك العبارات:** تمام التعداد؛ ما تصرف منها: ما جاء منه مضارع وأمر؛ احكما: احكم.\n\n  - **معنى البيت:** تمام الأفعال وحكم المتصرف.\n\n- **البيت:** لَهُ بِمَا لَهَا كَكَانَ قَائِمَا / زَيْدٌ وَكُنْ بَرًّا وَأَصْبِحْ صَائِمَا\n\n  - **تفكيك العبارات:** له بما لها: أعطه حكمها؛ كان قائما زيد: مثال توسط الخبر.\n\n  - **معنى البيت:** حكم المتصرف وجواز التوسط.\n\n## 3. أقسام المبتدأ\n\nالمبتدأ ظاهر كالله ربنا ومحمد نبينا، ومضمر كضمائر الرفع المنفصلة في محل رفع مبتدأ، ومؤول بالاسم كأن تصوموا أي صيامكم خير لكم.\n\n## 4. الخبر وعامله وأنواعه\n\nالخبر هو الجزء الذي يسند إلى المبتدأ وتتم به فائدة الجملة. وبعض النسخ تبدأ بالجزء وهي أصوب لأن الخبر قد يكون غير اسم. وعامل الرفع فيه هو المبتدأ نفسه وهو عامل لفظي.\n\nوينقسم إلى مفرد وهو في هذا الباب ما ليس جملة ولا شبه جملة حتى لو كان مثنى أو جمعا، وغير مفرد وهو أربعة: الجار والمجرور والظرف والجملة الفعلية والجملة الاسمية.\n\n\n- **مثال المبتدأ والخبر المفردين:** (العلمُ نورٌ).\n- **مثال الخبر الجملة:** (زيدٌ أبوه كريمٌ) اسمية، (زيدٌ يكتبُ الدرسَ) فعلية.\n- **مثال الخبر شبه الجملة:** (زيدٌ في الدارِ)، (الكتابُ عندكَ).\n\n## 5. مدخل النواسخ\n\nالنواسخ كلمات تدخل على الجملة الاسمية فتنسخ أي تغير حكمها الإعرابي، وهي ثلاثة أقسام: ما يرفع المبتدأ وينصب الخبر، وما يعكس ذلك، وما ينصبهما معا مفعولين.\n\n## 6. عمل كان وحصر أفعالها\n\nتدخل هذه الأفعال وعددها ثلاثة عشر على الجملة الاسمية فترفع المبتدأ ويسمى اسمها وتنصب الخبر ويسمى خبرها، وهذا حكم معتبر أي راجح عند الجمهور.\n\nوهي: كان وهي أم الباب، وأمسى للاتصاف مساء، وظل للنهار، وبات لليل، وأصبح للصباح، وأضحى للضحى، وصار للتحول، وليس لنفي الحال، ثم برح وزال وانفك وفتئ ودام.\n\n\n- **مثال كان:** (كان الجوُّ بارداً).\n- **مثال أصبح:** (أصبح الطقسُ جميلاً).\n- **مثال أمسى وأضحى وظل وبات:** (أمسى الطالبُ مسروراً)، (بات الحارسُ يقظاً).\n- **مثال صار:** (صار الدقيقُ خبزاً) — للتحويل.\n- **مثال ليس:** (ليس الكسلُ نافعاً).\n- **مثال ما زال وأخواتها:** (ما زال الحقُّ منتصراً)، (ما برح المطرُ نازلاً).\n\n## 7. شروط العمل والتصرف\n\nتعمل ثمانية بلا شرط، وتعمل أربعة بشرط تقدم نفي أو نهي أو دعاء ويحذف النفي شذوذا، وتعمل دام بشرط ما المصدرية الظرفية.\n\nوهي من حيث التصرف: جامد لا يتصرف وهو ليس ودام الناقصة، وناقص التصرف وهو الأربعة، وتام التصرف وهو الباقي. ويجوز توسط الخبر بين الفعل واسمه.\n\n## خلاصة الدرس\n\nالمبتدأ متجرد مرفوع بالابتداء، والخبر مسند مرفوع بالمبتدأ، والأنواع تحفظ بأمثلتها. وكان وأخواتها ثلاثة عشر فعلا بشروط وتصرف، وتوسط الخبر جائز.\n\n---\n\n[مطابقة الأبيات للشرح من المجلس المرئي]\n١- بيتا المبتدأ والخبر (المبتدأ اسم من عوامل سلم لفظية... والخبر الاسم الذي قد أسندا إليه): المبتدأ مرفوع بالابتداء وهو عامل معنوي، والخبر مرفوع بالمبتدأ؛ فالعامل في الجملة الاسمية معنوي لا لفظي.\n٢- بيت حكم كان (ورفعك الاسم ونصبك الخبر بهذه الأفعال حكم معتبر): كان وأخواتها ترفع المبتدأ اسماً لها وتنصب الخبر خبراً لها — عكس عمل إن.\n٣- أبيات التعداد (كان وأمسى ظل بات أصبحا... وما دام): وهي ثلاثة عشر فعلاً: كان وأمسى وأصبح وأضحى وظل وبات وصار وليس وما زال وما برح وما فتئ وما انفك وما دام؛ وما تصرف منها يعمل عملها (كن براً، أصبح صائماً).\n٤- مثالا البيت (ككان زيد قائماً... وكن براً وأصبح صائماً): زيد اسم كان مرفوع وقائماً خبرها منصوب؛ وبراً خبر كن، وصائماً خبر أصبح.\n٥- تنبيه الشارح: (ما زال) وأخواتها لا تعمل إلا مسبوقة بنفي، و(ما دام) مسبوقة بما المصدرية الظرفية.","evidences":[{"type":"quran","text":"﴿نَحْنُ أَعْلَمُ بِمَا يَقُولُونَ﴾","reference":"سورة ق: 45 (المبتدأ المضمر)"},{"type":"quran","text":"﴿هُوَ أَعْلَمُ بِكُمْ﴾","reference":"سورة النجم: 32 (المبتدأ المضمر)"},{"type":"quran","text":"﴿وَأَن تَصُومُوا خَيْرٌ لَّكُمْ﴾","reference":"سورة البقرة: 184 (المبتدأ المؤول)"},{"type":"quran","text":"﴿الْحَمْدُ لِلَّهِ﴾","reference":"سورة الفاتحة: 2 (الخبر شبه جملة)"},{"type":"quran","text":"﴿إِنَّمَا الْعِلْمُ عِندَ اللَّهِ﴾","reference":"سورة الأحقاف: 23 (الخبر ظرف)"},{"type":"quran","text":"﴿وَاللَّهُ فَضَّلَ بَعْضَكُمْ عَلَىٰ بَعْضٍ﴾","reference":"سورة النحل: 71 (الخبر جملة فعلية)"},{"type":"quran","text":"﴿ظَلَّ وَجْهُهُ مُسْوَدًّا﴾","reference":"سورة النحل: 58 (ظل)"},{"type":"quran","text":"﴿فَأَصْبَحْتُم بِنِعْمَتِهِ إِخْوَانًا﴾","reference":"سورة آل عمران: 103 (أصبح)"},{"type":"quran","text":"﴿وَلَا يَزَالُونَ مُخْتَلِفِينَ﴾","reference":"سورة هود: 118 (زال)"},{"type":"quran","text":"﴿لَن نَّبْرَحَ عَلَيْهِ عَاكِفِينَ﴾","reference":"سورة طه: 91 (برح)"},{"type":"quran","text":"﴿تَاللَّهِ تَفْتَأُ تَذْكُرُ يُوسُفَ﴾","reference":"سورة يوسف: 85 (حذف النفي)"},{"type":"quran","text":"﴿وَأَوْصَانِي بِالصَّلَاةِ وَالزَّكَاةِ مَا دُمْتُ حَيًّا﴾","reference":"سورة مريم: 31 (دام)"},{"type":"quran","text":"﴿وَكَانَ أَبُوهُمَا صَالِحًا﴾","reference":"سورة الكهف: 82 (الماضي)"},{"type":"quran","text":"﴿وَتَكُونُوا مِن بَعْدِهِ قَوْمًا صَالِحِينَ﴾","reference":"سورة يوسف: 9 (المضارع)"},{"type":"quran","text":"﴿قُلْ كُونُوا حِجَارَةً أَوْ حَدِيدًا﴾","reference":"سورة الإسراء: 50 (الأمر)"},{"type":"quran","text":"﴿وَكَانَ حَقًّا عَلَيْنَا نَصْرُ الْمُؤْمِنِينَ﴾","reference":"سورة الروم: 47 (توسط الخبر)"}],"scholars":[],"benefits":["المبتدأ متجرد وعامله الابتداء.","الحد يقدم على الحكم منهجيا.","المبتدأ ظاهر ومضمر ومؤول.","الخبر مفرد وغير مفرد بأربعة أنواع.","النواسخ ثلاثة أقسام.","كان ثلاثة عشر فعلا بشروط وتصرف."],"terms":[{"term":"الابتداء","definition":"التجرد من العوامل اللفظية وهو عامل الرفع في المبتدأ."},{"term":"النواسخ","definition":"ما يدخل على الجملة الاسمية فيغير حكمها."},{"term":"الخبر المفرد","definition":"في هذا الباب ما ليس جملة ولا شبه جملة."},{"term":"التصرف","definition":"مجيء الماضي والمضارع والأمر والمصدر والوصف من الفعل."}],"mindMap":{"title":"المبتدأ وكان","branches":[{"title":"المبتدأ","items":["التعريف","العامل","ظاهر ومضمر ومؤول"]},{"title":"الخبر","items":["التعريف","العامل","مفرد وغير مفرد"]},{"title":"كان","items":["العمل","13 فعلا","الشروط","التصرف"]}]},"summaryTable":{"headers":["الباب","الحكم","مثال"],"rows":[["المبتدأ","مرفوع بالابتداء","نحن أعلم"],["الخبر","مرفوع بالمبتدأ","الحمد لله"],["كان","ترفع الاسم وتنصب الخبر","كان زيد قائما"]]},"video":{"url":"https://www.youtube.com/watch?v=7IOeh665d_o","title":"شرح نظم الآجرومية // 06 // الشيخ محمد محمود الشنقيطي"}},"questions":[{"q":"ما عامل الرفع في المبتدأ؟","options":["الفعل","حرف الجر","إن","الابتداء"],"answer":3},{"q":"لم عدل الناظم عن عبارة ابن آجروم؟","options":["لئلا يدخل الحكم في الحد","لأنها طويلة","لأنها نثر","لا سبب"],"answer":0},{"q":"ما أقسام المبتدأ؟","options":["مفرد وجمع","ظاهر ومضمر ومؤول","مذكر ومؤنث","عاقل وغير عاقل"],"answer":1},{"q":"ما عامل الرفع في الخبر؟","options":["الفعل","الابتداء","المبتدأ","حرف الجر"],"answer":2},{"q":"كم أقسام النواسخ؟","options":["قسمان","ثلاثة","أربعة","خمسة"],"answer":0},{"q":"بشرط ماذا تعمل دام؟","options":["بلا شرط","ما المصدرية الظرفية","النفي فقط","الأمر فقط"],"answer":1}]},{"id":"ajr-07","order":8,"title":"الدرس 07: إن وأخواتها وظن وأخواتها والنعت","chapter":"إن وظن والنعت","summary":"عمل إن وعلته ومعاني أدواتها، وأفعال القلوب وأحكامها، وتعريف النعت بقسميه ومطابقته.","content":{"objectives":["أن يبين الطالب عمل إن وعلته.","أن يشرح معاني الأدوات الست.","أن يعدد أفعال القلوب وأحكامها.","أن يميز النعت الحقيقي من السببي."],"matn":"عَمَلَ كَانَ عُكِسَتْ لِإِنَّ ۞ لكِنَّ لَيْتَ ولَعَلَّ وكأنَّ\nتَقُولُ إنَّ مَالِكاً لَعَالِمُ ۞ وَمِثْلُهُ لَيْتَ الحَبِيبَ قَادِمُ\nأَكِّدْ بِإِنَّ أَنَّ شَبِّهْ بِكَأَنْ ۞ لكِنَّ يَا صَاحِ لِلاسْتِدْرَاكِ عَنْ\nوَلِلتَّمَنِّي لَيْتَ عِنْدَهُمْ حَصَلْ ۞ وَلِلتَّرَجِّي وَالتَّوَقُّعِ لَعَلْ\nانْصِبْ بِأَفْعَالِ القُلُوبِ مُبْتَدَا ۞ وَخَبَرًا وَهْيَ ظَنَنْتُ وَجَدَا\nرَأَى حَسِبْتُ وَجَعَلْتُ زَعَمَا ۞ كَذَاكَ خِلْتُ وَاتَّخَذْتُ عَلِمَا\nتَقُولُ قَدْ ظَنَنْتُ زَيْدًا صَادِقَا ۞ فِي قَوْلِهِ وَخِلْتُ عَمْرًا حَاذِقَا\nالنَّعْتُ قَدْ قَالَ ذَوُو الأَلْبَابِ ۞ يَتْبَعُ لِلْمَنْعُوتِ فِي الإِعْرَابِ\nكَذَاكَ فِي التَّعْرِيفِ وَالتَّنْكِيرِ ۞ كَجَاءَ زَيْدٌ صَاحِبُ الأَمِيرِ","briefExplanation":"إن وأخواتها تنصب المبتدأ وترفع الخبر عكس كان لشبهها بالفعل. ولكل أداة معنى: التوكيد والتشبيه والاستدراك والتمني والترجي. وأفعال القلوب تنصب المبتدأ والخبر مفعولين. والنعت تابع حقيقي أو سببي بمطابقة معلومة.","detailedExplanation":"## 1. عمل إن وعلته\n\nتدخل هذه الحروف على الجملة الاسمية فتنصب المبتدأ اسما لها وترفع الخبر خبرا لها. وعلته أنها شابهت الفعل الناسخ كان في لزوم المبتدأ والخبر فأعطيت عمله معكوسا تنبيها على فرعيتها.\n\nولام الابتداء تفيد توكيد الخبر وتدخل على خبر إن المكسورة.\n\n## 2. ألفاظ أبيات الدرس بيتاً بيتاً\n> منهج هذا الدرس: نبدأ بألفاظ الأبيات بيتاً بيتاً، ثم نبسط معناها العام وقواعدها.\n\n\nفي هذا القسم نفكك كلمات كل بيت وعباراته أولا، ثم نذكر معناه إجمالا.\n\n- **البيت:** عَمَلَ كَانَ عُكِسَتْ لِإِنَّ / لكِنَّ لَيْتَ ولَعَلَّ وكأنَّ\n\n  - **تفكيك العبارات:** عكس عمل كان: نصب الاسم ورفع الخبر؛ سرد الحروف الستة.\n\n  - **معنى البيت:** عمل إن وأخواتها.\n\n- **البيت:** تَقُولُ إنَّ مَالِكاً لَعَالِمُ / وَمِثْلُهُ لَيْتَ الحَبِيبَ قَادِمُ\n\n  - **تفكيك العبارات:** مالكا: اسم إن؛ لعالم: خبرها ولام الابتداء؛ الحبيب: اسم ليت؛ قادم: خبرها.\n\n  - **معنى البيت:** مثالا إن وليت.\n\n- **البيت:** أَكِّدْ بِإِنَّ أَنَّ شَبِّهْ بِكَأَنْ / لكِنَّ يَا صَاحِ لِلاسْتِدْرَاكِ عَنْ\n\n  - **تفكيك العبارات:** أكد: للتوكيد؛ شبه: للتشبيه؛ يا صاح: يا صاحبي بالترخيم؛ للاستدراك: لتعقيب الكلام.\n\n  - **معنى البيت:** معاني إن وأن وكأن ولكن.\n\n- **البيت:** وَلِلتَّمَنِّي لَيْتَ عِنْدَهُمْ حَصَلْ / وَلِلتَّرَجِّي وَالتَّوَقُّعِ لَعَلْ\n\n  - **تفكيك العبارات:** للتمني: لطلب ما لا طمع فيه؛ للترجي: لانتظار المحبوب؛ للتوقع: لانتظار المكروه.\n\n  - **معنى البيت:** معنى ليت ولعل.\n\n- **البيت:** انْصِبْ بِأَفْعَالِ القُلُوبِ مُبْتَدَا / وَخَبَرًا وَهْيَ ظَنَنْتُ وَجَدَا\n\n  - **تفكيك العبارات:** انصب: حكمها النصب؛ مبتدا وخبرا: مفعولين؛ ظننت ووجدا: أول الأفعال.\n\n  - **معنى البيت:** عمل أفعال القلوب.\n\n- **البيت:** رَأَى حَسِبْتُ وَجَعَلْتُ زَعَمَا / كَذَاكَ خِلْتُ وَاتَّخَذْتُ عَلِمَا\n\n  - **تفكيك العبارات:** سرد بقية الأفعال.\n\n  - **معنى البيت:** تمام تعدادها.\n\n- **البيت:** تَقُولُ قَدْ ظَنَنْتُ زَيْدًا صَادِقَا / فِي قَوْلِهِ وَخِلْتُ عَمْرًا حَاذِقَا\n\n  - **تفكيك العبارات:** زيدا: مفعول أول؛ صادقا: مفعول ثان؛ عمرا وحاذقا: كذلك.\n\n  - **معنى البيت:** مثالا ظن وخال.\n\n- **البيت:** النَّعْتُ قَدْ قَالَ ذَوُو الأَلْبَابِ / يَتْبَعُ لِلْمَنْعُوتِ فِي الإِعْرَابِ\n\n  - **تفكيك العبارات:** ذوو الألباب: أصحاب العقول أي العلماء؛ يتبع: حكمه الاتباع.\n\n  - **معنى البيت:** تعريف النعت وحكمه.\n\n- **البيت:** كَذَاكَ فِي التَّعْرِيفِ وَالتَّنْكِيرِ / كَجَاءَ زَيْدٌ صَاحِبُ الأَمِيرِ\n\n  - **تفكيك العبارات:** كذاك: وكذلك؛ صاحب الأمير: مثال النعت.\n\n  - **معنى البيت:** مطابقة النعت ومثاله.\n\n\n## 3. معاني الأدوات\n\nإن وأن للتوكيد، وتفتح الهمزة إذا صح أن يسد المصدر مسدها. وكأن للتشبيه المؤكد مركبة من الكاف وأن. ولكن للاستدراك وهو تعقيب الكلام برفع ما يتوهم ثبوته أو إثبات ما يتوهم نفيه. وليت للتمني وهو طلب ما لا طمع فيه. ولعل للترجي وهو انتظار المحبوب والتوقع وهو انتظار المكروه.\n\nوقوله يا صاح أصلها يا صاحبي حذفت الباء لكثرة الاستعمال على سبيل الترخيم.\n\n\n- **مثال إن:** (إن اللهَ غفورٌ).\n- **مثال أن المفتوحة:** (علمتُ أن زيداً قائمٌ).\n- **مثال كأن:** (كأن العلمَ نورٌ) — للتشبيه.\n- **مثال لكن:** (الجوُّ باردٌ لكنَّ الشمسَ مشرقةٌ) — للاستدراك.\n- **مثال ليت:** (ليت الشبابَ يعودُ) — للتمني.\n- **مثال لعل:** (لعل الفرجَ قريبٌ) — للترجي.\n\n## 4. أفعال القلوب\n\nتدخل على المبتدأ والخبر بعد استكمال فاعلها فتنصبهما مفعولين لأن العامل لا يرفع أكثر من فاعل واحد. وتسمى أفعال القلوب لأن معظمها باطن.\n\nوهي: ظن ووجد ورأى القلبية وحسب وجعل بمعنى اعتقد وزعم وخال وعلم، واتخذ من أفعال التحويل ملحقة بها.\n\n\n- **مثال أفعال القلوب:** (ظننتُ زيداً قائماً)، (حسبتُ الأمرَ سهلاً)، (علمتُ الصدقَ نافعاً)، (رأيتُ العلمَ نوراً)، (وجدتُ الكتابَ مفيداً).\n\n## 5. النعت بقسميه\n\nالنعت لغة الوصف، واصطلاحا التابع المكمل لما سبقه. والحقيقي ما دل على معنى في نفس المنعوت ويطابقه في أربعة من عشرة. والسببي ما دل على معنى في اسم ظاهر بعده ويتبع منعوته في اثنين من خمسة ويلزم الإفراد.\n\n\n- **مثال النعت:** (جاء رجلٌ كريمٌ) نكرة، (جاء الرجلُ الكريمُ) معرفة.\n\n## خلاصة الدرس\n\nإن عكس كان في العمل لشبهها بالفعل، ولكل أداة معنى، وأفعال القلوب تنصب مفعولين، والنعت حقيقي وسببي بمطابقة معلومة.","evidences":[{"type":"quran","text":"﴿كَأَنَّهُنَّ الْيَاقُوتُ وَالْمَرْجَانُ﴾","reference":"سورة الرحمن: 58 (كأن للتشبيه)"},{"type":"quran","text":"﴿يَا لَيْتَنِي كُنتُ مَعَهُمْ فَأَفُوزَ﴾","reference":"سورة النساء: 73 (ليت للتمني)"},{"type":"quran","text":"﴿إِنَّا وَجَدْنَاهُ صَابِرًا﴾","reference":"سورة ص: 44 (وجد)"},{"type":"quran","text":"﴿إِنَّهُمْ يَرَوْنَهُ بَعِيدًا * وَنَرَاهُ قَرِيبًا﴾","reference":"سورة المعارج: 6-7 (رأى القلبية)"},{"type":"quran","text":"﴿وَجَعَلُوا الْمَلَائِكَةَ الَّذِينَ هُمْ عِبَادُ الرَّحْمَنِ إِنَاثًا﴾","reference":"سورة الزخرف: 19 (جعل)"},{"type":"quran","text":"﴿فَإِنْ عَلِمْتُمُوهُنَّ مُؤْمِنَاتٍ﴾","reference":"سورة الممتحنة: 10 (علم)"},{"type":"quran","text":"﴿وَاتَّخَذَ اللَّهُ إِبْرَاهِيمَ خَلِيلًا﴾","reference":"سورة النساء: 125 (اتخذ)"},{"type":"quran","text":"﴿هَذَا صِرَاطٌ عَلَيَّ مُسْتَقِيمٌ﴾","reference":"سورة الحجر: 41 (النعت الحقيقي)"},{"type":"quran","text":"﴿وَيَهْدِيَكُمْ صِرَاطًا مُسْتَقِيمًا﴾","reference":"سورة الفتح: 20 (النعت الحقيقي)"},{"type":"quran","text":"﴿وَإِنَّكَ لَتَهْدِي إِلَى صِرَاطٍ مُسْتَقِيمٍ﴾","reference":"سورة الشورى: 52 (النعت الحقيقي)"},{"type":"quran","text":"﴿رَبَّنَا أَخْرِجْنَا مِنْ هَذِهِ الْقَرْيَةِ الظَّالِمِ أَهْلُهَا﴾","reference":"سورة النساء: 75 (النعت السببي)"}],"scholars":[],"benefits":["إن عكس كان لشبهها بالفعل.","لام الابتداء توكيد لخبر إن.","لكل أداة معنى يحفظ بشاهده.","أفعال القلوب تنصب مفعولين.","اتخذ من أفعال التحويل ملحقة بها.","النعت الحقيقي أربعة من عشرة والسببي اثنان من خمسة."],"terms":[{"term":"الاستدراك","definition":"تعقيب الكلام برفع ما يتوهم ثبوته أو إثبات ما يتوهم نفيه."},{"term":"التمني","definition":"طلب ما لا طمع فيه."},{"term":"الترجي","definition":"انتظار الأمر المحبوب."},{"term":"أفعال القلوب","definition":"ما دل على عمل قلبي باطن وينصب مفعولين."},{"term":"النعت الحقيقي","definition":"ما دل على معنى في نفس المنعوت."},{"term":"النعت السببي","definition":"ما دل على معنى في اسم ظاهر بعده."}],"mindMap":{"title":"إن وظن والنعت","branches":[{"title":"إن","items":["العمل المعكوس","المعاني الستة","لام الابتداء"]},{"title":"ظن","items":["نصب مفعولين","أفعال القلوب","اتخذ التحويلية"]},{"title":"النعت","items":["التعريف","الحقيقي والسببي","المطابقة"]}]},"summaryTable":{"headers":["الباب","الحكم","مثال"],"rows":[["إن","نصب الاسم ورفع الخبر","إن مالكا لعالم"],["ظن","نصب مفعولين","ظننت زيدا صادقا"],["النعت","الاتباع","جاء زيد صاحب الأمير"]]},"video":{"url":"https://www.youtube.com/watch?v=LaQkWWyicV4","title":"شرح نظم الآجرومية // 07 // الشيخ محمد محمود الشنقيطي"}},"questions":[{"q":"لم كان عمل إن معكوس عمل كان؟","options":["لأنها حرف جر","لا علة لذلك","لأنها فعل","لشبهها بالفعل"],"answer":3},{"q":"ما معنى لكن؟","options":["الاستدراك","التوكيد","التمني","التشبيه"],"answer":0},{"q":"ما معنى لعل؟","options":["التمني","الترجي والتوقع","التشبيه","النفي"],"answer":1},{"q":"لم سميت أفعال القلوب بذلك؟","options":["لأنها ظاهرة","لأنها حروف","لأن معظمها باطن","لا سبب"],"answer":2},{"q":"ما حكم اتخذ؟","options":["ملحقة بأفعال القلوب","من النواسخ الرافعة","حرف جر","لا تعمل"],"answer":0},{"q":"في كم يطابق النعت الحقيقي منعوته؟","options":["في اثنين من خمسة","في أربعة من عشرة","في واحد","في عشرة كلها"],"answer":1}]},{"id":"ajr-08","order":9,"title":"الدرس 08: المعرفة والنكرة والعطف","chapter":"المعرفة والعطف","summary":"أقسام المعرفة وحصرها واستدراك الشيخ، وحد النكرة وعلامتها، ثم العطف بنوعيه وحروفه العشرة وأمثلتها التطبيقية.","content":{"objectives":["أن يعدد الطالب أقسام المعرفة الخمسة والسبعة.","أن يبين حد النكرة وعلامتها.","أن يميز عطف البيان من عطف النسق.","أن يشرح معاني حروف العطف العشرة."],"matn":"وَاعْلَمْ هُدِيتَ الرُّشْدَ أَنَّ المَعْرِفَهْ ۞ خَمْسَةُ أَشْيَاءَ عِنْدَ أَهْلِ المَعْرِفَهْ\nوَهْيَ الضَّمِيرُ ثُمَّ الِاسْمُ العَلَمُ ۞ وَذُو الأَدَاةِ ثُمَّ الِاسْمُ المُبْهَمُ\nوَمَا إِلَى أَحَدِ هَذِهِ الأَرْبَعَهْ ۞ أُضِيفَ فَافْهَمِ المِثَالَ وَاتَّبِعَهْ\nنَحْوُ أَنَا وَهِنْدُ وَالغُلَامُ ۞ وَذَاكَ وَابْنُ عَمِّنَا\nوَإِنْ تَرَ اسْماً شَائِعاً فِي جِنْسِهِ ۞ لَمْ يُعَيِّنْ وَاحِداً فِي نَفْسِهِ\nفَهُوَ المُنَكَّرُ وَمَهْمَا تُرِدِ ۞ تَقْرِيبَ حَدِّهِ لِفَهْمِ المُبْتَدِي\nفَكُلُّ مَا لِلْأَلِفِ وَاللَّامِ يَصْلُحْ ۞ كَالْفَرَسِ وَالْغُلَامِ\nهَذَا وَإِنَّ العَطْفَ أَيْضاً تَابِعُ ۞ حُرُوفُهُ عَشَرَةٌ يَا سَامِعُ\nالوَاوُ وَالفَاءُ وَثُمَّ أَوْ وَأَمْ ۞ إِمَّا وَبَلْ لا وَلَكِنْ حَتَّى\nفَاجْهَدْ تُصِبْ جَاءَ زَيْدٌ وَمُحَمَّدُ ۞ وَقَدْ سَقَيْتُ عَمْراً وَسَعِيداً مِنْ ثَمَدْ\nوَقَوْلُ خَالِدٍ وَعَامِرٍ سَدَدْ ۞ وَمَنْ يَتُبْ وَيَسْتَقِمْ يَرْقَ الرَّشَدْ","briefExplanation":"المعرفة تُعد ولا تُحد وهي خمسة في النظم وسبعة في الحقيقة. والنكرة تحد ولا تعد وهي الاسم الشائع وعلامتها قبول أل. والعطف قسمان: بيان تُرك ذكره، ونسق بحروف عشرة لكل حرف معناه، مع تطبيقاتها على الأحوال الإعرابية الأربع.","detailedExplanation":"## 1. منهجية الباب\n\nأورد الناظم باب المعرفة والنكرة بين التوابع لأن بعض التوابع كالنعت تتبع المنعوت في التعريف والتنكير، ولو قدم هذا المبحث قبل باب النعت لكان أولى.\n\nوعرف المعرفة بالعد لأن المحصور بالعدد لا يحتاج إلى حد جامع مانع، وقوله خمسة أشياء بقصر الممدود للضرورة الشعرية.\n\n## 2. ألفاظ أبيات الدرس بيتاً بيتاً\n> منهج هذا الدرس: نبدأ بألفاظ الأبيات بيتاً بيتاً، ثم نبسط معناها العام وقواعدها.\n\n\nفي هذا القسم نفكك كلمات كل بيت وعباراته أولا، ثم نذكر معناه إجمالا.\n\n- **البيت:** وَاعْلَمْ هُدِيتَ الرُّشْدَ أَنَّ المَعْرِفَهْ / خَمْسَةُ أَشْيَاءَ عِنْدَ أَهْلِ المَعْرِفَهْ\n\n  - **تفكيك العبارات:** واعلم: تنبيه؛ هديت الرشد: دعاء؛ خمسة أشياء: بقصر الممدود للضرورة؛ عند أهل المعرفة: عند علمائها.\n\n  - **معنى البيت:** حصر المعرفة بالعدد.\n\n- **البيت:** وَهْيَ الضَّمِيرُ ثُمَّ الِاسْمُ العَلَمُ / وَذُو الأَدَاةِ ثُمَّ الِاسْمُ المُبْهَمُ\n\n  - **تفكيك العبارات:** الضمير: للحضور أو الغيبة؛ العلم: المعين مطلقا؛ ذو الأداة: المحلى بأل؛ المبهم: اسم الإشارة.\n\n  - **معنى البيت:** تعداد الأقسام الأربعة الأولى.\n\n- **البيت:** وَمَا إِلَى أَحَدِ هَذِهِ الأَرْبَعَهْ / أُضِيفَ فَافْهَمِ المِثَالَ وَاتَّبِعَهْ\n\n  - **تفكيك العبارات:** ما أضيف: القسم الخامس؛ فافهم المثال واتبعه: أمر بالفهم والاتباع.\n\n  - **معنى البيت:** المضاف إلى معرفة.\n\n- **البيت:** نَحْوُ أَنَا وَهِنْدُ وَالغُلَامُ / وَذَاكَ وَابْنُ عَمِّنَا\n\n  - **تفكيك العبارات:** أمثلة الأقسام الخمسة على الترتيب.\n\n  - **معنى البيت:** التمثيل للأقسام.\n\n- **البيت:** وَإِنْ تَرَ اسْماً شَائِعاً فِي جِنْسِهِ / لَمْ يُعَيِّنْ وَاحِداً فِي نَفْسِهِ\n\n  - **تفكيك العبارات:** شائعا في جنسه: منتشرا فيه؛ لم يعين واحدا: لم يختص بمعين.\n\n  - **معنى البيت:** حد النكرة.\n\n- **البيت:** فَهُوَ المُنَكَّرُ وَمَهْمَا تُرِدِ / تَقْرِيبَ حَدِّهِ لِفَهْمِ المُبْتَدِي\n\n  - **تفكيك العبارات:** فهو المنكر: فهو النكرة؛ مهما ترد: مهما ترد؛ تقريب حده: تيسير تعريفه؛ للمبتدي: للمبتدئ.\n\n  - **معنى البيت:** تسمية النكرة وتيسير حدها.\n\n- **البيت:** فَكُلُّ مَا لِلْأَلِفِ وَاللَّامِ يَصْلُحْ / كَالْفَرَسِ وَالْغُلَامِ\n\n  - **تفكيك العبارات:** ما للألف واللام يصلح: ما يقبل أل؛ كالفرس والغلام: مثالان يراد أصلهما.\n\n  - **معنى البيت:** علامة النكرة.\n\n- **البيت:** هَذَا وَإِنَّ العَطْفَ أَيْضاً تَابِعُ / حُرُوفُهُ عَشَرَةٌ يَا سَامِعُ\n\n  - **تفكيك العبارات:** أيضا تابع: من التوابع؛ يا سامع: تنبيه للمتلقي.\n\n  - **معنى البيت:** العطف من التوابع وحصر حروفه.\n\n- **البيت:** الوَاوُ وَالفَاءُ وَثُمَّ أَوْ وَأَمْ / إِمَّا وَبَلْ لا وَلَكِنْ حَتَّى\n\n  - **تفكيك العبارات:** سرد الحروف العشرة.\n\n  - **معنى البيت:** تعداد حروف العطف.\n\n- **البيت:** فَاجْهَدْ تُصِبْ جَاءَ زَيْدٌ وَمُحَمَّدُ / وَقَدْ سَقَيْتُ عَمْراً وَسَعِيداً مِنْ ثَمَدْ\n\n  - **تفكيك العبارات:** فاجهد تصب: أمر بالاجتهاد؛ من ثمد: من الماء القليل.\n\n  - **معنى البيت:** العطف في المرفوع والمنصوب.\n\n- **البيت:** وَقَوْلُ خَالِدٍ وَعَامِرٍ سَدَدْ / وَمَنْ يَتُبْ وَيَسْتَقِمْ يَرْقَ الرَّشَدْ\n\n  - **تفكيك العبارات:** سدد: صواب؛ يرق الرشد: ينال الرشاد.\n\n  - **معنى البيت:** العطف في المجرور والمجزوم.\n\n## 3. أقسام المعرفة\n\nالمعرفة في النظم خمسة: الضمير وهو ما وضع للحضور أو الغيبة، والعلم وهو ما يعين مسماه مطلقا بلا قرينة، وذو الأداة وهو المحلى بأل، والاسم المبهم وهو اسم الإشارة، والمضاف إلى أحد هذه الأربعة.\n\nواستدرك الشيخ أن المعارف في الحقيقة سبعة بإضافة الاسم الموصول والمنادى المعين وهو النكرة المقصودة التي تعرفت بقرينة النداء.\n\n\n- **مثال الضمير:** (أنا طالبٌ).\n- **مثال العلم:** (محمدٌ مجتهدٌ).\n- **مثال ذي الأداة:** (الكتابُ مفيدٌ).\n- **مثال المبهم:** إشارة (هذا طالبٌ)، موصول (الذي حضر فازَ).\n- **مثال المضاف لمعرفة:** (كتابُ زيدٍ جديدٌ).\n\n## 4. حد النكرة وعلامتها\n\nالنكرة غير محصورة فتحد ولا تعد: وهي الاسم الشائع في جنسه الذي لا يختص بواحد معين. وعلامتها قبول أل المؤثرة للتعريف أو وقوع الاسم موقع ما يقبلها كذو بمعنى صاحب.\n\nومثال الناظم كالفرس والغلام يرمز إلى قبول الأصل لأل قبل دخولها، لا إلى الكلمتين معرفتين.\n\n\n- **مثال النكرة:** (رجلٌ عند البابِ) — يقبل أل: الرجل.\n\n## 5. العطف بنوعيه\n\nالعطف لغة الإمالة، واصطلاحا قسمان: عطف بيان وهو التابع الجامد الموضح وتركه الناظم اختصارا، وعطف نسق وهو ما توسط بينه وبين متبوعه حرف عطف.\n\n## 6. معاني حروف العطف\n\nالواو لمطلق الجمع والتشريك لا للترتيب، والفاء للترتيب والتعقيب، وثم للترتيب مع التراخي، وأو لمعان بحسب السياق، وإما الثانية ليست عاطفة بنفسها بل العاطف الواو معها، وبل للإضراب، ولكن الساكنة بعد النفي والنهي، وحتى للغاية بشرطيها، ولا بعد الإيجاب والأمر، وأم لطلب التعيين بعد همزة التسوية أو الاستفهام.\n\n\n- **مثال حروف العطف:** الواو (جاء زيدٌ وعمروٌ)، الفاء (جاء زيدٌ فعمروٌ)، ثم (جاء زيدٌ ثم عمروٌ)، أو (خذ قلماً أو كتاباً)، أم (أزيدٌ عندك أم عمروٌ؟)، إما (جاء إما زيدٌ وإما عمروٌ)، بل (ما جاء زيدٌ بل عمروٌ)، لا (جاء زيدٌ لا عمروٌ)، لكن (ما جاء زيدٌ لكنْ عمروٌ)، حتى (أكلتُ السمكةَ حتى رأسَها).\n\n## 7. التطبيق الإعرابي\n\nطبق الناظم العطف على الأحوال الأربع: الرفع والمنصوب والمجرور والمجزوم. وأصلح مثاله للجزم إذ عطف الفعل المجزوم على المجزوم بحرف العطف مجردا، بخلاف تمثيل ابن آجروم بلم يقم ولم يقعد.\n\n## خلاصة الدرس\n\nالمعرفة تعد ولا تحد وهي سبعة في الحقيقة، والنكرة تحد بعلامة أل، والعطف نسق بحروف عشرة لكل معنى، وتطبيقاته على الأحوال الأربع.","evidences":[{"type":"quran","text":"﴿وَادْخُلُوا الْبَابَ سُجَّدًا وَقُولُوا حِطَّةٌ﴾","reference":"سورة البقرة: 58 (الواو لا تقتضي الترتيب)"},{"type":"quran","text":"﴿وَقُولُوا حِطَّةٌ وَادْخُلُوا الْبَابَ سُجَّدًا﴾","reference":"سورة الأعراف: 161 (الواو لا تقتضي الترتيب)"},{"type":"quran","text":"﴿أَمَاتَهُ فَأَقْبَرَهُ * ثُمَّ إِذَا شَاءَ أَنشَرَهُ﴾","reference":"سورة عبس: 21-22 (الفاء وثم)"},{"type":"quran","text":"﴿وَمَا كَفَرَ سُلَيْمَانُ وَلَٰكِنَّ الشَّيَاطِينَ كَفَرُوا﴾","reference":"سورة البقرة: 102 (معنى الاستدراك)"},{"type":"quran","text":"﴿وَإِنْ أَدْرِي أَقَرِيبٌ أَم بَعِيدٌ مَّا تُوعَدُونَ﴾","reference":"سورة الأنبياء: 109 (أم)"},{"type":"quran","text":"﴿وَإِن تُؤْمِنُوا وَتَتَّقُوا يُؤْتِكُمْ أُجُورَكُمْ﴾","reference":"سورة محمد: 36 (عطف المجزوم)"}],"scholars":[],"benefits":["المعرفة تعد ولا تحد والنكرة تحد ولا تعد.","المعارف سبعة بإضافة الموصول والمنادى المعين.","علامة النكرة قبول أل أو موقعها.","الواو لمطلق الجمع دون ترتيب.","إما الثانية ليست عاطفة بنفسها.","مثال الناظم للجزم أصلح من مثال ابن آجروم."],"terms":[{"term":"التعريف بالعد","definition":"حصر الشيء بعد أقسامه دون حد جامع مانع."},{"term":"الضرورة الشعرية","definition":"ما يباح للشاعر من مخالفة القياس كقصر الممدود."},{"term":"عطف البيان","definition":"التابع الجامد الموضح لما قبله."},{"term":"عطف النسق","definition":"التابع بواسطة حرف عطف."},{"term":"التراخي","definition":"المهلة الزمنية بين المعطوفين مع ثم."}],"mindMap":{"title":"المعرفة والعطف","branches":[{"title":"المعرفة","items":["خمسة في النظم","سبعة في الحقيقة","الأمثلة"]},{"title":"النكرة","items":["الحد","علامة أل","مثال ذو"]},{"title":"العطف","items":["بيان ونسق","الحروف العشرة","التطبيقات الأربع"]}]},"summaryTable":{"headers":["الباب","الضابط","مثال"],"rows":[["المعرفة","الحصر بالعدد","أنا وهند والغلام"],["النكرة","قبول أل","فرس ورجل"],["العطف","حرف من العشرة","جاء زيد ومحمد"]]},"video":{"url":"https://www.youtube.com/watch?v=vacrRcY2EW0","title":"شرح نظم الآجرومية // 08 // الشيخ محمد محمود الشنقيطي"}},"questions":[{"q":"لم عرفت المعرفة بالعد؟","options":["لأنها غير محصورة","للتطويل","لا سبب","لأن المحصور لا يحتاج إلى حد"],"answer":3},{"q":"كم المعارف في الحقيقة مع الاستدراك؟","options":["خمسة","ستة","سبعة","ثمانية"],"answer":0},{"q":"ما علامة النكرة؟","options":["التنوين فقط","قبول أل","النداء فقط","لا علامة لها"],"answer":1},{"q":"ما معنى الواو العاطفة على الصواب؟","options":["الترتيب دائما","المعية دائما","مطلق الجمع دون ترتيب","النفي"],"answer":2},{"q":"ما الفرق بين الفاء وثم؟","options":["الفاء للتعقيب وثم للتراخي","لا فرق","ثم للتعقيب","الفاء للتراخي"],"answer":0},{"q":"لم كان مثال الناظم للجزم أصلح؟","options":["لأنه أطول","لأنه عطف مجرد بحرف العطف","لأنه شعر","لا فرق"],"answer":1}]},{"id":"ajr-09","order":10,"title":"الدرس 09: التوكيد والبدل والمفعول به","chapter":"التوكيد والمفعول","summary":"تعريف التوكيد وأنواعه وألفاظه، وتعريف البدل وأقسامه الأربعة، ثم المفعول به وأقسامه.","content":{"objectives":["أن يعرف الطالب التوكيد وفائدته.","أن يعدد ألفاظ التوكيد المعنوي.","أن يشرح أقسام البدل الأربعة.","أن يبين أقسام المفعول به."],"matn":"وَيَتْبَعُ المَؤُكَّدَ التَّوْكِيدُ فِي ۞ رَفْعٍ وَنَصْبٍ ثُمَّ خَفْضٍ فَاعْرِفِ\nكَذَاكَ فِي التَّعْرِيفِ فَاقْفُ الأَثَرَا ۞ وَهَذِهِ أَلْفَاظُهُ كَمَا تَرَى\nالنَّفْسُ وَالعَيْنُ وَكُلٌّ أَجْمَعُ ۞ وَمَا لِأَجْمَعَ لَدَيْهِمْ يَتْبَعُ\nكَمَا جَاءَ زَيْدٌ نَفْسُهُ يَصِلُ ۞ وَإِنَّ قَوْمِي كُلَّهُمْ عُدُولُ\nوَمَرَّ بِالقَوْمِ أَجْمَعِينَا ۞ مِثَالاً حَسَناً مُبِينَا\nإِذَا اسْمٌ ابْدِلَ مِنْ اسْمٍ يَنْحَلِ ۞ إِعْرَابَهُ وَالفِعْلُ أَيْضاً يُبْدَلُ\nأَقْسَامُهُ أَرْبَعَةٌ فَإِنْ تُرِدْ ۞ إِحْصَاءَهَا فَاسْمَعْ لِقَوْلِي تَسْتَفِدْ\nبَدَلُ الشَّيْءِ مِنَ الشَّيْءِ كَذَا ۞ سُرُورِي بِهِ جَاءَ وَبَدَلُ البَعْضِ بَدَا\nمِنَ الكُلِّ كَمَنْ يَأْكُلْ رَغِيفاً نِصْفَهُ ۞ يُعْطِ الثُّمُنَ\nبَدَلُ الاشْتِمَالِ نَحْوُ رَاقَنِي ۞ مُحَمَّدٌ جَمَالُهُ\nوَبَدَلُ الغَلَطِ نَحْوُ قَدْ رَكِبْ ۞ حِمَاراً فَرَسَا\nمَهْمَا تَرَ اسْماً وَاقِعاً الفِعْلُ بِهِ ۞ فَذَاكَ مَفْعُولٌ فَنَصْبَهُ انْسُبِ\nكَمِثْلِ زُرْتُ العَالِمَ الأَدِيبَا ۞ وَقَدْ رَكِبْتُ الفَرَسَ النَّجِيبَا\nظَاهِراً يَأْتِي وَيَأْتِي مُضْمَرَا ۞ فَالأَوَّلُ المِثَالُ مَا ذُكِرَا\nوَالثَّانِي قُلْ مُتَّصِلٌ وَمُنْفَصِلْ ۞ كَزَارَنِي أَخِي وَإِيَّاهُ أُصِلْ","briefExplanation":"التوكيد تابع يرفع احتمال المجاز أو عدم الشمول بألفاظ معلومة. والبدل تابع مقصود بالحكم بأنواعه الأربعة. والمفعول به اسم فضلة وقع عليه الفعل ظاهرا أو مضمرا متصلا أو منفصلا.","detailedExplanation":"## 1. تعريف التوكيد وفائدته\n\nالتوكيد اصطلاحا التابع الذي يعقد به حمل الكلام على ظاهره ويرفع احتمال المجاز أو عدم الشمول. ويقال أكد بالهمز ووكد بالواو وهما لغتان.\n\n## 2. ألفاظ أبيات الدرس بيتاً بيتاً\n> منهج هذا الدرس: نبدأ بألفاظ الأبيات بيتاً بيتاً، ثم نبسط معناها العام وقواعدها.\n\n\nفي هذا القسم نفكك كلمات كل بيت وعباراته أولا، ثم نذكر معناه إجمالا.\n\n- **البيت:** وَيَتْبَعُ المَؤُكَّدَ التَّوْكِيدُ فِي / رَفْعٍ وَنَصْبٍ ثُمَّ خَفْضٍ فَاعْرِفِ\n\n  - **تفكيك العبارات:** يتبع المؤكد: يتبع ما أكد؛ فاعرف: فاعرف ذلك.\n\n  - **معنى البيت:** تبعية التوكيد في الإعراب.\n\n- **البيت:** كَذَاكَ فِي التَّعْرِيفِ فَاقْفُ الأَثَرَا / وَهَذِهِ أَلْفَاظُهُ كَمَا تَرَى\n\n  - **تفكيك العبارات:** كذاك: وكذلك؛ فاقف الأثرا: اتبع أثر العلماء؛ كما ترى: كما تشاهد.\n\n  - **معنى البيت:** تبعيته في التعريف وألفاظه.\n\n- **البيت:** النَّفْسُ وَالعَيْنُ وَكُلٌّ أَجْمَعُ / وَمَا لِأَجْمَعَ لَدَيْهِمْ يَتْبَعُ\n\n  - **تفكيك العبارات:** لديهم: عند النحاة؛ ما لأجمع يتبع: توابع أجمع.\n\n  - **معنى البيت:** ألفاظ التوكيد.\n\n- **البيت:** كَمَا جَاءَ زَيْدٌ نَفْسُهُ يَصِلُ / وَإِنَّ قَوْمِي كُلَّهُمْ عُدُولُ\n\n  - **تفكيك العبارات:** نفسه: توكيد الذات؛ كلهم: توكيد الشمول؛ عدول: جمع عدل.\n\n  - **معنى البيت:** مثالا النفس وكل.\n\n- **البيت:** وَمَرَّ بِالقَوْمِ أَجْمَعِينَا / مِثَالاً حَسَناً مُبِينَا\n\n  - **تفكيك العبارات:** أجمعينا: توكيد مجرور؛ مثالا حسنا مبينا: مثال واضح.\n\n  - **معنى البيت:** مثال أجمع.\n\n- **البيت:** إِذَا اسْمٌ ابْدِلَ مِنْ اسْمٍ يَنْحَلِ / إِعْرَابَهُ وَالفِعْلُ أَيْضاً يُبْدَلُ\n\n  - **تفكيك العبارات:** أبدل: جعل بدلا؛ ينحل إعرابه: يأخذ إعرابه.\n\n  - **معنى البيت:** تعريف البدل وحكمه.\n\n- **البيت:** أَقْسَامُهُ أَرْبَعَةٌ فَإِنْ تُرِدْ / إِحْصَاءَهَا فَاسْمَعْ لِقَوْلِي تَسْتَفِدْ\n\n  - **تفكيك العبارات:** فإن ترد: فإن ترد؛ تستفد: تستفد.\n\n  - **معنى البيت:** حصر الأقسام.\n\n- **البيت:** بَدَلُ الشَّيْءِ مِنَ الشَّيْءِ كَذَا / سُرُورِي بِهِ جَاءَ وَبَدَلُ البَعْضِ بَدَا\n\n  - **تفكيك العبارات:** بدا: ظهر؛ مثالا النوعين الأولين.\n\n  - **معنى البيت:** بدلا المطابقة والبعض.\n\n- **البيت:** مِنَ الكُلِّ كَمَنْ يَأْكُلْ رَغِيفاً نِصْفَهُ / يُعْطِ الثُّمُنَ\n\n  - **تفكيك العبارات:** من الكل: من الكل؛ يعط الثمن: يعطي الثمن.\n\n  - **معنى البيت:** مثال بدل البعض.\n\n- **البيت:** بَدَلُ الاشْتِمَالِ نَحْوُ رَاقَنِي / مُحَمَّدٌ جَمَالُهُ\n\n  - **تفكيك العبارات:** راقني: أعجبني؛ جماله: بدل الاشتمال.\n\n  - **معنى البيت:** مثال الاشتمال.\n\n- **البيت:** وَبَدَلُ الغَلَطِ نَحْوُ قَدْ رَكِبْ / حِمَاراً فَرَسَا\n\n  - **تفكيك العبارات:** الغلط: سبق اللسان؛ حمارا فرسا: تصحيح الغلط.\n\n  - **معنى البيت:** مثال الغلط.\n\n- **البيت:** مَهْمَا تَرَ اسْماً وَاقِعاً الفِعْلُ بِهِ / فَذَاكَ مَفْعُولٌ فَنَصْبَهُ انْسُبِ\n\n  - **تفكيك العبارات:** مهما تر: متى ما رأيت؛ واقعا الفعل به: واقعا عليه الفعل؛ انسب: انسب له النصب.\n\n  - **معنى البيت:** تعريف المفعول به وحكمه.\n\n- **البيت:** كَمِثْلِ زُرْتُ العَالِمَ الأَدِيبَا / وَقَدْ رَكِبْتُ الفَرَسَ النَّجِيبَا\n\n  - **تفكيك العبارات:** العالم الأديب: مثال العاقل؛ الفرس النجيب: مثال غير العاقل.\n\n  - **معنى البيت:** تنويع الأمثلة.\n\n- **البيت:** ظَاهِراً يَأْتِي وَيَأْتِي مُضْمَرَا / فَالأَوَّلُ المِثَالُ مَا ذُكِرَا\n\n  - **تفكيك العبارات:** ظاهرا ومضمرا: نوعاه؛ الأول المثال ما ذكرا: ما تقدم.\n\n  - **معنى البيت:** نوعا المفعول به.\n\n- **البيت:** وَالثَّانِي قُلْ مُتَّصِلٌ وَمُنْفَصِلْ / كَزَارَنِي أَخِي وَإِيَّاهُ أُصِلْ\n\n  - **تفكيك العبارات:** متصل ومنفصل: قسما المضمر؛ زارني: مثال المتصل؛ إياه أصل: مثال المنفصل أي أصل رحمه.\n\n  - **معنى البيت:** قسما المضمر ومثالاهما.\n\n## 3. أنواعه وأحكامه\n\nالتوكيد اللفظي إعادة اللفظ أهمله الناظم اختصارا، والمعنوي هو المقصود ويقع بألفاظ معلومة. ويتبع المؤكد في الرفع والنصب والخفض دون الجزم لأنه خاص بالأسماء، وفي التعريف على مذهب الجمهور.\n\n## 4. ألفاظه وأمثلته\n\nالنفس والعين لرفع احتمال المجاز في الذات، وكل وأجمع لرفع احتمال عدم الشمول، وتوابع أجمع كأكتع وأبتع وأبصع لتقوية التوكيد. والأمثلة جاء زيد نفسه وإن قومي كلهم عدول ومر بالقوم أجمعين.\n\n\n- **مثال النفس والعين:** (جاء زيدٌ نفسُه)، (حضر الأميرُ عينُه).\n- **مثال كل:** (حضر الطلابُ كلُّهم).\n- **مثال أجمع:** (جاء الجيشُ أجمعُ).\n- **مثال كلا وكلتا:** (جاء الطالبان كلاهما)، (حضرت الطالبتان كلتاهما).\n\n## 5. البدل وأقسامه\n\nالبدل لغة العوض، واصطلاحا التابع المقصود بالحكم بلا واسطة. ويبدل الفعل من الفعل كما يبدل الاسم من الاسم. وأقسامه: بدل الشيء من الشيء، وبدل البعض من الكل، وبدل الاشتمال، وبدل الغلط الذي لا يقع في الفصيح.\n\n\n- **مثال البدل المطابق:** (جاء أخوك زيدٌ).\n- **مثال بدل البعض:** (أكلتُ الرغيفَ نصفَه).\n- **مثال بدل الاشتمال:** (أعجبني زيدٌ علمُه).\n- **مثال بدل الغلط:** (ركبتُ حماراً فرساً).\n\n## 6. المفعول به\n\nالمفعول به اصطلاحا الاسم الفضلة الذي وقع عليه فعل الفاعل. والفعل المتعدي ما ينصبه بعلامتي هاء المفعول وصحة اسم المفعول التام. ويأتي ظاهرا ومضمرا متصلا ومنفصلا باثنتي عشرة صيغة لكل.\n\n\n- **مثال المفعول به الظاهر:** (قرأتُ الكتابَ).\n- **مثال المفعول المضمر:** متصل (زارني أخي)، منفصل (إياكَ نعبدُ).\n\n## خلاصة الدرس\n\nالتوكيد يرفع الاحتمال بألفاظ معلومة، والبدل مقصود بالحكم بأنواعه، والمفعول به فضلة ظاهرة أو مضمرة.","evidences":[{"type":"quran","text":"﴿وَمَن يَفْعَلْ ذَلِكَ يَلْقَ أَثَامًا * يُضَاعَفْ لَهُ الْعَذَابُ﴾","reference":"سورة الفرقان: 68-69 (إبدال الفعل)"},{"type":"quran","text":"﴿اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ * صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ﴾","reference":"سورة الفاتحة: 6-7 (بدل الشيء)"},{"type":"quran","text":"﴿وَلِلَّهِ عَلَى النَّاسِ حِجُّ الْبَيْتِ مَنِ اسْتَطَاعَ إِلَيْهِ سَبِيلًا﴾","reference":"سورة آل عمران: 97 (بدل البعض)"},{"type":"quran","text":"﴿يَسْأَلُونَكَ عَنِ الشَّهْرِ الْحَرَامِ قِتَالٍ فِيهِ﴾","reference":"سورة البقرة: 217 (بدل الاشتمال)"},{"type":"quran","text":"﴿قُتِلَ أَصْحَابُ الْأُخْدُودِ * النَّارِ ذَاتِ الْوَقُودِ﴾","reference":"سورة البروج: 4-5 (بدل الاشتمال)"}],"scholars":[],"benefits":["التوكيد يرفع احتمال المجاز أو عدم الشمول.","أكّد ووكّد لغتان صحيحتان.","الجزم لا يدخل التوكيد المعنوي.","توكيد النكرة محل خلاف.","البدل مقصود بالحكم بلا واسطة.","الغلط لا يقع في الفصيح.","المفعول به ظاهر ومضمر بصيغ معلومة."],"terms":[{"term":"التوكيد","definition":"التابع الذي يرفع احتمال المجاز أو عدم الشمول."},{"term":"البدل","definition":"التابع المقصود بالحكم بلا واسطة."},{"term":"بدل الغلط","definition":"ما وقع لسبق اللسان ثم استدرك بالصواب."},{"term":"الفعل المتعدي","definition":"ما نصب المفعول به."},{"term":"الفعل اللازم","definition":"ما لا ينصب المفعول به."}],"mindMap":{"title":"التوكيد والبدل والمفعول","branches":[{"title":"التوكيد","items":["التعريف","اللفظي والمعنوي","الألفاظ"]},{"title":"البدل","items":["التعريف","الأقسام الأربعة","إبدال الفعل"]},{"title":"المفعول به","items":["التعريف","الظاهر","المضمر"]}]},"summaryTable":{"headers":["الباب","الضابط","مثال"],"rows":[["التوكيد","الاتباع في الإعراب والتعريف","جاء زيد نفسه"],["البدل","مقصود بالحكم","اهدنا الصراط صراط الذين"],["المفعول به","فضلة وقع عليه الفعل","زرت العالم"]]},"video":{"url":"https://www.youtube.com/watch?v=EABX_lggExQ","title":"شرح نظم الآجرومية // 09 // الشيخ محمد محمود الشنقيطي"}},"questions":[{"q":"ما فائدة التوكيد؟","options":["تغيير المعنى","حذف الفاعل","بناء الفعل","رفع احتمال المجاز أو عدم الشمول"],"answer":3},{"q":"لم لم يذكر الجزم في تبعية التوكيد؟","options":["لأنه خاص بالأسماء","نسيانا","لأنه حرف","لا سبب"],"answer":0},{"q":"ما حكم توكيد النكرة عند الجمهور؟","options":["الجواز مطلقا","المنع","الوجوب","الكراهة"],"answer":1},{"q":"أين يقع بدل الغلط؟","options":["في القرآن","في الحديث","في كلام البشر العادي فقط","في الشعر الموزون"],"answer":2},{"q":"ما علامتا الفعل المتعدي؟","options":["هاء المفعول واسم المفعول التام","التنوين وأل","السين وسوف","الرفع والنصب"],"answer":0},{"q":"كم صيغ الضمير المتصل للمفعول؟","options":["اثنتا عشرة","عشر","خمس","سبع"],"answer":1}]},{"id":"ajr-10","order":11,"title":"الدرس 10: المفعول المطلق والظرف والحال","chapter":"المطلق والظرف والحال","summary":"المصدر وأغراضه وأنواعه، والظرف بنوعيه وشروطه، والحال وأمثلتها وشروطها ومسوغات تنكير صاحبها.","content":{"objectives":["أن يعرف الطالب المصدر وأغراض المفعول المطلق.","أن يميز المصدر اللفظي من المعنوي.","أن يشرح الظرف بنوعيه وشروطه.","أن يبين شروط الحال وصاحبها."],"matn":"المَصْدَرُ اسْمٌ جَاءَ ثَالِثاً لَدَى ۞ تَصْرِيفِ فِعْلٍ وَانْتِصَابُهُ بَدَا\nوَهُوَ لَدَى كُلِّ فَتًى حَوَى الجَلَا ۞ مَا بَيْنَ لَفْظِيٍّ وَمَعْنَوِيٍّ جَلَا\nفَذَاكَ مَا وَافَقَ لَفْظَ فِعْلِهِ ۞ زِيَارَةً لِفَضْلِهِ إذْ وَافَقَا\nوالمَعْنَوِي المُوافِقُ المَعْنَى بِلا ۞ وَفَاقِ لَفْظٍ هَكَذَا قَدْ نُقِلَا\nوَالظَّرْفُ مَنْصُوبٌ عَلَى إِضْمَارِ فِي ۞ وَهْوَ زَمَانِيٌّ وَمَكَانِيٌّ يَفِي\nأَمَّا الزَّمَانِيُّ فَنَحْوُ مَا تَرَى ۞ اليَوْمَ وَاللَّيْلَةَ ثُمَّ سَحَرَا\nوَغُدْوَةً وَبُكْرَةً غَداً حِينَا ۞ وَوَقْتاً أَبَداً وَأَمَداً حِينَا\nمَسَاءً وَصَبَاحاً اسْتَعْمِلِ ۞ بَغْيَةَ أَنْ تَنَالَ خَيْرَ أَمَلِ\nثُمَّ المَكَانِيُّ مِثَالُهُ الجَلِي ۞ أَمَامَ قُدَّامَ وَخَلْفَ يَلِي\nوَرَاءَ فَوْقَ تَحْتَ عِنْدَ مَعْ إِزَاءَا ۞ تِلْقَاءَ ثَمَّ وَهُنَا حِذَاءَا\nالحَالُ لِلْهَيْئَاتِ مِمَّا انْبَهَمَا ۞ مُفَسِّرٌ وَنَصْبُهُ حَتْماً نَمَا\nكَـ جَاءَ زَيْدٌ ضَاحِكاً مُبْتَهِجَا ۞ وَبَاعَ بَكْرٌ الحِصَانَ مُسْرَجَا\nوَإِنَّنِي لَقِيتُ عَمْراً رَائِداً ۞ فَاعْلَمْ مِثَالاً وَافْهَمِ المَقَاصِدَا","briefExplanation":"المصدر اسم الحدث المجرد عن الزمان وهو المفعول المطلق الحقيقي، ويأتي لثلاثة أغراض وينقسم إلى لفظي ومعنوي. والظرف اسم الزمان أو المكان المنصوب بتقدير في، والزمان كله يقبله والمكان يشترط إبهامه. والحال وصف فضلة منصوب يبين الهيئة بشروط في الحال وصاحبها.","detailedExplanation":"## 1. المصدر وحقيقته\n\nالمصدر لغة واصطلاحا هو الاسم الدال على الحدث مجردا عن الزمان، وهو أصل الفعل وأحد مدلوليه. وهو الاسم الذي يجيء ثالثا عند تصريف الفعل.\n\nوقدم الناظم حده ثم أورد حكمه إصلاحا لما وقع فيه ابن آجروم من إدخال الأحكام في التعريفات.\n\n## 2. ألفاظ أبيات الدرس بيتاً بيتاً\n> منهج هذا الدرس: نبدأ بألفاظ الأبيات بيتاً بيتاً، ثم نبسط معناها العام وقواعدها.\n\n\nفي هذا القسم نفكك كلمات كل بيت وعباراته أولا، ثم نذكر معناه إجمالا.\n\n- **البيت:** المَصْدَرُ اسْمٌ جَاءَ ثَالِثاً لَدَى / تَصْرِيفِ فِعْلٍ وَانْتِصَابُهُ بَدَا\n\n  - **تفكيك العبارات:** جاء ثالثا لدى تصريف فعل: الثالث في التصريف؛ انتصابه بدا: ظهر حكمه.\n\n  - **معنى البيت:** تعريف المصدر وحكمه.\n\n- **البيت:** وَهُوَ لَدَى كُلِّ فَتًى حَوَى الجَلَا / مَا بَيْنَ لَفْظِيٍّ وَمَعْنَوِيٍّ جَلَا\n\n  - **تفكيك العبارات:** لدى كل فتى: عند كل شاب عالم؛ حوى الجلا: حاز الوضوح.\n\n  - **معنى البيت:** قسمة المصدر.\n\n- **البيت:** فَذَاكَ مَا وَافَقَ لَفْظَ فِعْلِهِ / زِيَارَةً لِفَضْلِهِ إذْ وَافَقَا\n\n  - **تفكيك العبارات:** ما وافق لفظ فعله: اللفظي؛ زيارة لفضله: مثال.\n\n  - **معنى البيت:** المصدر اللفظي ومثاله.\n\n- **البيت:** والمَعْنَوِي المُوافِقُ المَعْنَى بِلا / وَفَاقِ لَفْظٍ هَكَذَا قَدْ نُقِلَا\n\n  - **تفكيك العبارات:** بلا وفاق لفظ: دون موافقة اللفظ؛ هكذا نقلا: هكذا نقل.\n\n  - **معنى البيت:** المصدر المعنوي.\n\n- **البيت:** وَالظَّرْفُ مَنْصُوبٌ عَلَى إِضْمَارِ فِي / وَهْوَ زَمَانِيٌّ وَمَكَانِيٌّ يَفِي\n\n  - **تفكيك العبارات:** على إضمار في: بتقدير في؛ يفي: يفي بالغرض.\n\n  - **معنى البيت:** تعريف الظرف ونوعاه.\n\n- **البيت:** أَمَّا الزَّمَانِيُّ فَنَحْوُ مَا تَرَى / اليَوْمَ وَاللَّيْلَةَ ثُمَّ سَحَرَا\n\n  - **تفكيك العبارات:** ف نحو ما ترى: فمثل ما ترى.\n\n  - **معنى البيت:** أمثلة ظرف الزمان.\n\n- **البيت:** وَغُدْوَةً وَبُكْرَةً غَداً حِينَا / وَوَقْتاً أَبَداً وَأَمَداً حِينَا\n  - **تفكيك العبارات:** تتمة الأمثلة الزمانية.\n  - **معنى البيت:** تتمة الأمثلة.\n- **البيت:** مَسَاءً وَصَبَاحاً اسْتَعْمِلِ / بَغْيَةَ أَنْ تَنَالَ خَيْرَ أَمَلِ\n  - **تفكيك العبارات:** استعمل: استعملهما؛ بغية أن تنال: لأجل أن تنال؛ خير أمل: خير رجاء.\n  - **معنى البيت:** الحث على استعمالها.\n- **البيت:** وَرَاءَ فَوْقَ تَحْتَ عِنْدَ مَعْ إِزَاءَا / تِلْقَاءَ ثَمَّ وَهُنَا حِذَاءَا\n  - **تفكيك العبارات:** تتمة ظروف المكان المبهمة.\n  - **معنى البيت:** تتمة الأمثلة.\n- **البيت:** ثُمَّ المَكَانِيُّ مِثَالُهُ الجَلِي / أَمَامَ قُدَّامَ وَخَلْفَ يَلِي\n\n  - **تفكيك العبارات:** مثاله الجلي: مثاله الواضح؛ يلي: يتبع.\n\n  - **معنى البيت:** أمثلة ظرف المكان.\n\n- **البيت:** الحَالُ لِلْهَيْئَاتِ مِمَّا انْبَهَمَا / مُفَسِّرٌ وَنَصْبُهُ حَتْماً نَمَا\n\n  - **تفكيك العبارات:** مما انبهما: مما انبهم؛ مفسر: مفسِّر لها؛ حتما نما: ظهر وجوبا.\n\n  - **معنى البيت:** تعريف الحال وحكمها.\n\n- **البيت:** كَجَاءَ زَيْدٌ ضَاحِكاً مُبْتَهِجَا / وَبَاعَ بَكْرٌ الحِصَانَ مُسْرَجَا\n\n  - **تفكيك العبارات:** مثالا الحال من الفاعل والمفعول.\n\n  - **معنى البيت:** تعدد الحال ومحلها.\n\n- **البيت:** وَإِنَّنِي لَقِيتُ عَمْراً رَائِداً / فَاعْلَمْ مِثَالاً وَافْهَمِ المَقَاصِدَا\n\n  - **تفكيك العبارات:** رائدا: الباحث عن الكلأ؛ فافهم المقاصد: فافهم المقاصد.\n\n  - **معنى البيت:** الحال المحتملة.\n\n## 3. علة المفعول المطلق وأغراضه\n\nالمصدر هو المفعول المطلق الوحيد لأنه المفعول الحقيقي الذي أحدثه الفاعل دون قيد. ويساق لثلاثة أغراض: تأكيد عامله، وبيان نوعه، وبيان عدده.\n\n\n- **مثال المطلق المؤكد:** (ضربتُ ضرباً).\n- **مثال المبين للنوع:** (جلستُ جلسةَ الأميرِ).\n- **مثال المبين للعدد:** (سجدتُ سجدتينِ).\n\n## 4. اللفظي والمعنوي\n\nالمصدر اللفظي ما وافق لفظ فعله، والمعنوي ما وافق معناه دون لفظه. ولاحظ الشيخ أن الثاني يعده الجمهور نائبا عن المصدر.\n\n\n- **مثال المعنوي:** (جلستُ قعوداً)، (فرحتُ سروراً).\n\n## 5. الظرف بنوعيه\n\nالظرف لغة الوعاء، واصطلاحا اسم الزمان أو المكان المنصوب بتقدير في باطراد. وأسماء الزمان كلها مبهمة ومختصة تقبل الظرفية لأن الزمان جزء من مدلول الفعل.\n\nويشترط في ظرف المكان الإبهام كالجهات الست، أما المختص كالدار والمسجد فلا ينتصب على الظرفية بل يجر بفي، وما ورد منصوبا فعلى التوسع بإسقاط الخافض. وفي ثم الدالة على التراخي إشارة إلى أن الزمان أمكن في الظرفية من المكان.\n\n\n- **مثال ظرف الزمان:** (صمتُ يومَ الخميسِ).\n- **مثال ظرف المكان:** (جلستُ أمامَ المسجدِ).\n\n## 6. الحال وأمثلتها\n\nالحال لغة ما عليه الشيء، واصطلاحا الوصف الفضلة المنصوب المفسر لما انبهم من الهيئات. وتأتي من الفاعل ومن المفعول به وتحتمل الأمرين وتتعدد لصاحب واحد.\n\n\n- **مثال الحال:** (جاء زيدٌ ضاحكاً)، (ركبتُ الفرسَ مسرجاً)، (شربتُ الماءَ صافياً).\n\n## 7. شروط الحال وصاحبها\n\nيشترط في الحال التنكير والفضلة. والأصل في صاحبها التعريف لأن الحكم على المجهول لا يفيد، ويستثنى بمسوغات منها العموم والاستفهام وتقدم الحال والتخصيص. وزاد الناظم لفظة غالبا إصابة للحق.\n\n## خلاصة الدرس\n\nالمصدر أصل الفعل ويأتي لثلاثة أغراض، والظرف بتقدير في بشرطه، والحال فضلة نكرة لصاحب معرفة غالبا.","evidences":[{"type":"quran","text":"﴿وَكَلَّمَ اللَّهُ مُوسَى تَكْلِيمًا﴾","reference":"سورة النساء: 164 (التأكيد)"},{"type":"quran","text":"﴿فَأَخَذْنَاهُمْ أَخْذَ عَزِيزٍ مَّقْتَدِرٍ﴾","reference":"سورة القمر: 42 (بيان النوع)"},{"type":"quran","text":"﴿وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍ ثَمَانِيَةٌ﴾","reference":"سورة الحاقة: 17 (فوق)"},{"type":"quran","text":"﴿إِذْ يُبَايِعُونَكَ تَحْتَ الشَّجَرَةِ﴾","reference":"سورة الفتح: 18 (تحت)"},{"type":"quran","text":"﴿وَلَمَّا تَوَجَّهَ تِلْقَاءَ مَدْيَنَ﴾","reference":"سورة القصص: 22 (تلقاء)"},{"type":"quran","text":"﴿وَأَزْلَفْنَا ثَمَّ الْآخَرِينَ﴾","reference":"سورة الشعراء: 64 (ثم)"},{"type":"quran","text":"﴿إِنَّا هَاهُنَا قَاعِدُونَ﴾","reference":"سورة المائدة: 24 (هنا)"},{"type":"quran","text":"﴿وَمَا أَهْلَكْنَا مِن قَرْيَةٍ إِلَّا لَهَا مُنذِرُونَ﴾","reference":"سورة الشعراء: 208 (مسوغ العموم)"},{"type":"quran","text":"﴿فِي فُلْكٍ مَّشْحُونٍ﴾","reference":"سورة يس: 41 (مسوغ التخصيص)"}],"scholars":[],"benefits":["المصدر أصل الفعل وأحد مدلوليه.","المفعول المطلق هو المفعول الحقيقي.","أغراض المطلق ثلاثة.","الزمان كله يقبل الظرفية.","المكان يشترط إبهامه.","الحال نكرة فضلة لصاحب معرفة غالبا."],"terms":[{"term":"المصدر","definition":"الاسم الدال على الحدث مجردا عن الزمان."},{"term":"المفعول المطلق","definition":"المصدر المنصوب المؤكد أو المبين."},{"term":"الظرف","definition":"اسم الزمان أو المكان المنصوب بتقدير في."},{"term":"الحال","definition":"الوصف الفضلة المنصوب المفسر للهيئة."},{"term":"مسوغات التنكير","definition":"ما يجيز مجيء صاحب الحال نكرة."}],"mindMap":{"title":"المطلق والظرف والحال","branches":[{"title":"المصدر","items":["التعريف","الأغراض","اللفظي والمعنوي"]},{"title":"الظرف","items":["التعريف","الزمان","المكان"]},{"title":"الحال","items":["التعريف","الأمثلة","الشروط"]}]},"summaryTable":{"headers":["الباب","الضابط","مثال"],"rows":[["المصدر","اسم الحدث المجرد","تكليما"],["الظرف","بتقدير في","اليوم وأمام"],["الحال","فضلة نكرة منصوبة","ضاحكا"]]},"video":{"url":"https://www.youtube.com/watch?v=0ZKErzFx-sI","title":"شرح نظم الآجرومية // 10 // الشيخ محمد محمود الشنقيطي"}},"questions":[{"q":"لم سمي المصدر مفعولا مطلقا؟","options":["لأنه مقيد","لأنه حرف","لا سبب","لأنه المفعول الحقيقي دون قيد"],"answer":3},{"q":"كم أغراض المفعول المطلق؟","options":["اثنان","ثلاثة","أربعة","خمسة"],"answer":0},{"q":"ما الفرق بين اللفظي والمعنوي؟","options":["الحجم","موافقة اللفظ وعدمها","الزمن","لا فرق"],"answer":1},{"q":"ما شرط ظرف المكان؟","options":["التعريف","التنكير","الإبهام","لا شرط"],"answer":2},{"q":"ما شرط صاحب الحال غالبا؟","options":["التعريف","التنكير","البناء","الإفراد"],"answer":0},{"q":"ما مسوغ تنكير صاحب الحال في آية الشعراء؟","options":["الاستفهام","العموم","التقديم","لا مسوغ"],"answer":1}]},{"id":"ajr-11","order":12,"title":"الدرس 11: التمييز والاستثناء","chapter":"التمييز والاستثناء","summary":"تعريف التمييز وأقسامه، وتعريف الاستثناء وأدواته وأحكام المستثنى بإلا وباقي الأدوات.","content":{"objectives":["أن يعرف الطالب التمييز وأقسامه.","أن يبين شرط تنكير التمييز.","أن يعدد أدوات الاستثناء.","أن يشرح أحكام المستثنى في الأحوال الثلاثة."],"matn":"اسْمٌ مُفَسِّرٌ لِمَا قَدِ انْبَهَمْ ۞ مِنَ الذَّوَاتِ بِاسْمِ تَمْيِيزٍ وَسِمْ\nوَنَصْبُهُ اشْتَهَرْ طَابَ زَيْدٌ نَفْساً ۞ وَلِي عَلَيْهِ أَرْبَعُونَ فَلْساً\nوَخَالِدٌ أَكْرَمُ مِنْ عَمْرٍو أَبَا ۞ وَكَوْنُهُ نَكِرَةً قَدْ وَجَبَا\nإِلاَّ وَغَيْرُ وَسِوَى سُوَىً سَوَا ۞ خَلاَ عَدَا وَحَاشَا الاِسْتِثْنَا حَوَى\nإِذَا الكَلاَمُ تَمَّ وَهْوَ مُوجَبُ ۞ فَمَا أَتَى مِنْ بَعْدِ إِلاَّ يُنْصَبُ\nتَقُولُ قَامَ القَوْمُ إِلاَّ عَمْرَا ۞ وَقَدْ أَتَانِي النَّاسُ إِلاَّ بَكْرَا\nوَإِنْ بِنَفْيٍ وَتَمَامٍ حُلِّيَا ۞ فَأَبْدِلَ اوْ بِالنَّصْبِ جِيءْ مُسْتَثْنِيَا\nكَلَمْ يَقُمْ أَحَدٌ الاَّ صَالِحُ ۞ أَوْ صَالِحًا فَهْوَ لِذَيْنِ صَالِحُ\nأَوْ كَانَ نَاقِصًا فَأَعْرِبْهُ عَلَى ۞ حَسَبِ مَا يَجِيءُ فِيهِ العَمَلاَ\nكَمَا هَدَى إِلاَّ مُحَمَّدٌ وَمَا ۞ عَبَدتُّ إِلاَّ اللهَ فَاطِرَ السَّمَا\nوَهَلْ يَلُوذُ العَبْدُ يَوْمَ الحَشْرِ ۞ إِلاَّ بِأَحْمَدَ شَفِيْعِ البَشَرِ\nوَحُكْمُ مَا اسْتَثْنَتْهُ غَيرُ وَسِوَى ۞ سُوَى سَوَاءٌ أَنْ يُجَرَّ لاَ سِوَى\nوَانْصِبْ أَوِ اجْرُرْ مَا بِحَاشَا وَعَدَا ۞ خَلاَ قَدِ اسْتَثْنَيْتَهُ مُعْتَقِدَا\nفِي حَالَةِ النَّصْبِ بِهَا الفِعْلِيَّهْ ۞ وَحَالَةِ الجَرِّ بِهَا الحَرْفِيَّهْ\nتَقُولُ قَامَ القَوْمُ حَاشَا جَعْفَرَا ۞ أَوْ جَعْفَرٍ فَقِسْ لِكَيْمَا تَظْفَرَا","briefExplanation":"التمييز اسم نكرة فضلة يرفع إبهام الذوات أو النسب، وهو محول وغير محول. والاستثناء إخراج الداخل أو منزلته بأدوات ثمان، وللمستثنى بإلا ثلاثة أحوال، ولباقي الأدوات أحكامها.","detailedExplanation":"## 1. تعريف التمييز\n\nيسمى هذا الباب التمييز والمميز والتفسير والمفسر والتبيين والمبين. وحده أنه اسم نكرة فضلة يرفع إبهام اسم أو إجمال نسبة.\n\n## 2. ألفاظ أبيات الدرس بيتاً بيتاً\n> منهج هذا الدرس: نبدأ بألفاظ الأبيات بيتاً بيتاً، ثم نبسط معناها العام وقواعدها.\n\n\nفي هذا القسم نفكك كلمات كل بيت وعباراته أولا، ثم نذكر معناه إجمالا.\n\n- **البيت:** اسْمٌ مُفَسِّرٌ لِمَا قَدِ انْبَهَمْ / مِنَ الذَّوَاتِ بِاسْمِ تَمْيِيزٍ وَسِمْ\n\n  - **تفكيك العبارات:** مفسر لما انبهم: مزيل للإبهام؛ من الذوات: من الأسماء؛ باسم تمييز وسم: سمه تمييزا.\n\n  - **معنى البيت:** تعريف التمييز.\n\n- **البيت:** وَنَصْبُهُ اشْتَهَرْ طَابَ زَيْدٌ نَفْساً / وَلِي عَلَيْهِ أَرْبَعُونَ فَلْساً\n\n  - **تفكيك العبارات:** ونصبه اشتهر: اشتهر نصبه؛ طاب زيد نفسا: تمييز النسبة؛ أربعون فلسا: تمييز الذات.\n\n  - **معنى البيت:** حكمه ومثالاه.\n\n- **البيت:** وَخَالِدٌ أَكْرَمُ مِنْ عَمْرٍو أَبَا / وَكَوْنُهُ نَكِرَةً قَدْ وَجَبَا\n\n  - **تفكيك العبارات:** أبا: تمييز؛ كونه نكرة قد وجبا: وجوب التنكير.\n\n  - **معنى البيت:** مثال المفاضلة وشرط التنكير.\n\n- **البيت:** إِلاَّ وَغَيْرُ وَسِوَى سُوَىً سَوَا / خَلاَ عَدَا وَحَاشَا الاِسْتِثْنَا حَوَى\n\n  - **تفكيك العبارات:** الاستثنا حوى: حوته أي جمعته؛ سرد الأدوات الثمان.\n\n  - **معنى البيت:** حصر أدوات الاستثناء.\n\n- **البيت:** إِذَا الكَلاَمُ تَمَّ وَهْوَ مُوجَبُ / فَمَا أَتَى مِنْ بَعْدِ إِلاَّ يُنْصَبُ\n\n  - **تفكيك العبارات:** تم: بذكر المستثنى منه؛ موجب: خال من النفي؛ ما أتى: المستثنى.\n\n  - **معنى البيت:** حكم التام الموجب.\n\n- **البيت:** تَقُولُ قَامَ القَوْمُ إِلاَّ عَمْرَا / وَقَدْ أَتَانِي النَّاسُ إِلاَّ بَكْرَا\n\n  - **تفكيك العبارات:** عمرا: متصل؛ بكرا: الفتي من الإبل أي منقطع.\n\n  - **معنى البيت:** مثالا المتصل والمنقطع.\n\n- **البيت:** وَإِنْ بِنَفْيٍ وَتَمَامٍ حُلِّيَا / فَأَبْدِلَ اوْ بِالنَّصْبِ جِيءْ مُسْتَثْنِيَا\n\n  - **تفكيك العبارات:** حلّيا: حلّي أي وصف؛ فأبدل: فأبدله؛ جيء مستثنيا: جئ به.\n\n  - **معنى البيت:** حكم التام المنفي.\n\n- **البيت:** كَلَمْ يَقُمْ أَحَدٌ الاَّ صَالِحُ / أَوْ صَالِحًا فَهْوَ لِذَيْنِ صَالِحُ\n\n  - **تفكيك العبارات:** لذين: لهذين الوجهين؛ صالح: صالح أي جائز.\n\n  - **معنى البيت:** مثال الوجهين.\n\n- **البيت:** أَوْ كَانَ نَاقِصًا فَأَعْرِبْهُ عَلَى / حَسَبِ مَا يَجِيءُ فِيهِ العَمَلاَ\n\n  - **تفكيك العبارات:** كان ناقصا: الكلام الناقص؛ على حسب العملا: بحسب العوامل.\n\n  - **معنى البيت:** حكم المفرغ.\n\n- **البيت:** كَمَا هَدَى إِلاَّ مُحَمَّدٌ وَمَا / عَبَدتُّ إِلاَّ اللهَ فَاطِرَ السَّمَا\n\n  - **تفكيك العبارات:** كما هدى: مثال الرفع؛ فاطر السما: خالق السماوات.\n\n  - **معنى البيت:** مثالا المفرغ.\n\n- **البيت:** وَهَلْ يَلُوذُ العَبْدُ يَوْمَ الحَشْرِ / إِلاَّ بِأَحْمَدَ شَفِيْعِ البَشَرِ\n\n  - **تفكيك العبارات:** يلوذ: يحتمي؛ شفيع البشر: النبي.\n\n  - **معنى البيت:** المفرغ المجرور.\n\n- **البيت:** وَحُكْمُ مَا اسْتَثْنَتْهُ غَيرُ وَسِوَى / سُوَى سَوَاءٌ أَنْ يُجَرَّ لاَ سِوَى\n\n  - **تفكيك العبارات:** أن يجر لا سوى: يجر لا غير.\n\n  - **معنى البيت:** حكم المستثنى بغير وسوى.\n\n- **البيت:** وَانْصِبْ أَوِ اجْرُرْ مَا بِحَاشَا وَعَدَا / خَلاَ قَدِ اسْتَثْنَيْتَهُ مُعْتَقِدَا\n\n  - **تفكيك العبارات:** معتمدا: معتمدا على القاعدة؛ الوجهان.\n\n  - **معنى البيت:** الوجهان في الثلاثة.\n\n- **البيت:** فِي حَالَةِ النَّصْبِ بِهَا الفِعْلِيَّهْ / وَحَالَةِ الجَرِّ بِهَا الحَرْفِيَّهْ\n\n  - **تفكيك العبارات:** بها الفعلية: باعتبارها أفعالا؛ بها الحرفية: باعتبارها حروفا.\n\n  - **معنى البيت:** توجيه الوجهين.\n\n- **البيت:** تَقُولُ قَامَ القَوْمُ حَاشَا جَعْفَرَا / أَوْ جَعْفَرٍ فَقِسْ لِكَيْمَا تَظْفَرَا\n\n  - **تفكيك العبارات:** فقس: فقسه؛ لكيما تظفرا: لتفوز.\n\n  - **معنى البيت:** مثال الوجهين.\n\n## 3. أقسام التمييز\n\nتمييز النسبة محول عن فاعل أو مفعول أو مبتدأ وغير محول، وتمييز الذات للأعداد والمقادير. وشرطه الإلزامي التنكير.\n\n\n- **مثال تمييز الذات:** (اشتريتُ عشرين كتاباً)، (عندي رطلٌ عسلاً).\n- **مثال تمييز النسبة:** (طاب زيدٌ نفساً)، (اشتعل الرأسُ شيباً).\n\n## 4. الاستثناء وأدواته\n\nالاستثناء إخراج ما كان داخلا أو منزل منزلة الداخل. وأدواته ثمان في النظم، وفضل تعبير الأدوات على الحروف لأن منها الأسماء والمتردد.\n\n## 5. أحكام إلا الثلاثة\n\nالتام الموجب يجب نصبه، والتام المنفي يجوز إبداله ونصبه والإبدال أرجح، والناقص يعرب بحسب العوامل. والشواهد القرآنية والقراءات تؤيد ذلك.\n\n\n- **مثال التام الموجب:** (قام القومُ إلا زيداً) — وجوب النصب.\n- **مثال التام المنفي:** (ما قام القومُ إلا زيدٌ) بالبدلية، أو (إلا زيداً) بالنصب.\n- **مثال الناقص:** (ما قام إلا زيدٌ) فاعل، (ما رأيتُ إلا زيداً) مفعول.\n\n## 6. باقي الأدوات\n\nغير وسوى يجر ما بعدهما وتأخذان حكم ما بعد إلا، وسوى وسواء لغتان في الإعراب. وخلا وعدا وحاشا فعلية تنصب وحرفية تجر، وتتعين الفعلية مع ما المصدرية.\n\n\n- **مثال غير وسوى:** (قام القومُ غيرَ زيدٍ)، (ما قام أحدٌ سوى زيدٍ) وما بعدهما مجرور بالإضافة.\n- **مثال خلا وعدا وحاشا:** (قام القومُ خلا زيداً) بالنصب فعلية، أو (خلا زيدٍ) بالجر حرفية.\n\n## خلاصة الدرس\n\nالتمييز نكرة فضلة محول أو ذاتي، والاستثناء بأدوات ثمان وللمستثنى أحوال ثلاثة وما بعد غير مجرور وخلا وأخواتها فعلية أو حرفية.","evidences":[{"type":"quran","text":"﴿وَفَجَّرْنَا الْأَرْضَ عُيُونًا﴾","reference":"سورة القمر: 12 (المحول عن المفعول)"},{"type":"quran","text":"﴿أَنَا أَكْثَرُ مِنكَ مَالًا﴾","reference":"سورة الكهف: 34 (المحول عن المبتدأ)"},{"type":"quran","text":"﴿فَشَرِبُوا مِنْهُ إِلَّا قَلِيلًا مِّنْهُمْ﴾","reference":"سورة البقرة: 249 (التام الموجب)"},{"type":"quran","text":"﴿مَّا فَعَلُوهُ إِلَّا قَلِيلٌ مِّنْهُمْ﴾","reference":"سورة النساء: 66 (التام المنفي)"},{"type":"quran","text":"﴿وَلَا يَلْتَفِتْ مِنكُمْ أَحَدٌ إِلَّا امْرَأَتُكَ﴾","reference":"سورة هود: 81 (النهي)"},{"type":"quran","text":"﴿وَمَن يَقْنَطُ مِن رَّحْمَةِ رَبِّهِ إِلَّا الضَّالُّونَ﴾","reference":"سورة الحجر: 56 (الاستفهام)"}],"scholars":[],"benefits":["التمييز ألقاب ستة لمعنى واحد.","المحول عن فاعل أو مفعول أو مبتدأ.","التنكير شرط إلزامي.","أدوات الاستثناء ثمان.","التام الموجب يجب نصبه.","التام المنفي يجوز إبداله ونصبه.","المفرغ بحسب العوامل.","خلا وأخواتها فعلية أو حرفية."],"terms":[{"term":"تمييز النسبة","definition":"ما رفع إبهام النسبة المحول وغير المحول."},{"term":"تمييز الذات","definition":"ما رفع إبهام الأعداد والمقادير."},{"term":"الاستثناء المتصل","definition":"إخراج الداخل حقيقة."},{"term":"الاستثناء المنقطع","definition":"إخراج المنزل منزلة الداخل."},{"term":"الإبدال","definition":"إتباع المستثنى للمستثنى منه في الإعراب."}],"mindMap":{"title":"التمييز والاستثناء","branches":[{"title":"التمييز","items":["التعريف","النسبة","الذات"]},{"title":"إلا","items":["التام الموجب","التام المنفي","المفرغ"]},{"title":"باقي الأدوات","items":["غير وسوى","خلا وعدا وحاشا"]}]},"summaryTable":{"headers":["الحال","الحكم","مثال"],"rows":[["التام الموجب","وجوب النصب","قام القوم إلا عمرا"],["التام المنفي","الإبدال أو النصب","لم يقم أحد إلا صالح"],["المفرغ","بحسب العوامل","ما عبدت إلا الله"]]},"video":{"url":"https://www.youtube.com/watch?v=BN3EshDuuJI","title":"شرح نظم الآجرومية // 11 // الشيخ محمد محمود الشنقيطي"}},"questions":[{"q":"ما شرط التمييز الإلزامي؟","options":["التعريف","البناء","الجمع","التنكير"],"answer":3},{"q":"ما المحول عن المبتدأ؟","options":["أنا أكثر منك مالا","طاب زيد نفسا","لي عليه أربعون","خالد أكرم"],"answer":0},{"q":"كم أدوات الاستثناء في النظم؟","options":["ثمان","سبع","تسع","عشر"],"answer":1},{"q":"ما حكم التام الموجب؟","options":["وجوب الرفع","الجواز","وجوب النصب","الإهمال"],"answer":2},{"q":"ما الأرجح في التام المنفي؟","options":["الإبدال","النصب","الجر","الجزم"],"answer":0},{"q":"متى يتعين النصب مع خلا وعدا؟","options":["دائما","مع ما المصدرية","أبدا","مع النفي"],"answer":1}]},{"id":"ajr-12","order":13,"title":"الدرس 12: لا النافية والنداء والمفعول له","chapter":"لا والنداء","summary":"عمل لا النافية للجنس وشروطها وأحوالها، وأنواع المنادى الخمسة وأحكامها، وتعريف المفعول لأجله وشروطه وأحواله.","content":{"objectives":["أن يبين الطالب عمل لا وحقيقة بنائها.","أن يشرح شروط عملها وأحوال الانفصال والتكرار.","أن يعدد أنواع المنادى الخمسة وأحكامها.","أن يعرف المفعول لأجله وشروطه وأحواله."],"matn":"انْصِبْ بِـ لاَ مُنَكَّراً مُتَّصِلاَ ۞ مِنْ غَيْرِ تَنْوِينٍ إِذَا أَفْرَدْتَ لاَ\nتَقُولُ لاَ إِيمَانَ لِلْمُرْتَابِ ۞ وَمِثْلُهُ لاَ رَيْبَ فِي الكِتَابِ\nوَيَجِبُ التَّكْرَارُ وَالإِهْمَالُ ۞ لَهَا إِذَا مَا وَقَعَ الانْفِصَالُ\nتَقُولُ فِي المِثَالِ لاَ فِي بَكْرِ ۞ شُحٌّ وَلاَ بُخْلٌ إِذَا مَا اسْتَقْرَى\nوَجَازَ إِنْ تَكَرَّرَتْ مُتَّصِلَهْ ۞ إِعْمَالُهَا وَأَنْ تَكُونَ مُهْمَلَهْ\nتَقُولُ لاَ ضِدَّ لِرَبِّنَا وَلاَ نِدَّ ۞ وَمَنْ يَأْتِ بِرَفْعٍ فَقَبِلْهْ\nإِنَّ المُنَادَى فِي الكَلاَمِ ياتِي ۞ خَمْسَةَ أَنْوَاعٍ لَدَى النُّحَاةِ\nالمُفْرَدُ العَلَمُ ثُمَّ النَّكِرَهْ ۞ أَعْنِي بِهَا المَقْصُودَةَ المُشْتَهِرَهْ\nثُمَّ الَّتِي لَمْ تُقْصَدَنْ فَالْمُضَافُ ۞ وَالمُشَبَّهُ بِهِ فِيهِ إِجْحَافُ\nفَالأَوَّلاَنِ ابْنِهِمَا بِالضَّمِّ ۞ أَوْ مَا يَنُوبُ عَنْهُ هَذَا الفَهْمِ\nتَقُولُ يَا شَيْخُ وَيَا زُهَيْرُ ۞ وَالبَاقِي انْصِبَنَّهُ لاَ غَيْرُ\nوَهْوَ الَّذِي جَاءَ بَيَاناً لِسَبَبْ ۞ كَيْنُونَةِ العَامِلِ فِيهِ وَانْتَصَبْ\nقُمْتُ إِجْلاَلاً لِهَذَا الحَبْرِ ۞ وَزُرْتُ أَحْمَدَ ابْتِغَاءَ البِرِّ","briefExplanation":"لا النافية للجنس تعمل عمل إن فتنصب الاسم وترفع الخبر، واسمها المفرد المتصل مبني. والمنادى خمسة أنواع: مبنيان ومنصوبة ثلاثة. والمفعول لأجله مصدر قلبي يبين سبب الفعل.","detailedExplanation":"## 1. عمل لا وحقيقتها\n\nتعقد لا النافية للجنس للتنصيص على نفي الجنس استغراقا، وتعمل عمل إن فتنصب الاسم وترفع الخبر. واسمها المفرد يبنى معها تركيبة واحدة متضمنا معنى من الاستغراقية.\n\n## 2. ألفاظ أبيات الدرس بيتاً بيتاً\n> منهج هذا الدرس: نبدأ بألفاظ الأبيات بيتاً بيتاً، ثم نبسط معناها العام وقواعدها.\n\n\nفي هذا القسم نفكك كلمات كل بيت وعباراته أولا، ثم نذكر معناه إجمالا.\n\n- **البيت:** انْصِبْ بِـ لاَ مُنَكَّراً مُتَّصِلاَ / مِنْ غَيْرِ تَنْوِينٍ إِذَا أَفْرَدْتَ لاَ\n\n  - **تفكيك العبارات:** منكرا: نكرة؛ متصلا: مباشرا بلا؛ إذا أفردت لا: إذا كان اسمها مفردا.\n\n  - **معنى البيت:** عمل لا وشروطه.\n\n- **البيت:** تَقُولُ لاَ إِيمَانَ لِلْمُرْتَابِ / وَمِثْلُهُ لاَ رَيْبَ فِي الكِتَابِ\n\n  - **تفكيك العبارات:** للمرتاب: للشاك؛ لا ريب: لا شك.\n\n  - **معنى البيت:** مثالا الإعمال.\n\n- **البيت:** وَيَجِبُ التَّكْرَارُ وَالإِهْمَالُ / لَهَا إِذَا مَا وَقَعَ الانْفِصَالُ\n\n  - **تفكيك العبارات:** التكرار: تكرارها؛ الإهمال: إبطال عملها؛ الانفصال: الفصل بينها وبين اسمها.\n\n  - **معنى البيت:** حكم الانفصال.\n\n- **البيت:** تَقُولُ فِي المِثَالِ لاَ فِي بَكْرِ / شُحٌّ وَلاَ بُخْلٌ إِذَا مَا اسْتَقْرَى\n\n  - **تفكيك العبارات:** إذا ما استقرى: إذا ما تتبع واستقرأ.\n\n  - **معنى البيت:** مثال الانفصال.\n\n- **البيت:** وَجَازَ إِنْ تَكَرَّرَتْ مُتَّصِلَهْ / إِعْمَالُهَا وَأَنْ تَكُونَ مُهْمَلَهْ\n\n  - **تفكيك العبارات:** متصله: مع الاتصال؛ مهمله: مهملة.\n\n  - **معنى البيت:** حكم التكرار مع الاتصال.\n\n- **البيت:** تَقُولُ لاَ ضِدَّ لِرَبِّنَا وَلاَ نِدَّ / وَمَنْ يَأْتِ بِرَفْعٍ فَقَبِلْهْ\n\n  - **تفكيك العبارات:** ضد وند: المثل والنظير؛ من يأت برفع: من يرفعهما؛ فقبله: فاقبله.\n\n  - **معنى البيت:** مثال الوجهين.\n\n- **البيت:** إِنَّ المُنَادَى فِي الكَلاَمِ ياتِي / خَمْسَةَ أَنْوَاعٍ لَدَى النُّحَاةِ\n\n  - **تفكيك العبارات:** ياتي بتخفيف الهمزة للقافية؛ لدى النحاة: عندهم.\n\n  - **معنى البيت:** حصر أنواع المنادى.\n\n- **البيت:** المُفْرَدُ العَلَمُ ثُمَّ النَّكِرَهْ / أَعْنِي بِهَا المَقْصُودَةَ المُشْتَهِرَهْ\n\n  - **تفكيك العبارات:** أعني بها: أعني بالنكرة؛ المقصودة المشتهرة: المعينة.\n\n  - **معنى البيت:** النوعان الأولان.\n\n- **البيت:** ثُمَّ الَّتِي لَمْ تُقْصَدَنْ فَالْمُضَافُ / وَالمُشَبَّهُ بِهِ فِيهِ إِجْحَافُ\n\n  - **تفكيك العبارات:** التي لم تقصدن: غير المقصودة؛ فيه إجحاف: في حصرها إجحاف أي إيجاز شديد.\n\n  - **معنى البيت:** الأنواع الثلاثة الباقية.\n\n- **البيت:** فَالأَوَّلاَنِ ابْنِهِمَا بِالضَّمِّ / أَوْ مَا يَنُوبُ عَنْهُ هَذَا الفَهْمِ\n\n  - **تفكيك العبارات:** ابنها: ابنهما أي اجعلهما مبنيين؛ أو ما ينوب عنه: أو ما ينوب عن الضم؛ هذا الفهم: هذا هو الفهم.\n\n  - **معنى البيت:** حكم الأولين.\n\n- **البيت:** تَقُولُ يَا شَيْخُ وَيَا زُهَيْرُ / وَالبَاقِي انْصِبَنَّهُ لاَ غَيْرُ\n\n  - **تفكيك العبارات:** مثالا البناء؛ لا غير: لا غير ذلك.\n\n  - **معنى البيت:** مثال البناء وحكم الباقي.\n\n- **البيت:** وَهْوَ الَّذِي جَاءَ بَيَاناً لِسَبَبْ / كَيْنُونَةِ العَامِلِ فِيهِ وَانْتَصَبْ\n\n  - **تفكيك العبارات:** بيانا لسبب: مبيِّنا للسبب؛ كينونة العامل فيه: وجود العامل فيه أي وقوع الفعل؛ وانتصب: وحكمه النصب.\n\n  - **معنى البيت:** تعريف المفعول له وحكمه.\n\n- **البيت:** قُمْتُ إِجْلاَلاً لِهَذَا الحَبْرِ / وَزُرْتُ أَحْمَدَ ابْتِغَاءَ البِرِّ\n\n  - **تفكيك العبارات:** إجلالا: تعظيما؛ الحبر: العالم؛ ابتغاء البر: طلب الخير.\n\n  - **معنى البيت:** مثالا المجرد والمضاف.\n\n## 3. شروط عملها\n\nيشترط أن يكون اسمها نكرة فلا تعمل في المعارف، وأن تكون النكرة مفردة مباشرة متصلة بها فيبنى على ما ينصب به من غير تنوين: على الفتح للمفرد، وعلى الياء للمثنى والجمع، ويجوز الفتح والكسر لجمع المؤنث السالم. ويكثر حذف خبرها للعلم به.\n\n\n- **مثال لا مع المفرد:** (لا رجلَ في الدارِ).\n- **مثال لا مع المضاف:** (لا طالبَ علمٍ مهملٌ).\n- **مثال لا مع الشبيه بالمضاف:** (لا طالعاً جبلاً حاضرٌ).\n\n## 4. الانفصال والتكرار\n\nإذا فصل بينها وبين اسمها وجب إهمالها وإعراب ما بعدها مبتدأ ووجب تكرارها. وإذا تكررت مع الاتصال جاز إعمالها وإهمالها.\n\n## 5. المنادى وأنواعه\n\nأهمل الناظم أدوات النداء اختصارا. والمنادى خمسة: المفرد العلم والنكرة المقصودة والنكرة غير المقصودة والمضاف والشبيه بالمضاف. والأولان يبنيان على الضم أو ما ينوب عنه، والباقي ينصب وجوبا.\n\n\n- **مثال العلم المفرد:** (يا زيدُ).\n- **مثال النكرة المقصودة:** (يا رجلُ أقبلْ).\n- **مثال النكرة غير المقصودة:** (يا رجلاً خذ بيدي).\n- **مثال المضاف:** (يا عبدَ اللهِ).\n- **مثال الشبيه بالمضاف:** (يا طالعاً جبلاً).\n\n## 6. المفعول لأجله\n\nهو المصدر القلبي المبين لسبب وقوع الفعل المتحد مع عامله في الزمان والفاعل. ويأتي مجردا فينصب غالبا، ومضافا فيستوي النصب والجر، ومحلى بأل فيجر غالبا وينصب قليلا.\n\n\n- **مثال المفعول له:** (جئتُ إجلالاً لكَ)، (ضربتُ ابني تأديباً)، (قمتُ احتراماً للمعلمِ).\n\n## خلاصة الدرس\n\nلا تعمل في النكرة المتصلة وتهمل عند الانفصال، والمنادى مبنيان ومنصوبة ثلاثة، والمفعول له مصدر قلبي بأحوال ثلاثة.","evidences":[{"type":"quran","text":"﴿قَالُوا لَا ضَيْرَ﴾","reference":"سورة الشعراء: 50 (حذف الخبر)"},{"type":"quran","text":"﴿لَا فِيهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنزَفُونَ﴾","reference":"سورة الصافات: 47 (الانفصال)"},{"type":"quran","text":"﴿يَا نُوحُ اهْبِطْ﴾","reference":"سورة هود: 48 (العلم)"},{"type":"quran","text":"﴿يَا إِبْرَاهِيمُ أَعْرِضْ عَنْ هَذَا﴾","reference":"سورة هود: 76 (العلم)"},{"type":"quran","text":"﴿وَقِيلَ يَا أَرْضُ ابْلَعِي مَاءَكِ وَيَا سَمَاءُ أَقْلِعِي﴾","reference":"سورة هود: 44 (النكرة المقصودة)"},{"type":"quran","text":"﴿تَكَادُ تَمَيَّزُ مِنَ الْغَيْظِ﴾","reference":"سورة الملك: 8 (المحلى بأل مجرور)"}],"scholars":[],"benefits":["لا تعمل عمل إن في النكرة المتصلة.","اسمها المفرد مبني على ما ينصب به.","الانفصال يوجب الإهمال والتكرار.","المنادى خمسة: مبنيان ومنصوبة ثلاثة.","زيادة أو ما ينوب من موفقات الناظم.","المفعول له مصدر قلبي متحد الزمان والفاعل."],"terms":[{"term":"النافية للجنس","definition":"لا التي تنفي الجنس استغراقا."},{"term":"النكرة المقصودة","definition":"نكرة قصد تعيينها بالنداء."},{"term":"الشبيه بالمضاف","definition":"ما اتصل به شيء من تمام معناه."},{"term":"المفعول لأجله","definition":"المصدر القلبي المبين لسبب الفعل."}],"mindMap":{"title":"لا والنداء والمفعول له","branches":[{"title":"لا","items":["العمل","الشروط","الانفصال والتكرار"]},{"title":"النداء","items":["الأنواع الخمسة","المبنيات","المنصوبات"]},{"title":"المفعول له","items":["التعريف","الشروط","الأحوال"]}]},"summaryTable":{"headers":["الباب","الحكم","مثال"],"rows":[["لا","نصب الاسم ورفع الخبر","لا ريب في الكتاب"],["المنادى","البناء والنصب","يا شيخ ويا عبد الله"],["المفعول له","النصب غالبا","قمت إجلالا"]]},"video":{"url":"https://www.youtube.com/watch?v=sc4KyceK_Xg","title":"شرح نظم الآجرومية // 12 // الشيخ محمد محمود الشنقيطي"}},"questions":[{"q":"ما عمل لا النافية للجنس؟","options":["عمل كان","لا تعمل","الجزم","عمل إن"],"answer":3},{"q":"في ماذا تعمل لا؟","options":["في النكرة المتصلة","في المعارف","في الأفعال","في الجمل"],"answer":0},{"q":"ما حكم الانفصال بين لا واسمها؟","options":["الإعمال","الإهمال والتكرار","البناء","لا حكم"],"answer":1},{"q":"كم أنواع المنادى؟","options":["خمسة","ستة","أربعة","سبعة"],"answer":2},{"q":"ما المبني من المنادى؟","options":["العلم والمقصودة","المضاف","غير المقصودة","الشبيه بالمضاف"],"answer":0},{"q":"ما شرط المفعول لأجله؟","options":["أي اسم","مصدر قلبي متحد الزمان والفاعل","فعل ماض","حرف جر"],"answer":1}]},{"id":"ajr-13","order":14,"title":"الدرس 13 (الأخير): المفعول معه والمخفوضات والخاتمة","chapter":"المعية والخفض","summary":"تعريف المفعول معه وحالاته، وأقسام الخفض الثلاثة وتقادير الإضافة، ثم خاتمة الناظم.","content":{"objectives":["أن يعرف الطالب المفعول معه.","أن يميز حالات الاسم بعد الواو.","أن يعدد أقسام الخفض الثلاثة.","أن يشرح تقادير الإضافة والخاتمة."],"matn":"وَهْوَ اسْمٌ انْتَصَبَ بَعْدَ وَاوِ مَعْ ۞ فِي قَوْلِ كُلِّ رَاوِي نَحْوُ أَتَى\nالأَمِيرُ وَالجَيْشَ قُبَالَى ۞ سَارَ زَيْدٌ وَالطَّرِيقَ هَارِبَا\nالخَفْضُ بِالحَرْفِ وَبِالإِضَافَةِ ۞ كَـ مِثْلِ أَكْرِمْ بِأَبِي قُحَافَةِ\nوَبِالتَّبَعِيَّةِ الَّتِي خَلَتْ ۞ وَقُرِّرَتْ أَبْوَابُهَا وَفُصِّلَتْ\nوَمَا يَلِي المُضَافَ بِاللاَّمِ فِي ۞ تَقْدِيرِهِ أَوْ مِنْ وَقِيلَ أَوْ فِي\nكَـ اسْتَفَادَ خَاتَمَيْنِ نَضَارِ ۞ وَنَحْوِ مَكْرِ اللَّيْلِ وَالنَّهَارِ\nقَدْ تَمَّ فِي عَامِ عِشْرِينَ وَأَلْفِ ۞ وَمِائَةٍ بِحَمْدِ رَبِّنَا وَصَرْفِ\nوَحُسْنِ عَوْنِهِ وَرِفْقِهِ وَمَنِّهِ ۞ وَصَوْنِهِ مَنْظُومَةً رَائِقَةً\nجَعَلَهَا اللَّهُ لِكُلِّ مُبْتَدِي ۞ دَائِمَةَ النَّفْعِ بِجَاهِ أَحْمَدِي\nصَلَّى عَلَيْهِ رَبُّنَا وَسَلَّمَا ۞ وَآلِهِ وَصَحْبِهِ وَكَرَّمَا","briefExplanation":"المفعول معه اسم منصوب بعد واو المعية، ويترجح العطف إن أمكنت المشاركة ويتعين النصب إن امتنع. والخفض بالحرف والإضافة والتبعية، والإضافة مقدرة بمن وفي واللام. وختم الناظم عام 1120 بالحمد والدعاء.","detailedExplanation":"## 1. المفعول معه\n\nالمفعول معه اسم فضلة منصوب بعد واو نص في المعية واقع بعد فعل أو ما فيه معناه. وهو آخر المنصوبات.\n\n\n- **مثال المفعول معه:** (سرتُ والطريقَ)، (استوى الماءُ والخشبةَ).\n\n## 2. ألفاظ أبيات الدرس بيتاً بيتاً\n> منهج هذا الدرس: نبدأ بألفاظ الأبيات بيتاً بيتاً، ثم نبسط معناها العام وقواعدها.\n\n\nفي هذا القسم نفكك كلمات كل بيت وعباراته أولا، ثم نذكر معناه إجمالا.\n\n- **البيت:** وَهْوَ اسْمٌ انْتَصَبَ بَعْدَ وَاوِ مَعْ / فِي قَوْلِ كُلِّ رَاوِي نَحْوُ أَتَى\n\n  - **تفكيك العبارات:** واو مع: واو المعية؛ في قول كل راوي: عند كل راو؛ نحو أتى: كمثال أتى.\n\n  - **معنى البيت:** تعريف المفعول معه.\n\n- **البيت:** الأَمِيرُ وَالجَيْشَ قُبَالَى / سَارَ زَيْدٌ وَالطَّرِيقَ هَارِبَا\n\n  - **تفكيك العبارات:** قبالى: تجاه؛ هاربا: حال.\n\n  - **معنى البيت:** مثالا الترجيح والتعيين.\n\n- **البيت:** الخَفْضُ بِالحَرْفِ وَبِالإِضَافَةِ / كَـ مِثْلِ أَكْرِمْ بِأَبِي قُحَافَةِ\n\n  - **تفكيك العبارات:** كمثل: كمثال؛ أبي قحافة: كنية؛ قحافة ممنوع من الصرف.\n\n  - **معنى البيت:** قسما الخفض الأولان.\n\n- **البيت:** وَبِالتَّبَعِيَّةِ الَّتِي خَلَتْ / وَقُرِّرَتْ أَبْوَابُهَا وَفُصِّلَتْ\n\n  - **تفكيك العبارات:** التي خلت: التي تقدمت؛ قررت: تقررت؛ فصلت: فصلت.\n\n  - **معنى البيت:** القسم الثالث.\n\n- **البيت:** وَمَا يَلِي المُضَافَ بِاللاَّمِ فِي / تَقْدِيرِهِ أَوْ مِنْ وَقِيلَ أَوْ فِي\n\n  - **تفكيك العبارات:** ما يلي المضاف: المضاف إليه؛ في تقديره: في تقدير الإضافة؛ وقيل: وقال بعضهم.\n\n  - **معنى البيت:** تقادير الإضافة.\n\n- **البيت:** كَـ اسْتَفَادَ خَاتَمَيْنِ نَضَارِ / وَنَحْوِ مَكْرِ اللَّيْلِ وَالنَّهَارِ\n\n  - **تفكيك العبارات:** خاتمين نضار: خاتمين من ذهب؛ مكر الليل: المكر فيهما.\n\n  - **معنى البيت:** مثالا من وفي.\n\n- **البيت:** قَدْ تَمَّ فِي عَامِ عِشْرِينَ وَأَلْفِ / وَمِائَةٍ بِحَمْدِ رَبِّنَا وَصَرْفِ\n\n  - **تفكيك العبارات:** قد تم: تم؛ عام عشرين وألف ومائة: 1120؛ بصرف: بصرفه الشر.\n\n  - **معنى البيت:** تاريخ الفراغ.\n\n- **البيت:** وَحُسْنِ عَوْنِهِ وَرِفْقِهِ وَمَنِّهِ / وَصَوْنِهِ مَنْظُومَةً رَائِقَةً\n\n  - **تفكيك العبارات:** رفقه: لطفه؛ منه: إنعامه؛ صونه: حفظه؛ رائقة: حسنة الألفاظ.\n\n  - **معنى البيت:** الثناء والدعاء.\n\n- **البيت:** جَعَلَهَا اللَّهُ لِكُلِّ مُبْتَدِي / دَائِمَةَ النَّفْعِ بِجَاهِ أَحْمَدِي\n\n  - **تفكيك العبارات:** لكل مبتدي: لكل مبتدئ؛ دائمة النفع: نافعة دائما؛ بجاه أحمدي: بجاه أحمد.\n\n  - **معنى البيت:** الدعاء بالنفع.\n\n- **البيت:** صَلَّى عَلَيْهِ رَبُّنَا وَسَلَّمَا / وَآلِهِ وَصَحْبِهِ وَكَرَّمَا\n\n  - **تفكيك العبارات:** وكرما: وزاده تشريفا؛ وفيه العطف على ضمير الخفض.\n\n  - **معنى البيت:** ختام الصلاة والمسألة.\n\n## 3. حالات الاسم بعد الواو\n\nيترجح العطف ويجوز النصب إن أمكنت المشاركة، ويتعين النصب إن امتنع العطف لفساد المعنى.\n\n\n- **مثال الواو للعطف:** (جاء زيدٌ وعمروٌ) — ما بعدها تابع لما قبلها رفعاً.\n- **مثال الواو للحال:** (جاء زيدٌ والشمسُ طالعةٌ) — جملة حالية.\n\n## 4. أقسام الخفض\n\nالخفض بالحرف وبالإضافة وبالتبعية، وجمعت البسملة الأسباب الثلاثة. والإضافة مقدرة بمن البيانية وفي الظرفية واللام وهي الأغلب.\n\n\n- **مثال المخفوض بالحرف:** (مررتُ بزيدٍ).\n- **مثال المخفوض بالإضافة:** (هذا غلامُ زيدٍ).\n- **مثال المخفوض بالتبعية:** (مررتُ بزيدٍ الكريمِ) — النعت تابع مجرور.\n\n## 5. الخاتمة\n\nتم النظم عام 1120 بالحمد والدعاء بدوام النفع، وفي الخاتمة مسألة العطف على ضمير الخفض وهي خلافية.\n\n## خلاصة الدرس\n\nالمعية عند تعذر المشاركة، والخفض بثلاثة أسباب، والإضافة بتقادير ثلاثة، والختام عام 1120 بالدعاء.\n\n---\n\n[مطابقة الأبيات للشرح من المجلس المرئي]\n١- بيتا المفعول معه (وهو اسم انتصب بعد واو مع... سار زيد والطريق هاربا): واو المعية بمعنى (مع) تنصب الاسم بعدها بشرط أن يسبقها فعل أو شبهه، وأن تكون بمعنى المصاحبة لا العطف؛ فالطريق مفعول معه لا معطوف.\n٢- أبيات المخفوضات (الخفض بالحرف وبالإضافة... وبالتابعية التي خلت): المخفوضات ثلاثة لا رابع لها: بالحرف (أكرم بأبي قحافة)، وبالإضافة، وبالتابعية لتابع مجرور — وهي خلاصة ما فُصّل في الدروس السابقة.\n٣- بيتا معاني الإضافة (وما يلي المضاف باللام في تقديره أو من وقيل أو في): الإضافة بتقدير اللام للملك (غلام زيد)، أو من للجنس (خاتمين نضار أي من نضار)، أو في للظرفية (مكر الليل أي في الليل).\n٤- أبيات الخاتمة (قد تم في عام عشرين وألف ومائة... صلى عليه ربنا وسلما): فرغ الناظم سنة 1120هـ، ودعا أن يجعلها الله منظومة رائقة دائمة النفع لكل مبتدئ بجاه أحمد صلى الله عليه وسلم — فاحفظ خاتمتها كما تحفظ فاتحتها، واختم بها مراجعتك.","evidences":[{"type":"quran","text":"﴿بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ﴾","reference":"سورة الفاتحة: 1 (الأسباب الثلاثة)"},{"type":"quran","text":"﴿بَلْ مَكْرُ اللَّيْلِ وَالنَّهَارِ﴾","reference":"سورة سبأ: 33 (تقدير في)"},{"type":"quran","text":"﴿وَاتَّقُوا اللَّهَ الَّذِي تَسَاءَلُونَ بِهِ وَالْأَرْحَامِ﴾","reference":"سورة النساء: 1 (العطف على الضمير)"}],"scholars":[],"benefits":["المفعول معه آخر المنصوبات.","العطف أولى عند إمكان المشاركة.","البسملة تجمع أسباب الخفض.","اللام أغلب تقادير الإضافة.","الفراغ عام 1120.","العطف على الضمير مسألة خلافية."],"terms":[{"term":"واو المعية","definition":"واو تنصب ما بعدها على المعية."},{"term":"المخفوض بالتبعية","definition":"التابع لمجرور قبله."},{"term":"تقدير الإضافة","definition":"إضمار من أو في أو اللام في الإضافة."}],"mindMap":{"title":"المعية والخفض والختام","branches":[{"title":"المعية","items":["التعريف","الترجيح","التعيين"]},{"title":"الخفض","items":["الحرف","الإضافة","التبعية"]},{"title":"الختام","items":["التاريخ","الدعاء","المسألة"]}]},"summaryTable":{"headers":["الباب","الضابط","مثال"],"rows":[["المعية","النصب بعد الواو","سار زيد والطريق"],["الخفض","ثلاثة أسباب","بسم الله الرحمن الرحيم"],["الإضافة","من وفي واللام","خاتمين نضار"]]},"video":{"url":"https://www.youtube.com/watch?v=F5X5mejY0bc","title":"شرح نظم الآجرومية // 13 (الأخير) // الشيخ محمد محمود الشنقيطي"}},"questions":[{"q":"متى يتعين النصب على المعية؟","options":["دائما","أبدا","مع المشاركة","عند امتناع العطف"],"answer":3},{"q":"كم أسباب الخفض؟","options":["اثنان","ثلاثة","أربعة","خمسة"],"answer":0},{"q":"ما الآية الجامعة للأسباب الثلاثة؟","options":["آية الكرسي","البسملة","الفاتحة كلها","الإخلاص"],"answer":1},{"q":"ما أغلب تقادير الإضافة؟","options":["من","في","اللام","الباء"],"answer":2},{"q":"في أي عام تم النظم؟","options":["1110","1120","1130","1102"],"answer":0},{"q":"ما المسألة النحوية في الخاتمة؟","options":["البناء","العطف على ضمير الخفض","التنوين","الوقف"],"answer":1}]}]}]}]};